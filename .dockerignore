# Swift build output — large and not needed in the build context
.build/
.swiftpm/

# Git history — not needed, keeps context lean
.git/
.gitignore
.github/

# Claude workspace
.claude/

# Local dev / runtime data — never goes into the image
*.sqlite
*.sqlite-shm
*.sqlite-wal
.env
.worker-secret
.local-runner-autostart
results/
submissions/
testsetups/

# JupyterLite build toolchain — built output is in Public/ (already checked in).
# Tools/runner-support is the exception: the EmbedRunnerSupport build-tool plugin
# compiles those files into the runner binary, so the compile stage needs them.
# Excluding `Tools/*` rather than `Tools/` keeps the parent directory in the
# context, which is what lets the negation below re-include a child of it.
node_modules/
Tools/*
!Tools/runner-support

# Documentation and deploy configs — not needed inside the image
*.md
CHANGELOG
VERSION
LICENSE
deploy/*.service
deploy/*.md
scripts/

# macOS noise
.DS_Store
