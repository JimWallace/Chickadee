# A function tag with parameters inside an HTML comment runs as if it were in
# the markup; the rule caught only the interpolation and structural tags
# until #2407. The tag is built, not written, so this file is not a hit.
guard="scripts/check-leaf-semantics.sh"
files="Resources/Views/enroll.leaf"
description="a function tag with parameters inside an HTML comment"
expect="Leaf tag syntax inside an HTML comment"
apply() {
    printf '<!-- the table is empty when %scount(rows) is zero -->\n' "#" >> Resources/Views/enroll.leaf
}
