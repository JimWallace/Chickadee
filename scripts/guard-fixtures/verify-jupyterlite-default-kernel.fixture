# The editor opens a new notebook on the default kernel, which must be the
# xeus-python kernel since the Pyodide kernel was retired.
guard="scripts/verify-jupyterlite.sh"
files="Public/jupyterlite/jupyter-lite.json"
description="a default kernel other than xpython in the built config"
expect="defaultKernelName must be 'xpython'"
apply() {
    sed -i 's|"defaultKernelName": "xpython"|"defaultKernelName": "xr"|' Public/jupyterlite/jupyter-lite.json
}
