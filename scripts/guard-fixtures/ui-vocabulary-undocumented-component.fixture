# A new component in the global sheet used to be free — the page-style ratchet
# only priced a page-local one. Thirteen components went in without ever
# reaching the catalog before this rule existed.
guard="scripts/check-ui-vocabulary.sh"
files="Public/styles.css"
description="a new global component the component vocabulary does not name"
expect="the rulebook does not name"
apply() {
    printf '\n.ck-guard-fixture-widget { display: block; }\n' >> Public/styles.css
}
