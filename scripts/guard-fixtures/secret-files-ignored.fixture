# A secret file the server writes to the working directory must be
# git-ignored, or `git add .` from a checkout commits a private key.
guard="scripts/check-secret-files-ignored.sh"
files=".gitignore"
description="a secret file name dropped from .gitignore"
expect="not ignored"
apply() {
    sed -i '/^\.github-app-secrets$/d' .gitignore
}
