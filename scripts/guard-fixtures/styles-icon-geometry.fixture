# Icon geometry lives only in the two sprites under Resources/Sprites/; every
# other use references a <symbol>. Sixteen copies of one trash can is what
# this prevents. In a Swift view the geometry is an Elementary SVG attribute.
guard="scripts/check-styles.sh"
files="Sources/APIServer/Views/BaseLayout.swift"
description="inline SVG geometry in a Swift view, outside the icon sprite"
expect="inline SVG geometry outside the icon sprite"
apply() {
    printf 'let ckGuardFixture = SVG.svg { SVG.path(.d("M1 1 L2 2")) }\n' >> Sources/APIServer/Views/BaseLayout.swift
}
