# The same selector in two page blocks is a shared rule that belongs in
# styles.css, where review sees it next to the component it may duplicate.
guard="scripts/check-styles.sh"
files="Sources/APIServer/Views/SiteNav.swift Sources/APIServer/Views/BaseLayout.swift"
description="the same selector in two Elementary PageStyle blocks"
expect="defined in more than one page <style> block"
apply() {
    printf 'let ckGuardFixture = PageStyle("""\n    .guard-fixture-twin { padding: 1rem; }\n    """)\n' \
        >> Sources/APIServer/Views/SiteNav.swift
    printf 'let ckGuardFixture = PageStyle("""\n    .guard-fixture-twin { padding: 1rem; }\n    """)\n' \
        >> Sources/APIServer/Views/BaseLayout.swift
}
