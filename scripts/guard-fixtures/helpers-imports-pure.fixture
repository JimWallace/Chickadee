# Helpers/ holds the HTTP edge (#2144, #2775). A Helpers file whose code names
# no request-layer type is database, domain or pure code, and must fail the
# guard. Renaming the one type the file extends removes its only edge name.
guard="scripts/check-utilities-imports.sh"
files="Sources/APIServer/Helpers/ClientResponse+Body.swift"
description="a Helpers file that names no request-layer type"
expect="names no request-layer type"
apply() {
    sed -i 's/ClientResponse/ClientReply/g' Sources/APIServer/Helpers/ClientResponse+Body.swift
}
