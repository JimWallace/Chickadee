# Every test is on Swift Testing. XCTVapor reports through XCTFail, which a
# Swift Testing test misattributes or drops, so an XCTest import brings that
# bridge back.
guard="scripts/no-new-xctest.sh"
files="Tests/APITests/Infrastructure/COEPMiddlewareTests.swift"
description="a test file that imports XCTest"
expect="import XCTest/XCTVapor"
apply() {
    sed_inplace '1i\
import XCTest' Tests/APITests/Infrastructure/COEPMiddlewareTests.swift
}
