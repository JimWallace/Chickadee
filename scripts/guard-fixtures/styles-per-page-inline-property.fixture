# An inline custom property may carry only a value that changes per datum. A
# width set inline on one page is a design decision that belongs in styles.css.
guard="scripts/check-styles.sh"
files="Sources/APIServer/Views/BaseLayout.swift"
description="a component custom property set inline in a Swift view"
expect="assigns a component custom property inline"
apply() {
    printf 'let ckGuardFixture = div(.custom(name: "style", value: "--filter-width:220px")) {}\n' \
        >> Sources/APIServer/Views/BaseLayout.swift
}
