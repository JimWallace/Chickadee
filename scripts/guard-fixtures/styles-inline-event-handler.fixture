# An onclick=/onchange= attribute is an inline script by another name, and the
# one shape a CSP nonce cannot rescue.  With 'unsafe-inline' out of script-src
# (#1516) the handler does not fail loudly — the control just stops responding.
guard="scripts/check-styles.sh"
files="Resources/Views/login.leaf"
description="an inline event-handler attribute in a template"
expect="inline event-handler attribute"
apply() {
    printf '<button type="button" onclick="alert(1)">Guard fixture</button>\n' \
        >> Resources/Views/login.leaf
}
