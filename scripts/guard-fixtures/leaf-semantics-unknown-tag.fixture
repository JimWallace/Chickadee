# Leaf resolves a tag it does not know to nothing, so a misspelled CSRF field
# renders as an empty string and the form is refused only on submit. The tag
# indicator is built, not written, so this file is not a hit for a scanner.
guard="scripts/check-leaf-semantics.sh"
files="Resources/Views/base.leaf"
description="a misspelled tag name at the start of a tag"
expect="unknown Leaf tag"
apply() {
    printf '<form method="post">%scsrfFormFeild()</form>\n' "#" >> Resources/Views/base.leaf
}
