# A post step with its own copy of the credential check, which is how the
# eight copies drifted before #2711.
guard="scripts/check-agent-workflows.sh"
files=".github/workflows/visual-diff-explainer.yml"
description="a copy of the credential pattern in a workflow"
expect="own copy of the credential pattern"
apply() {
    sed -i 's|^          marker="<!-- visual-diff-explainer -->"$|          grep -qE "sk-ant-" raw.md \&\& exit 1\n&|' .github/workflows/visual-diff-explainer.yml
}
