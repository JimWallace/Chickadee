# Styling written from JS is invisible to every CSS guard, so its count may
# only shrink. One write more than the baseline always exceeds it, whatever
# the count is today.
guard="scripts/check-styles.sh"
files="Public/app.js"
description="more JS .style writes than the baseline allows"
expect="JS styling decisions grew"
apply() {
    n="$(sed -n 's/^JS_STYLE_DECISION_BASELINE=//p' scripts/check-styles.sh)"
    printf '\nfunction ckGuardFixture(el) {\n' >> Public/app.js
    for _ in $(seq 0 "$n"); do
        printf '    el.style.width = "1px";\n' >> Public/app.js
    done
    printf '}\n' >> Public/app.js
}
