# A function call inside a condition is looked up the same way: an unknown
# name resolves to nothing and the branch silently never fires.
guard="scripts/check-leaf-semantics.sh"
files="Resources/Views/login.leaf"
description="a misspelled function inside a condition"
expect="cuont"
apply() {
    printf '#if(cuont(rows) > 0):<p>x</p>#endif\n' >> Resources/Views/login.leaf
}
