# Only the first custom property of an attribute that started with `--` was
# checked, so a component property in second place, or after display:none,
# passed (#2404).
guard="scripts/check-styles.sh"
files="Sources/APIServer/Views/BaseLayout.swift"
description="a component custom property set inline after display:none in a Swift view"
expect="assigns a component custom property inline"
apply() {
    printf 'let ckGuardFixture = div(.custom(name: "style", value: "display:none; --filter-width:220px")) {}\n' \
        >> Sources/APIServer/Views/BaseLayout.swift
}
