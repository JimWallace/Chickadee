# A page block re-defining a selector whose global rule is a one-line @media
# block passed, because the global selector scan lost it (#2403).
guard="scripts/check-styles.sh"
files="Sources/APIServer/Views/BaseLayout.swift"
description="a PageStyle block re-defining a selector the global sheet sets in a one-line @media rule"
expect="re-defines a selector from the global sheet"
apply() {
    printf 'let ckGuardFixture = PageStyle("""\n    .col-hide-phone { color: inherit; }\n    """)\n' \
        >> Sources/APIServer/Views/BaseLayout.swift
}
