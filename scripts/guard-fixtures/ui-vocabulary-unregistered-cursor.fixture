# cursor: help arrived once as a private convention for "hover me", alongside a
# dotted underline, in a codebase that already had four ways to reveal detail.
# The rule reuses an existing class so it trips the affordance registry and
# nothing else.
guard="scripts/check-ui-vocabulary.sh"
files="Public/styles.css"
description="a cursor value outside the affordance registry"
expect="unregistered cursor affordance"
apply() {
    printf '\n.chip { cursor: help; }\n' >> Public/styles.css
}
