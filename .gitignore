# macOS
.DS_Store

# Swift / Xcode local build artifacts
.build/
.swiftpm/xcode/package.xcworkspace/xcuserdata/

# Local tooling environments
.claude/*
!.claude/hooks/
!.claude/settings.json
.venv-jlite/
.jupyterlite.doit.db
Tools/jupyterlite/.jupyterlite.doit.db

# Local runtime state / secrets
.local-runner-autostart
.worker-secret
.mcp-signing-key
.env
chickadee*.sqlite
chickadee*.sqlite3
chickadee*.sqlite-wal
chickadee*.sqlite-shm
chickadee*.db
chickadee.backup_*.sqlite

# Local reference / import files
Marmoset/

# Runtime-generated app data
results/
submissions/
testsetups/
backups/

# Runtime-generated JupyterLite file namespaces
Public/files/
Public/jupyterlite/files/
Public/jupyterlite/lab/files/
Public/jupyterlite/notebooks/files/

# CodeMirror bundling toolchain — only the entry point + package.json
# are checked in; node_modules and lockfile regenerate via setup-vendor.sh.
Tools/vendor/node_modules/
# Root ESLint toolchain (package.json + package-lock.json are checked in).
/node_modules/
Tools/vendor/package-lock.json

# Browser grading smoke probe toolchain (Tools/browser-grading-smoke) — the probe
# script and its package.json are checked in; Playwright installs on demand in CI.
Tools/browser-grading-smoke/node_modules/
Tools/browser-grading-smoke/package-lock.json

# Visual-regression working dirs (Tools/visual-regression; committed baselines
# live in Tools/visual-regression/baselines/).
Tools/visual-regression/node_modules/
visual-bootstrap/
visual-diffs/

# Muter run config, written per-machine for a mutation-testing run. It pins an
# absolute path to the local swift binary, so it is never portable and must not
# be committed. Muter is NOT adopted -- see docs/handoff-mutation-testing.md.
muter.conf.yml

# Muter run artifacts: per-mutant test logs (one file per mutant, MBs per run)
# written into the project root by a mutation-testing run.
muter_logs/
