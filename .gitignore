# macOS
.DS_Store

# Swift / Xcode local build artifacts
.build/
.swiftpm/xcode/package.xcworkspace/xcuserdata/

# Local tooling environments
.claude/*
!.claude/hooks/
!.claude/settings.json
# Agent guidance that is meant to be shared, not local state. An agent driving
# a PR reads skills/steward/SKILL.md from the repository's head branch, so it
# only has an effect once committed.
!.claude/skills/
.venv-jlite/
.jupyterlite.doit.db
Tools/jupyterlite/.jupyterlite.doit.db

# Local runtime state / secrets
.local-runner-autostart
.worker-secret
.mcp-signing-key
.env
chickadee*.sqlite
chickadee*.sqlite3
chickadee*.sqlite-wal
chickadee*.sqlite-shm
chickadee*.db
chickadee.backup_*.sqlite

# Local reference / import files
Marmoset/

# Runtime-generated app data
results/
submissions/
testsetups/
backups/

# Runtime-generated JupyterLite file namespaces
Public/files/
Public/jupyterlite/files/
Public/jupyterlite/lab/files/
Public/jupyterlite/notebooks/files/

# Vendoring toolchain (Tools/vendor) — entry points, package.json and the
# LOCKFILE are checked in. The lockfile used to be ignored "because it
# regenerates via setup-vendor.sh", which is the problem rather than the
# reason: the CodeMirror deps are declared as `^6.0.0`, so regenerating it is
# exactly what lets two runs months apart bundle different bytes into
# Public/vendor/codemirror.js with nothing in the diff to say so — and those
# bytes are served to every student and instructor. The lockfile is the record
# of which inputs produced the committed output.
Tools/vendor/node_modules/
# Root ESLint toolchain (package.json + package-lock.json are checked in).
/node_modules/

# Browser grading smoke probe toolchain (Tools/browser-grading-smoke) — the probe
# script, its package.json and its lockfile are checked in; Playwright installs
# on demand in CI. The lockfile keeps the probe on one browser build, so a red
# probe means the code changed rather than Playwright did.
Tools/browser-grading-smoke/node_modules/

# Visual-regression working dirs (Tools/visual-regression; committed baselines
# live in Tools/visual-regression/baselines/).
Tools/visual-regression/node_modules/
visual-bootstrap/
visual-diffs/

# Muter run config, written per-machine for a mutation-testing run. It pins an
# absolute path to the local swift binary, so it is never portable and must not
# be committed. scripts/mutation-run.sh writes it per run and deletes it after;
# see docs/handoff-mutation-testing.md for why the tool is a patched fork.
muter.conf.yml

# Muter run artifacts: per-mutant test logs (one file per mutant, MBs per run)
# written into the project root by a mutation-testing run.
muter_logs/

# Per-shard output of a LOCAL mutation run (scripts/mutation-run.sh --out).
# The durable record is MutationReports/, written by the weekly workflow and
# committed on purpose; this is the raw working directory that produces it and
# carries a full copy of Muter's stdout.
mutation-report/

# Bytecode from the mutation tooling's self-test.
Tools/mutation/__pycache__/
