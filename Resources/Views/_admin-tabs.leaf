<!-- The admin section tab bar, shared by every admin-area page.  The active
     tab comes from the activeAdminTab context value each handler sets.  This
     was inlined into all eight admin pages for years behind a comment blaming
     a LeafKit false-positive cycle error; the #1266 investigation showed those
     historical Leaf diagnoses were unreliable, and the render tests prove the
     shared partial resolves.

     Eight flat tabs are now five: Overview and Health Alerts — the two an
     admin opens daily — stay top-level, and the remaining six group into
     People, Data and Integrations.  The menus are the site's existing
     nav-dropdown idiom (app.js drives every [data-nav-dropdown]: one open at a
     time, outside-click and Escape to close), so this adds no component and no
     script.  The toggle wears admin-tab so a group reads as a tab, and takes
     aria-current when the page showing is one of its members; the member
     itself takes nav-dropdown-item-active, the same way the nav's course
     picker marks the active course.  activeAdminTab values are unchanged — a
     menu item sets exactly what its flat tab used to. -->
<h1 class="visually-hidden">Admin —
#if(activeAdminTab == "overview"):Overview#endif
#if(activeAdminTab == "alerts"):Health Alerts#endif
#if(activeAdminTab == "users"):People — Users#endif
#if(activeAdminTab == "storage"):Data — Storage#endif
#if(activeAdminTab == "retention"):Data — Retention#endif
#if(activeAdminTab == "audit"):Data — Audit Log#endif
#if(activeAdminTab == "brightspace"):Integrations — LEARN#endif
#if(activeAdminTab == "mcp"):Integrations — MCP#endif
</h1>
<nav class="admin-tabs" aria-label="Admin sections">
    <a class="admin-tab" href="/admin"#if(activeAdminTab == "overview"): aria-current="page"#endif>Overview</a>
    <a class="admin-tab" href="/admin/alerts"#if(activeAdminTab == "alerts"): aria-current="page"#endif>Health Alerts</a>

    <div class="nav-dropdown" data-nav-dropdown>
        <button type="button" class="admin-tab nav-dropdown-toggle"
                aria-haspopup="true" aria-expanded="false"#if(activeAdminTab == "users"): aria-current="page"#endif>
            <span>People</span>
            <span class="nav-dropdown-caret" aria-hidden="true">▾</span>
        </button>
        <div class="nav-dropdown-menu" role="menu">
            <a class="nav-dropdown-item#if(activeAdminTab == "users"): nav-dropdown-item-active#endif"
               role="menuitem" href="/admin/users">Users</a>
        </div>
    </div>

    <div class="nav-dropdown" data-nav-dropdown>
        <button type="button" class="admin-tab nav-dropdown-toggle"
                aria-haspopup="true" aria-expanded="false"#if(activeAdminTab == "storage"): aria-current="page"#endif#if(activeAdminTab == "retention"): aria-current="page"#endif#if(activeAdminTab == "audit"): aria-current="page"#endif>
            <span>Data</span>
            <span class="nav-dropdown-caret" aria-hidden="true">▾</span>
        </button>
        <div class="nav-dropdown-menu" role="menu">
            <a class="nav-dropdown-item#if(activeAdminTab == "storage"): nav-dropdown-item-active#endif"
               role="menuitem" href="/admin/storage">Storage</a>
            <a class="nav-dropdown-item#if(activeAdminTab == "retention"): nav-dropdown-item-active#endif"
               role="menuitem" href="/admin/retention">Retention</a>
            <a class="nav-dropdown-item#if(activeAdminTab == "audit"): nav-dropdown-item-active#endif"
               role="menuitem" href="/admin/audit">Audit Log</a>
        </div>
    </div>

    <div class="nav-dropdown" data-nav-dropdown>
        <button type="button" class="admin-tab nav-dropdown-toggle"
                aria-haspopup="true" aria-expanded="false"#if(activeAdminTab == "brightspace"): aria-current="page"#endif#if(activeAdminTab == "mcp"): aria-current="page"#endif>
            <span>Integrations</span>
            <span class="nav-dropdown-caret" aria-hidden="true">▾</span>
        </button>
        <div class="nav-dropdown-menu" role="menu">
            <a class="nav-dropdown-item#if(activeAdminTab == "brightspace"): nav-dropdown-item-active#endif"
               role="menuitem" href="/admin/brightspace">LEARN</a>
            #if(mcpEnabled()):<a class="nav-dropdown-item#if(activeAdminTab == "mcp"): nav-dropdown-item-active#endif"
               role="menuitem" href="/admin/mcp">MCP</a>#endif
        </div>
    </div>
</nav>
