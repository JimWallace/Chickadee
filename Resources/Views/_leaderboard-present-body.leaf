<!-- The projected leaderboard's moving part: rendered inline by
     leaderboard-present.leaf and again as its background refresh. -->
<header class="present-header">
    <div>
        <div class="present-kicker">#(courseCode) · #(assignmentTitle)</div>
        <h1 class="present-title">#(title)</h1>
    </div>
    #if(hasWindow):
    <div class="present-clock">
        <span class="present-clock-label">#(window.label)</span>
        <span class="present-clock-time js-relative-time" data-iso="#(window.boundaryISO)">#(window.boundaryText)</span>
    </div>
    #endif
    #if(hasProgress):
    <div class="present-clock">
        <span class="present-clock-label">#(progressLabel)</span>
        <span class="present-clock-time">#(progressValue)</span>
    </div>
    #endif
</header>
#if(showsBracket):
#if(hasWinner):
<section class="champion-card card" aria-label="Winner">
    #extend("_avatar", winnerAvatar)
    <div class="you-card-who">
        <div class="you-card-kicker">Winner</div>
        <div class="you-card-name" data-avatar-handle>#(winnerHandle)</div>
    </div>
</section>
#endif
#if(hasTournament):
<div class="present-bracket">
#extend("_leaderboard-bracket", tournament)
</div>
#else:
<p class="empty">No tournament has been run yet.</p>
#endif
#else:
#if(hasChampion):
#if(!championOnPodium):
<section class="champion-card card" aria-label="Holder of the hill">
    #extend("_avatar", championAvatar)
    <div class="you-card-who">
        <div class="you-card-kicker">Holds the hill</div>
        <div class="you-card-name" data-avatar-handle>#(championHandle)</div>
    </div>
</section>
#endif
#endif
#if(hasPodium):
<div class="present-stage">
<div class="podium">
    #for(place in podium):
    <div class="podium-place" data-rank-tier="#(place.rankTier)" aria-label="Place #(place.rankText)">
        #if(place.isChampion):<div class="podium-kicker">Holds the hill</div>#endif
        #extend("_avatar", place.avatar)
        <div class="podium-handle" data-avatar-handle>#(place.handle)</div>
        <div class="podium-value">#(place.valueText)</div>
        <div class="podium-plinth"><span class="rank-disc" data-rank-tier="#(place.rankTier)">#(place.rankText)</span></div>
    </div>
    #endfor
</div>
#if(count(rest) > 0):
<div class="present-rows">
    #for(place in rest):
    <div class="present-row">
        <span class="rank-disc" data-rank-tier="#(place.rankTier)">#(place.rankText)</span>
        #extend("_avatar", place.avatar)
        <span class="present-row-handle" data-avatar-handle>#(place.handle)</span>
        <span class="present-row-value">#(place.valueText)</span>
    </div>
    #endfor
</div>
#endif
</div>
#else:
<p class="empty">Nobody is on the board yet.</p>
#endif
#endif
<footer class="present-footer">
    <strong>#if(showsBracket):#(entrantCount)#else:#(rankedCount)#endif on the board</strong>
    <span>Find yourself by your bird and handle on your own Leaderboard page</span>
    #if(pollsLive):<span class="tier tier-preview">Live</span>#endif
</footer>
