#extend("base"):
#export("title"):
MCP
#endexport
#export("content"):
<p class="admin-version-banner">Chickadee v#appVersion()</p>
#extend("_admin-tabs")
#if(showServiceAccounts):
<section class="page-section">
    <h2>MCP service accounts</h2>

    #if(!enabled):
    <div class="form-error" role="status">
        The MCP endpoint is not active, so tokens cannot be minted. Set
        <code>MCP_MODE=read_only</code> or <code>MCP_MODE=read_write</code>
        and <code>PUBLIC_BASE_URL</code> (or <code>MCP_ISSUER</code>/<code>MCP_RESOURCE</code>),
        then restart the server.
    </div>
    #endif
    #if(enabled):
    #if(!writeAllowed):
    <div class="flash flash-warning" role="status">
        MCP is in <strong>read-only</strong> mode (<code>MCP_MODE=read_only</code>): agents can read
        course content but cannot create or edit it. Minted tokens carry <code>content:read</code> only.
        Set <code>MCP_MODE=read_write</code> and restart to allow writes.
    </div>
    #endif
    #endif
    #if(error == "username_required"):
    <div class="form-error" role="alert">A username is required.</div>
    #endif
    #if(error == "username_taken"):
    <div class="form-error" role="alert">That username is already in use.</div>
    #endif
    #if(error == "mcp_disabled"):
    <div class="form-error" role="alert">Cannot mint a token while the MCP endpoint is inactive.</div>
    #endif
    #if(error == "enroll_failed"):
    <div class="form-error" role="alert">Could not update the account's course enrollment.</div>
    #endif

    #if(mintedToken):
    <div class="flash flash-success" role="status">
        <p class="mcp-token-caption"><strong>Access token for #(mintedFor)</strong>
            &middot; scopes: <code>#(mintedScopes)</code> &middot; expires after #(tokenTTLSeconds)s.
            Copy it now — it is shown only once.</p>
        <textarea readonly rows="4" class="form-input mcp-token-area"
                  onclick="this.select()">#(mintedToken)</textarea>
    </div>
    #endif

    #if(enabled):
    <p class="mcp-issuer-note">
        Issuer <code>#(issuer)</code> &middot; Resource <code>#(resource)</code>.
        Tokens are stateless: deleting an account stops new tokens being minted, but a token
        already issued stays valid until it expires.
    </p>
    #endif

    <form method="post" action="/admin/mcp/accounts" class="mcp-create-form">
        #csrfFormField()
        <input class="form-input mcp-username-input" type="text" name="username" required
               autocomplete="new-password"
               placeholder="agent name, e.g. course-bot"
               aria-label="New MCP account username">
        <button class="btn" type="submit">Create account</button>
    </form>

    <div class="table-scroll"><table class="results-table sortable-table">
        <thead>
            <tr>
                <th data-sort-type="text"><button class="sort-header" type="button">Username</button></th>
                <th class="time" data-sort-type="date"><button class="sort-header" type="button">Created</button></th>
                <th>Courses</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        #for(account in accounts):
            <tr>
                <td><code>#(account.username)</code></td>
                <td class="time">#(account.createdAt)</td>
                <td>
                    <div class="mcp-course-cell">
                        #for(c in account.enrolledCourses):
                        <span class="chip">
                            <code>#(c.code)</code>
                            <form method="post" action="/admin/mcp/accounts/#(account.id)/unenroll" class="inline-form">
                                #csrfFormField()
                                <input type="hidden" name="courseID" value="#(c.id)">
                                <button type="submit" title="Remove from #(c.code)"
                                        class="mcp-chip-remove">&times;</button>
                            </form>
                        </span>
                        #endfor
                        #if(account.enrolledCourses.isEmpty):
                        <span class="mcp-none">none — no access</span>
                        #endif
                        <form method="post" action="/admin/mcp/accounts/#(account.id)/enroll" class="mcp-enroll-form">
                            #csrfFormField()
                            <label class="visually-hidden" for="enroll-#(account.id)">Enroll #(account.username) in a course</label>
                            <select id="enroll-#(account.id)" name="courseID" class="form-input mcp-enroll-select">
                                #for(c in allCourses):
                                <option value="#(c.id)">#(c.code)</option>
                                #endfor
                            </select>
                            <button class="btn action-btn" type="submit">Enroll</button>
                        </form>
                    </div>
                </td>
                <td>
                    <div class="toolbar">
                        #if(enabled):
                        <form method="post" action="/admin/mcp/accounts/#(account.id)/token"
                              class="mcp-token-form">
                            #csrfFormField()
                            <label class="visually-hidden" for="scope-#(account.id)">Token scope for #(account.username)</label>
                            <select id="scope-#(account.id)" name="scope" class="form-input mcp-scope-select">
                                #if(writeAllowed):
                                <option value="readwrite">read + write</option>
                                #endif
                                <option value="read">read only</option>
                            </select>
                            <button class="btn action-btn" type="submit">Mint token</button>
                        </form>
                        #endif
                        <form method="post" action="/admin/mcp/accounts/#(account.id)/delete" class="inline-form">
                            #csrfFormField()
                            <button class="btn action-btn action-danger" type="submit"
                                    onclick="return confirm('Delete this MCP account? Existing tokens stay valid until they expire.')">Delete</button>
                        </form>
                    </div>
                </td>
            </tr>
        #endfor
        #if(accounts.isEmpty):
            <tr><td colspan="4" class="text-muted">No MCP accounts yet.</td></tr>
        #endif
        </tbody>
    </table></div>
</section>
#endif

<section class="page-section">
    <h2>Connected agents</h2>
    <div class="table-scroll"><table class="results-table sortable-table">
        <thead>
            <tr>
                <th data-sort-type="text"><button class="sort-header" type="button">Agent</button></th>
                <th data-sort-type="text"><button class="sort-header" type="button">Authorized by</button></th>
                <th data-sort-type="text"><button class="sort-header" type="button">Scopes</button></th>
                <th class="time" data-sort-type="date"><button class="sort-header" type="button">Authorized</button></th>
                <th class="time" data-sort-type="date"><button class="sort-header" type="button">Last used</button></th>
                <th class="time" data-sort-type="date"><button class="sort-header" type="button">Expires</button></th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
        #for(grant in grants):
            <tr>
                <td>#(grant.agentName)</td>
                <td><code>#(grant.owner)</code></td>
                <td><code>#(grant.scope)</code></td>
                <td class="time">#(grant.createdAt)</td>
                <td class="time">#if(grant.lastUsedAt):#(grant.lastUsedAt)#else:—#endif</td>
                <td class="time">#(grant.expiresAt)</td>
                <td>
                    #if(grant.revoked):
                    <span class="text-muted">Revoked</span>
                    #else:
                    <form method="post" action="/agents/#(grant.id)/revoke" class="inline-form">
                        #csrfFormField()
                        <button class="btn action-btn action-danger" type="submit"
                                onclick="return confirm('Revoke this agent? It will lose access immediately.')">Revoke</button>
                    </form>
                    #endif
                </td>
            </tr>
        #endfor
        #if(grants.isEmpty):
            <tr><td colspan="7" class="text-muted mcp-cell-center">No agents have connected yet.</td></tr>
        #endif
        </tbody>
    </table></div>
</section>
<style>
.mcp-token-caption { margin: .1rem 0 .5rem; }
.mcp-token-area {
    width: 100%;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    box-sizing: border-box;
}
.mcp-issuer-note {
    color: var(--gray-600);
    font-size: var(--text-sm);
}
.mcp-create-form {
    display: flex;
    gap: .5rem;
    align-items: center;
    margin: 1rem 0;
}
.mcp-username-input { width: 260px; max-width: 100%; }
.mcp-course-cell {
    display: flex;
    gap: .35rem;
    flex-wrap: wrap;
    align-items: center;
}
.mcp-chip-remove {
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--gray-600);
    padding: 0;
    font-size: var(--text-md);
    line-height: 1;
}
.mcp-none {
    color: var(--gray-600);
    font-size: var(--text-sm);
}
.mcp-enroll-form {
    display: inline-flex;
    gap: .2rem;
}
.mcp-enroll-select {
    padding: .2rem .4rem;
    font-size: var(--text-sm);
}
.mcp-token-form {
    display: flex;
    gap: .3rem;
    align-items: center;
}
.mcp-scope-select {
    padding: .25rem .5rem;
    font-size: var(--text-sm);
}
.mcp-cell-center {
    text-align: center;
    padding: 1rem;
}
</style>
<script src="/sortable-table.js?v=#appVersion()"></script>
#endexport
#endextend
