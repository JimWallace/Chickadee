#extend("base"):
#export("title"):
MCP
#endexport
#export("content"):
<p class="admin-version-banner">Chickadee v#appVersion()</p>
#extend("_admin-tabs")
<section class="page-section">
    <p class="page-crumb">Integrations</p>
    <div class="page-titlebar">
        <h2>MCP <span class="tier #if(!enabled):tier-danger#elseif(writeAllowed):tier-open#else:tier-preview#endif">#(modeLabel)</span></h2>
    </div>

    #if(!enabled):
    <div class="flash flash-error" role="status">
        <strong>MCP is inactive.</strong> Set <code>MCP_MODE</code> and <code>PUBLIC_BASE_URL</code>, then restart.
    </div>
    #else:
    #if(!writeAllowed):
    <div class="flash flash-warning" role="status">
        <strong>Read-only mode.</strong> Agents can read course content but not edit it; tokens carry <code>content:read</code>.
    </div>
    #endif
    #endif
    #if(error == "username_required"):
    <div class="form-error" role="alert">A username is required.</div>
    #endif
    #if(error == "username_taken"):
    <div class="form-error" role="alert">That username is already in use.</div>
    #endif
    #if(error == "mcp_disabled"):
    <div class="form-error" role="alert">Cannot mint a token while the MCP endpoint is inactive.</div>
    #endif
    #if(error == "enroll_failed"):
    <div class="form-error" role="alert">Could not update the account's course enrollment.</div>
    #endif

    #if(mintedToken):
    <div class="flash flash-success" role="status">
        <p class="mcp-token-caption"><strong>Access token for #(mintedFor)</strong>
            &middot; scopes: <code>#(mintedScopes)</code> &middot; expires after #(tokenTTLSeconds)s.
            Copy it now — it is shown only once.</p>
        <textarea readonly rows="4" class="form-input textarea-mono"
                  data-ck-select-all>#(mintedToken)</textarea>
    </div>
    #endif

    #if(enabled):
    <div class="card section-gap">
        <dl class="detail-grid">
            <dt>Issuer</dt>
            <dd><code>#(issuer)</code></dd>
            <dt>Resource</dt>
            <dd><code>#(resource)</code></dd>
            <dt>Token lifetime</dt>
            <dd>#(tokenLifetimeText) <span class="card-meta">Stateless: deleting an account doesn&rsquo;t revoke issued tokens</span></dd>
        </dl>
    </div>
    #endif
</section>

#if(showServiceAccounts):
<section class="page-section">
    <div class="page-titlebar">
        <h2>MCP service accounts</h2>
        <details class="add-section-details popup-anchor">
            <summary class="btn action-btn summary-btn">+ New account <svg class="icon" aria-hidden="true"><use href="#i-chevron-down"/></svg></summary>
            <div class="add-section-popup card suite-section-popup" role="dialog" aria-label="New account">
                <form method="post" action="/admin/mcp/accounts" class="form popup-form">
                    #csrfFormField()
                    <label class="form-label" for="mcp-new-account">
                        Create account
                        <input id="mcp-new-account" class="form-input" type="text" name="username" required
                               autocomplete="new-password" placeholder="course-bot">
                        <span class="field-note field-note--muted">A new account has no course access until you enrol it in a course.</span>
                    </label>
                    <div class="toolbar">
                        <button class="btn btn-primary btn-compact" type="submit">Create account</button>
                    </div>
                </form>
            </div>
        </details>
    </div>

    #if(count(accounts) == 0):
    <p class="text-muted">No MCP accounts yet.</p>
    #else:
    <table class="results-table section-items section-items--manage">
        <colgroup>
            <col class="section-items-tile"><col><col class="section-items-actions">
        </colgroup>
        <thead class="visually-hidden">
            <tr><th scope="col">Account</th><th scope="col">Detail</th><th scope="col">Actions</th></tr>
        </thead>
        <tbody>
        #for(account in accounts):
            <tr>
                <td class="item-tile-cell"><span class="item-tile" data-kind="notebook"><svg class="icon" aria-hidden="true"><use href="#i-cpu"/></svg></span></td>
                <td class="item-main">
                    <div class="item-title"><code>#(account.username)</code></div>
                    <div class="item-details#if(account.coursesText == ""): item-details--danger#endif">created <span class="js-relative-time" data-iso="#(account.createdAt)">#(account.createdAt)</span> · #if(account.coursesText == ""):No course access#else:#(account.coursesText)#endif</div>
                </td>
                <td class="item-actions-td">
                    <div class="assignment-actions-cell">
                        #if(enabled):
                        #if(writeAllowed):
                        <details class="add-section-details popup-anchor">
                            <summary class="btn action-btn summary-btn">Mint token <svg class="icon" aria-hidden="true"><use href="#i-chevron-down"/></svg></summary>
                            <div class="add-section-popup card suite-section-popup row-menu-panel" role="menu">
                                <form method="post" action="/admin/mcp/accounts/#(account.id)/token">
                                    #csrfFormField()
                                    <input type="hidden" name="scope" value="readwrite">
                                    <button class="row-menu-item" type="submit" role="menuitem">Read + write</button>
                                </form>
                                <form method="post" action="/admin/mcp/accounts/#(account.id)/token">
                                    #csrfFormField()
                                    <input type="hidden" name="scope" value="read">
                                    <button class="row-menu-item" type="submit" role="menuitem">Read only</button>
                                </form>
                            </div>
                        </details>
                        #else:
                        <form method="post" action="/admin/mcp/accounts/#(account.id)/token" class="form-flush">
                            #csrfFormField()
                            <input type="hidden" name="scope" value="read">
                            <button class="btn action-btn" type="submit">Mint token</button>
                        </form>
                        #endif
                        #endif
                        <details class="ext-details row-menu">
                            <summary class="btn action-btn action-btn-icon ext-summary" title="More actions" aria-label="More actions for #(account.username)">
                                <svg class="icon" aria-hidden="true"><use href="#i-more"/></svg>
                            </summary>
                            <div class="popover-panel row-menu-panel" role="menu">
                                #if(count(account.enrollableCourses) > 0):
                                <form method="post" action="/admin/mcp/accounts/#(account.id)/enroll" class="mcp-enroll-form">
                                    #csrfFormField()
                                    <label class="visually-hidden" for="enroll-#(account.id)">Enrol #(account.username) in a course</label>
                                    <select id="enroll-#(account.id)" name="courseID" class="form-input">
                                        #for(c in account.enrollableCourses):
                                        <option value="#(c.id)">#(c.code)#if(c.termLabel): #(c.termLabel)#endif</option>
                                        #endfor
                                    </select>
                                    <button class="btn action-btn" type="submit">Enrol</button>
                                </form>
                                #endif
                                #for(c in account.enrolledCourses):
                                <form method="post" action="/admin/mcp/accounts/#(account.id)/unenroll">
                                    #csrfFormField()
                                    <input type="hidden" name="courseID" value="#(c.id)">
                                    <button class="row-menu-item" type="submit" role="menuitem">Remove from #(c.code)#if(c.termLabel): #(c.termLabel)#endif</button>
                                </form>
                                #endfor
                                <form method="post" action="/admin/mcp/accounts/#(account.id)/delete"
                                      data-confirm="Delete the MCP account #(account.username)? It loses access immediately. Tokens it already minted stay valid until they expire, and the account cannot be restored.">
                                    #csrfFormField()
                                    <button class="row-menu-item row-menu-item--danger" type="submit" role="menuitem">
                                        <svg class="icon" aria-hidden="true"><use href="#i-trash"/></svg>Delete account
                                    </button>
                                </form>
                            </div>
                        </details>
                    </div>
                </td>
            </tr>
        #endfor
        </tbody>
    </table>
    #endif
</section>
#endif

<section class="page-section">
    <h2>Connected agents</h2>
    #if(count(grants) == 0):
    <p class="text-muted">No agents have connected yet.</p>
    #else:
    <table class="results-table section-items section-items--manage">
        <colgroup>
            <col class="section-items-tile"><col><col class="section-items-count"><col class="section-items-count">
        </colgroup>
        <thead class="visually-hidden">
            <tr><th scope="col">Agent</th><th scope="col">Detail</th><th scope="col">Status</th><th scope="col">Actions</th></tr>
        </thead>
        <tbody>
        #for(grant in grants):
            <tr#if(!grant.canRevoke): class="row-muted"#endif>
                <td class="item-tile-cell"><span class="item-tile" data-kind="notebook"><svg class="icon" aria-hidden="true"><use href="#i-cpu"/></svg></span></td>
                <td class="item-main">
                    <div class="item-title">#(grant.agentName)</div>
                    <div class="item-details">authorized by <code>#(grant.owner)</code> · last used #if(grant.lastUsedAt):<span class="js-relative-time" data-iso="#(grant.lastUsedAt)">#(grant.lastUsedAt)</span>#else:never#endif · expires <span class="js-relative-time" data-iso="#(grant.expiresAt)">#(grant.expiresAt)</span> · <code>#(grant.scope)</code></div>
                </td>
                <td class="item-status">
                    <span class="tier #if(grant.canRevoke):tier-open#elseif(grant.revoked):tier-closed#else:tier-preview#endif">#(grant.statusLabel)</span>
                </td>
                <td class="item-actions-td">
                    <div class="assignment-actions-cell">
                        #if(grant.canRevoke):
                        <details class="ext-details row-menu">
                            <summary class="btn action-btn action-btn-icon ext-summary" title="More actions" aria-label="More actions for #(grant.agentName)">
                                <svg class="icon" aria-hidden="true"><use href="#i-more"/></svg>
                            </summary>
                            <div class="popover-panel row-menu-panel" role="menu">
                                <form method="post" action="/agents/#(grant.id)/revoke"
                                      data-confirm="Revoke this agent? It loses access immediately. The audit record of what it did is kept, and the agent can be authorized again from its client.">
                                    #csrfFormField()
                                    <button class="row-menu-item row-menu-item--danger" type="submit" role="menuitem">Revoke agent</button>
                                </form>
                            </div>
                        </details>
                        #else:
                        <span class="row-menu-spacer" aria-hidden="true"></span>
                        #endif
                    </div>
                </td>
            </tr>
        #endfor
        </tbody>
    </table>
    #endif
</section>
<style>
.mcp-token-caption { margin: .1rem 0 .5rem; }
.mcp-enroll-form {
    display: flex;
    gap: .3rem;
    padding: .3rem;
}
</style>
#endexport
#endextend
