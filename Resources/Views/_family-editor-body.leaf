<!--
    Pattern-family / notebook-check editor body, shared by assignment-new
    and assignment-edit (both drive it with the shared
    Public/pattern-family-editor.js).  The variable table is 4-column
    (valid / name / value / action) to match the rows that JS builds.
-->
<div id="family-editor-body" class="family-editor-body" hidden style="display:none">
            <div class="family-editor-grid">
                <label id="family-function-label" class="field-stack">
                    Function
                    <select class="form-input editor-input" id="family-function-select">
                        <option value="">— Scanning solution notebook… —</option>
                    </select>
                    <span id="family-function-hint" class="card-meta hint-xs"></span>
                </label>
                <label class="field-stack">
                    Family name (shown in UI)
                    <input type="text" class="form-input editor-input" id="family-name" placeholder="BMI Category Boundaries">
                </label>
            </div>
            <div class="family-editor-grid">
                <label class="field-stack">
                    Pattern kind
                    <select class="form-input editor-input" id="family-kind">
                        <option value="boundary_equality">Exact equality (== comparison)</option>
                        <option value="approximate_equality">Approximate equality (float tolerance)</option>
                        <option value="variable_equality">Variable equality (module-level variable)</option>
                        <option value="return_type_check">Return type check (isinstance / class name)</option>
                        <option value="exception_expected">Exception expected (function raises a specific class)</option>
                        <option value="performance_threshold">Performance threshold (max milliseconds)</option>
                        <option value="stdout_equality">Stdout equality (compare captured print output)</option>
                        <option value="unordered_equality">Unordered equality (list compare, ignore order)</option>
                        <option value="differential">Differential (compare against a reference implementation)</option>
                    </select>
                </label>
                <label id="family-tolerance-label" class="field-stack" style="display:none">
                    Tolerance (max |result − expected|)
                    <input type="number" class="form-input editor-input" id="family-default-tolerance" step="any" min="0"
                           placeholder="1e-6">
                </label>
            </div>
            <label id="family-reference-label" class="field-stack" style="display:none">
                Reference implementation
                <span class="label-note">(required — define <code>ck_ref_&lt;function&gt;</code> taking the same arguments; each case&#39;s expected value is whatever it returns, so leave the Expected column blank)</span>
                <textarea class="form-input editor-input family-reference-input" id="family-reference-implementation"
                          rows="8" spellcheck="false"
                          placeholder="def ck_ref_classify(bmi):&#10;    ..."></textarea>
            </label>
            <label class="field-stack">
                Default hint <span class="label-note">(optional — shown to students when a case with no hint of its own fails)</span>
                <input type="text" class="form-input editor-input" id="family-default-hint" value=""
                       placeholder="e.g. Re-check the boundary values in the spec.">
            </label>
            <!-- Hidden fields: the family id, function name, and param list
                 are derived from the function dropdown selection. -->
            <input type="hidden" id="family-id">
            <input type="hidden" id="family-function">
            <input type="hidden" id="family-params">

            <!-- v0.4.108: section-shared inputs were a separate read-only
                 block above the Variables table.  Now merged INTO the
                 Variables table as locked rows at the top, so the
                 instructor sees one unified list of $names available
                 across all cases.  The section name renders in the
                 label-note span inside the subhead (written by
                 renderReadOnlySectionVars in pattern-family-editor.js). -->
            <div>
                <div class="family-subhead">
                    <strong class="subhead-label">Variables (shared across all cases) <span id="family-section-name-label" class="label-note"></span></strong>
                    <button class="btn action-btn btn-sm" type="button" id="add-family-variable-btn">
                        + Add variable
                    </button>
                </div>
                <table class="results-table table-sm" id="family-variables-table">
                    <thead>
                        <tr>
                            <th class="fv-valid-col" aria-label="Valid"></th>
                            <th class="fv-name-col">Name</th>
                            <th id="family-variable-value-header">Value (JSON or literal)</th>
                            <th class="fv-action-col"></th>
                        </tr>
                    </thead>
                    <tbody id="family-variables-body"></tbody>
                </table>
                <p class="card-meta family-empty-note" id="family-variables-empty">
                    Define a name and a value (e.g. a list or a mapping) once; reference it from any arg cell by typing <code>$name</code>.  Locked rows come from the section's shared inputs (edit in the section's Inputs table).
                </p>
            </div>

            <div>
                <div class="family-subhead">
                    <strong class="subhead-label">Cases</strong>
                    <button class="btn action-btn btn-sm" type="button" id="add-case-btn">
                        + Add case
                    </button>
                </div>
                <table class="results-table table-sm" id="family-cases-table">
                    <thead>
                        <tr id="family-cases-header">
                            <th class="case-num-col">#</th>
                            <th>Label</th>
                            <!-- One arg column per detected parameter; columns are rebuilt
                                 dynamically when the function changes. -->
                            <th class="pf-case-expected-col">Expected</th>
                            <th class="fv-action-col"></th>
                        </tr>
                    </thead>
                    <tbody id="family-cases-body"></tbody>
                </table>
                <p class="card-meta family-empty-note" id="family-cases-empty">
                    No cases yet.  Add at least one to save this family.
                </p>
            </div>
    <span id="family-editor-status" class="editor-status"></span>
</div>
