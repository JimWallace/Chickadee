<!-- One student's assignment rows. Rendered twice on the page (per course
     section, then ungrouped) from ONE definition: the two blocks were
     byte-identical apart from the list they looped over, so every fix to a
     row action had to be made in both (UI audit S7). The caller passes its
     list as `rows` via extend's sub-context form. -->
<table class="results-table submissions-table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Status</th>
            <th class="due-col col-hide-phone">Due</th>
            <th>Grade</th>
            <th class="col-hide-phone">History</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    #for(row in rows):
        <tr>
            <td>
                <div class="assignment-title-cell">
                    <strong>#(row.title)</strong>
                    #if(count(row.badges) > 0):
                    <span class="achievement-badges achievement-badges-compact">
                        #for(badge in row.badges):
                        <span class="achievement-badge achievement-badge-compact" title="#(badge.tooltip)">#(badge.label)</span>
                        #endfor
                    </span>
                    #endif
                </div>
            </td>
            <td>
                <span class="tier
                    #if(row.status == "open"):tier-open
                    #elseif(row.status == "closed"):tier-closed
                    #endif">#(row.status)</span>
            </td>
            <td class="due-col col-hide-phone">
                #if(row.effectiveDueAtText):
                    <span title="Assignment-wide due date: #if(row.dueAtText):#(row.dueAtText)#else:none#endif">#(row.effectiveDueAtText)<br><span class="extension-note">+ extension</span></span>
                #elseif(row.dueAtText):
                    #(row.dueAtText)
                #else:
                    —
                #endif
            </td>
            <td>
                #if(row.bestGradeText):
                    <strong>#(row.bestGradeText)</strong>
                    #if(row.gradeIsOverridden):
                    <span class="grade-override-tag" title="Grade manually overridden by an instructor">overridden</span>
                    #endif
                #else:
                    <span class="empty">—</span>
                #endif
            </td>
            <td class="col-hide-phone">
                #if(row.submissionCount > 0):
                    <div class="submission-history-cell">
                        #if(row.hasLatestSubmission):
                            <a href="/submissions/#(row.latestSubmissionID)" class="submission-history-latest">#(row.latestSubmittedAtText)</a>
                        #endif
                        #if(row.additionalSubmissionCount > 0):
                            <a href="#(row.historyURL)" class="submission-history-more">+#(row.additionalSubmissionCount) more</a>
                        #endif
                    </div>
                #else:
                    <span class="empty">No submissions yet</span>
                #endif
            </td>
            <td>
                <div class="student-row-actions">
                    #if(row.submissionCount > 0):
                    <form method="post" action="#(row.retestPath)" data-confirm="Re-test all of this student’s submissions on this assignment?" class="form-flush">
                        #csrfFormField()
                        <button class="btn action-btn action-btn-icon" type="submit" aria-label="Re-test this student’s submissions" title="Re-test every submission this student has on this assignment">
                            <svg class="icon" aria-hidden="true"><use href="#i-refresh"/></svg>
                        </button>
                    </form>
                    #endif
                    <details class="ext-details form-flush">
                        <summary class="btn action-btn action-btn-icon ext-summary" title="#if(row.hasExtension):Edit this student’s deadline extension#else:Grant this student a deadline extension#endif" aria-label="#if(row.hasExtension):Edit deadline extension#else:Grant deadline extension#endif">
                            #if(row.hasExtension):
                            <svg class="icon" aria-hidden="true"><use href="#i-calendar-check"/></svg>
                            #else:
                            <svg class="icon" aria-hidden="true"><use href="#i-calendar"/></svg>
                            #endif
                        </summary>
                        <form method="post" action="#(row.extensionSavePath)" class="popover-panel">
                            #csrfFormField()
                            <label class="ext-field-label">
                                New deadline for this student
                                <input type="datetime-local" name="extendedDueAt" value="#(row.extensionFormInput)" required class="ext-field-input">
                            </label>
                            <label class="ext-field-label">
                                Note (optional)
                                <input type="text" name="note" placeholder="Reason for extension" class="ext-field-input">
                            </label>
                            <div class="ext-panel-actions">
                                <button class="btn action-btn" type="submit">Save</button>
                                #if(row.hasExtension):
                                <button class="btn action-btn" type="submit" formaction="#(row.extensionDeletePath)" formnovalidate data-confirm="Remove this student’s extension on this assignment?">Remove</button>
                                #endif
                            </div>
                        </form>
                    </details>
                    <details class="ext-details form-flush">
                        <summary class="btn action-btn action-btn-icon ext-summary#if(row.gradeIsOverridden): grade-override-active#endif" title="#if(row.gradeIsOverridden):Edit this student’s grade override#else:Override this student’s grade#endif" aria-label="#if(row.gradeIsOverridden):Edit grade override#else:Override grade#endif">
                            <svg class="icon" aria-hidden="true"><use href="#i-scissors"/></svg>
                        </summary>
                        <form method="post" action="#(row.gradeOverrideSavePath)" class="popover-panel">
                            #csrfFormField()
                            <label class="ext-field-label">
                                Override grade (%)
                                <input type="number" name="overridePercent" min="0" max="100" step="1" value="#(row.gradeOverridePercent)" required class="ext-field-input">
                            </label>
                            <label class="ext-field-label">
                                Note (optional)
                                <input type="text" name="note" placeholder="Reason for override" class="ext-field-input">
                            </label>
                            <div class="ext-panel-actions">
                                <button class="btn action-btn" type="submit">Save</button>
                                #if(row.gradeIsOverridden):
                                <button class="btn action-btn" type="submit" formaction="#(row.gradeOverrideClearPath)" formnovalidate data-confirm="Clear this student’s grade override and revert to the auto-graded result?">Clear</button>
                                #endif
                            </div>
                        </form>
                    </details>
                    <form method="post" action="#(row.resetPath)" data-confirm="Reset this student’s working-copy notebook back to the original assignment starter? Past submissions are not affected. The student will see the fresh starter automatically on their next visit." class="form-flush">
                        #csrfFormField()
                        <button class="btn action-btn action-btn-icon action-danger" type="submit" aria-label="Reset this student’s working notebook" title="Reset this student’s working-copy notebook to the original starter">
                            <svg class="icon" aria-hidden="true"><use href="#i-rewind"/></svg>
                        </button>
                    </form>
                </div>
            </td>
        </tr>
    #endfor
    </tbody>
</table>
