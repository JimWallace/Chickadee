#extend("base"):
#export("title"):
Add to LMS
#endexport
#export("content"):
<h1>Add to LMS</h1>
<p class="section-intro">Choose what to add from #(courseCode). Each choice becomes a link that opens it in Chickadee.</p>
#if(error):
<div class="form-error" role="alert">#(error)</div>
#endif
#if(count(assignments) == 0):
<p class="empty">This course has no assignments yet.</p>
<p class="section-note"><a href="/instructor/new" target="_blank" rel="noopener noreferrer">Create an assignment</a>, then open the LMS content picker again.</p>
#else:
<form method="post" action="/lti/deep-link" class="form-stack">
    <input type="hidden" name="ticket" value="#(ticket)">
    <fieldset class="fieldset-plain">
        <legend class="visually-hidden">Assignments</legend>
        <div class="checkbox-list">
        #for(assignment in assignments):
        <label class="checkbox-row">
            #if(acceptMultiple):
            <input type="checkbox" name="assignments[]" value="#(assignment.publicID)">
            #else:
            <input type="radio" name="assignments[]" value="#(assignment.publicID)" required>
            #endif
            #(assignment.title)
        </label>
        #endfor
        </div>
    </fieldset>
    <div class="toolbar toolbar--end">
        <button class="btn btn-primary" type="submit">Add to LMS</button>
    </div>
</form>
#endif
#endexport
#endextend
