<style>
#if(!embedded):
/* Override the 900px max-width for this page only.  The default .main also
   carries a 2rem top+bottom margin (styles.css) — wasted vertical space on the
   editor page, where every pixel counts on laptops/iPads — so trim it to a
   hairline top margin and no bottom margin.

   Emitted only when this body *is* the page.  Embedded (#1266: inlined into
   the workbench, in the same document as the edit half) `.main` belongs to the
   host, which sizes itself to the viewport — restyling it from here would
   reach outside this half and fight `.main-fullbleed`. */
.main { max-width: 100%; padding: 0 1rem; margin: .5rem auto 0; }
#endif

/* Closed-assignment "view only" notice. */
.nb-closed-notice { color: var(--gray-600); font-size: var(--text-base); }

/* The JupyterLite editor needs room and a pointer; it is unusable on a phone.
   Below 640px we hide the editor surface and show a notice instead.  Tablets
   (641px+) keep the full editor. */
.nb-smallscreen-notice { display: none; }
@media (max-width: 640px) {
    .notebook-header,
    #jl-frame,
    #js-nb-fallback,
    #nb-device-warning, #nb-slow-notice,
    #nb-browser-support-warning,
    #nb-results,
    #browser-runner-status { display: none; }
    /* The panel itself is the global .standin-panel; only its appearance at
       this breakpoint is page-specific. */
    .nb-smallscreen-notice { display: block; }
}
</style>
<div class="notebook-header">
    <div class="notebook-toolbar">
        <span class="nb-status" id="nb-status" role="status" aria-live="polite" aria-atomic="true" tabindex="-1"></span>
        <div class="notebook-actions">
            #if(isStudentSolutionView):
            <span class="nb-closed-notice">Reference solution#if(isReadOnly): &mdash; view only.#endif</span>
            #elseif(isTemplateView):
            <span class="nb-closed-notice">Editing the template &mdash; placeholders stand as written.</span>
            #elseif(showSubmit):
            <button class="btn btn-primary" type="button" id="nb-submit">Submit</button>
            #elseif(isReadOnly):
            <span class="nb-closed-notice">This assignment is closed &mdash; view only.</span>
            #elseif(isClosed):
            <span class="nb-closed-notice">This assignment is closed to students &mdash; editable as course staff.</span>
            #endif
            #if(viewToggleURL):
            #if(!embedded):
            <!-- Suppressed in a workbench pane: the workbench has its own
                 template/values control, so this would be a second one for the
                 same thing — and `viewToggleURL` carries no `embedded=1`, so
                 following it would load the fully-chromed page into the pane. -->
            <a class="btn" href="#(viewToggleURL)">
                #if(isTemplateView):View with values#else:Edit the template#endif
            </a>
            #endif
            #endif
            #if(canSaveToAssignment):
            <!-- Present but hidden in a workbench pane: the workbench's single
                 Save calls the function notebook.js binds here, so the element
                 must exist — but a second visible Save button would be the same
                 action twice. -->
            <button class="btn btn-primary" type="button" id="nb-save-assignment" #if(embedded):hidden#endif data-file-kind="#(fileKind)"
                    data-view-mode="#if(isTemplateView):template#else:personalized#endif"
                    title="Write what is in this editor back to the assignment for every student">
                #if(fileKind == "solution"):Save solution#else:Save to assignment#endif
            </button>
            #endif
            #if(solutionViewURL):
            <a class="btn" href="#(solutionViewURL)">View solution</a>
            #endif
            #if(downloadURL):
            #if(!embedded):
            <!-- Suppressed in a workbench pane: the left pane's Files table
                 already links the file, so this is a second route to the same
                 download.  Kept on the standalone page, where it is the only
                 one. -->
            <a class="btn"
               href="#(downloadURL)"
               download>Download</a>
            #endif
            #endif
        </div>
    </div>
</div>
<!-- The three dismissible notices below are revealed by notebook-preflight.js.
     They do not block: the editor still loads beneath them. -->
<div id="nb-browser-support-warning" class="flash flash-warning" role="status" hidden>
    <div class="toolbar">
        <span><strong>Browser not fully supported.</strong> You can keep working; your submission is still graded on our servers.</span>
        <button type="button" id="nb-browser-support-dismiss" class="btn action-btn" aria-label="Dismiss browser notice">Dismiss</button>
    </div>
</div>
<div id="nb-device-warning" class="flash flash-warning" role="status" hidden>
    <div class="toolbar">
        <span><strong>Low memory.</strong> If the notebook slows or the kernel stops, use a laptop or desktop.</span>
        <button type="button" id="nb-device-warning-dismiss" class="btn action-btn" aria-label="Dismiss memory notice">Dismiss</button>
    </div>
</div>
<!-- The slow-boot notice. notebook-preflight.js writes its title and text
     from FALLBACK_COPY.slow (notebook-preflight-core.js) when it reveals it.
     The file input is a second upload path, because the editor may never
     start; notebook.js gives it the same handler as the one in the failure
     panel. -->
<div id="nb-slow-notice" class="flash flash-warning" role="status" hidden>
    <div class="toolbar">
        <span><strong class="js-nb-slow-title"></strong> <span class="js-nb-slow-text"></span></span>
        <input type="file" id="nb-slow-upload-file" accept=".ipynb,application/json" aria-label="Upload your .ipynb file">
        <a href="https://github.com/JimWallace/Chickadee/blob/main/docs/notebook-editor-help.md#the-editor-is-slow-to-load" target="_blank" rel="noopener noreferrer">More help <svg class="icon" aria-hidden="true"><use href="#i-external"/></svg><span class="visually-hidden">(opens in a new tab)</span></a>
        <button type="button" id="nb-slow-notice-dismiss" class="btn action-btn" aria-label="Dismiss loading notice">Dismiss</button>
    </div>
</div>
<div class="nb-smallscreen-notice standin-panel" role="note">
    <h2 class="standin-panel-title">Open on a larger screen</h2>
    <p class="standin-panel-text">
        The notebook editor needs a tablet or computer. Please reopen this
        assignment on a larger screen to edit and submit your notebook.
    </p>
</div>
<!-- The failure panel, shown only when the editor failed: notebook-preflight.js
     hides the editor and reveals it. A slow boot uses the notice above
     instead (#2028). The js- classes are the hooks notebook-preflight.js
     rewrites; the standin-panel classes carry the look. The panel sits above
     the editor's place on the page, so it is in view. -->
<section id="js-nb-fallback" class="standin-panel" role="alert" hidden>
    <h2 class="standin-panel-title js-nb-fallback-title">Editor did not load</h2>
    <p class="standin-panel-text js-nb-fallback-text">
        To submit your work, upload your <code>.ipynb</code> file.
    </p>
    <p class="standin-panel-text">
        <input type="file" id="nb-upload-file" accept=".ipynb,application/json" aria-label="Upload your .ipynb file">
    </p>
    <p class="standin-panel-text">
        If the problem continues,
        <a id="nb-reset-editor-link" href="/reset-editor">reset the notebook editor</a>
        or read the
        <a href="https://github.com/JimWallace/Chickadee/blob/main/docs/notebook-editor-help.md" target="_blank" rel="noopener noreferrer">notebook editor help <svg class="icon" aria-hidden="true"><use href="#i-external"/></svg><span class="visually-hidden">(opens in a new tab)</span></a>.
    </p>
    <details>
        <summary>Diagnostic details</summary>
        <pre id="js-nb-fallback-details"></pre>
    </details>
</section>
<!-- The editor is booted by notebook.js *after* the capability preflight
     resolves (mountEditor sets the iframe src from data-editor-url), not
     eagerly here. Booting eagerly during HTML parse raced the preflight's
     service-worker registration and IndexedDB probes — the same subsystems the
     kernel's cold boot uses — and intermittently left the kernel dead
     ("Kernel Unknown"). Starting at about:blank serializes the load. On phones
     notebook.js skips the mount entirely, so the iframe stays about:blank. -->
<iframe
    id="jl-frame"
    class="jl-frame#if(embedded): jl-frame-embedded#endif"
    title="Notebook editor"
    data-setup-id="#(testSetupID)"
    data-grading-mode="#(gradingMode)"
    data-browser-unsupported="#(browserUnsupported)"
    data-notebook-url="#(notebookURL)"
    data-editor-url="#(jupyterLiteEditorURL)"
    data-working-copy-mtime="#(workingCopyMtime)"
    data-read-only="#(isReadOnly)"
    src="about:blank"
    loading="eager">
</iframe>
<div id="nb-results" class="nb-results" hidden></div>
<div id="browser-runner-status" class="nb-status" role="status" aria-live="polite" aria-atomic="true" hidden></div>
<script src="/notebook-preflight-core.js?v=#appVersion()"></script>
<script src="/notebook-preflight.js?v=#appVersion()"></script>
<script src="/grading-shared.js?v=#appVersion()"></script>
<script src="/r-grading-shared.js?v=#appVersion()"></script>
<script src="/lua-grading-shared.js?v=#appVersion()"></script>
<script src="/octave-grading-shared.js?v=#appVersion()"></script>
<script src="/notebook-core.js?v=#appVersion()"></script>
<script src="/notebook.js?v=#appVersion()"></script>
<script src="/browser-runner.js?v=#appVersion()" data-setup-id="#(testSetupID)" data-grading-mode="#(gradingMode)"></script>
