#extend("base"):
#export("title"):
#if(isNew):New Course — Admin#else:#(course.code) — Admin#endif
#endexport
#export("content"):
#if(isNew):
<div class="page-titlebar">
    <h1>New Course</h1>
    <a href="/admin" class="btn">Cancel</a>
</div>

<section class="page-section">
    <h2>Course details</h2>
    <form method="post" action="/admin/courses" class="form-stack">
        #csrfFormField()
        #extend("_course-fields", courseForm)
        <div class="field-stack field-stack--narrow">
            <label for="new-course-instructor">Instructor (optional)</label>
            <input id="new-course-instructor" class="form-input" type="text" name="instructor"
                   autocomplete="off" placeholder="e.g. jdoe" aria-describedby="new-course-instructor-note">
            <p class="field-note" id="new-course-instructor-note">#if(placeholderAllowed):A username. The person need not have signed in; their first sign-in adopts the account.#else:The username of an existing account.#endif</p>
        </div>
        <div class="toolbar">
            <button class="btn btn-primary" type="submit">Create course</button>
        </div>
    </form>
</section>
#else:
#extend("_avatar-sprite")
<div class="page-titlebar">
    <h1>#(course.code)#if(course.termLabel): #(course.termLabel)#endif — #(course.name)</h1>
    <div class="toolbar">
        <a class="btn action-btn" href="#course-settings-panel" data-add-target="course-settings-panel">Edit settings</a>
        <a class="btn action-btn" href="#clone-course" data-add-target="clone-course">Clone course</a>
        <details class="add-section-details popup-anchor">
            <summary class="btn action-btn action-btn-icon summary-btn" title="More actions" aria-label="More actions for #(course.code)">
                <svg class="icon" aria-hidden="true"><use href="#i-more"/></svg>
            </summary>
            <div class="add-section-popup card suite-section-popup row-menu-panel" role="menu">
                <a class="row-menu-item" href="/admin/courses/#(course.id)/export" role="menuitem">
                    <svg class="icon" aria-hidden="true"><use href="#i-download"/></svg>Export course bundle
                </a>
                #if(course.isArchived):
                <form method="post" action="/admin/courses/#(course.id)/archive"
                      data-confirm="Unarchive #(course.code)? #(course.enrollmentCount) students regain access immediately, and the retention clock stops.">
                    #csrfFormField()
                    <button class="row-menu-item" type="submit" role="menuitem">
                        <svg class="icon" aria-hidden="true"><use href="#i-archive"/></svg>Unarchive course
                    </button>
                </form>
                #else:
                <form method="post" action="/admin/courses/#(course.id)/archive"
                      data-confirm="Archive #(course.code)? #(course.enrollmentCount) students lose access immediately. Submissions, grades and audit records are kept, and Unarchive on this page puts it back.">
                    #csrfFormField()
                    <button class="row-menu-item row-menu-item--danger" type="submit" role="menuitem">
                        <svg class="icon" aria-hidden="true"><use href="#i-archive"/></svg>Archive course
                    </button>
                </form>
                #endif
            </div>
        </details>
    </div>
</div>

<div class="add-panel card#if(courseForm.error): is-open#endif" id="course-settings-panel">
    <form method="post" action="/admin/courses/#(course.id)/edit" class="form-stack">
        #csrfFormField()
        #extend("_course-fields", courseForm)
        #if(course.brightspaceSyncEnabled):
        <div class="field-stack field-stack--narrow">
            <label for="course-settings-org-unit">LEARN org unit ID</label>
            <input id="course-settings-org-unit" class="form-input" type="text" name="brightspaceOrgUnitID"
                   value="#(course.brightspaceOrgUnitID)" placeholder="e.g. 123456"
                   aria-describedby="course-settings-org-unit-note">
            <p class="field-note" id="course-settings-org-unit-note">Checked against D2L when you save.</p>
        </div>
        #endif
        <div class="toolbar">
            <button class="btn btn-primary" type="submit">Save settings</button>
            <button class="btn action-btn js-add-cancel" type="button">Cancel</button>
        </div>
    </form>
</div>

<div class="add-panel card#if(cloneForm.error): is-open#endif" id="clone-course">
    <form method="post" action="/admin/courses/#(course.id)/clone" class="form-stack">
        #csrfFormField()
        <p class="section-note">Students, submissions and grades stay here; copied assignments start closed, with no dates and the solution reveal off.</p>
        #extend("_course-fields", cloneForm)
        <div class="toolbar">
            <button class="btn btn-primary" type="submit">Clone course</button>
            <button class="btn action-btn js-add-cancel" type="button">Cancel</button>
        </div>
    </form>
</div>

<div class="card section-gap">
    <dl class="detail-grid">
        <dt>Status</dt>
        <dd>#if(course.isArchived):<span class="tier tier-closed">Archived</span>#else:<span class="tier tier-open">Active</span>#endif</dd>
        <dt>Term</dt>
        <dd>#if(course.termLabel):#(course.termLabel)#else:<span class="text-muted">None recorded</span>#endif</dd>
        <dt>Submissions</dt>
        <dd>#(course.submissionCount)</dd>
        #if(course.brightspaceSyncEnabled):
        <dt>LEARN org unit</dt>
        <dd>
            #if(course.brightspaceOrgUnitID):
            #if(course.brightspaceOrgUnitName):
            #(course.brightspaceOrgUnitName) <span class="card-meta">ID <code>#(course.brightspaceOrgUnitID)</code></span>
            <span class="tier tier-open">Verified</span>
            #else:
            <code>#(course.brightspaceOrgUnitID)</code>
            <span class="tier tier-danger">Not verified</span>
            <span class="card-meta">Save the settings again to retry.</span>
            #endif
            #else:
            <span class="text-muted">Not set</span>
            #endif
        </dd>
        #endif
    </dl>
</div>
#endif

<!-- ── Assignments ─────────────────────────────────── -->
<section class="page-section">
    <h2>Assignments (#count(assignments))</h2>
    #if(count(assignments) == 0):
    <p class="empty">No assignments for this course.</p>
    #else:
    <table class="results-table section-items">
        <colgroup>
            <col class="section-items-tile"><col><col class="section-items-status">
        </colgroup>
        <thead class="visually-hidden">
            <tr><th scope="col">Kind</th><th scope="col">Assignment</th><th scope="col">Status</th></tr>
        </thead>
        <tbody>
        #for(assignment in assignments):
            <tr>
                <td class="item-tile-cell"><span class="item-tile" data-kind="graded"><svg class="icon" aria-hidden="true"><use href="#i-calendar-check"/></svg></span></td>
                <td class="item-main">
                    <div class="item-title"><a href="/instructor/#(assignment.id)/submissions">#(assignment.title)</a></div>
                    <div class="item-details">#if(assignment.dueAt):Due #(assignment.dueAt)#else:No due date#endif</div>
                </td>
                <td class="item-status">
                    #if(assignment.visibility == "open"):
                    <span class="tier tier-open">Open</span>
                    #elseif(assignment.visibility == "preview"):
                    <span class="tier tier-preview">Preview</span>
                    #else:
                    <span class="tier tier-closed">Closed</span>
                    #endif
                </td>
            </tr>
        #endfor
        </tbody>
    </table>
    #endif
</section>

#if(!isNew):
<!-- ── Enrolled students ────────────────────────────── -->
<section class="page-section">
    <div class="page-titlebar">
        <h2>Enrolled students (#(course.enrollmentCount))</h2>
        <div class="toolbar">
            <form method="post" action="/admin/courses/#(course.id)/enrollment-mode" class="form-flush">
                #csrfFormField()
                <label class="visually-hidden" for="enrollment-mode">Enrolment mode</label>
                <span class="state-select" data-state="#(course.enrollmentMode)">
                    <select id="enrollment-mode" name="enrollmentMode" class="form-input" data-ck-submit-on-change>
                        <option value="open"   #if(course.enrollmentMode == "open"):selected#endif>Open enrolment</option>
                        <option value="auto"   #if(course.enrollmentMode == "auto"):selected#endif>Auto enrolment</option>
                        <option value="closed" #if(course.enrollmentMode == "closed"):selected#endif>Closed enrolment</option>
                    </select>
                </span>
            </form>
            #if(!course.isArchived):
            <a class="btn action-btn" href="#add-staff-panel" data-add-target="add-staff-panel">Add staff</a>
            <form method="post" action="/admin/courses/#(course.id)/enroll-csv"
                  enctype="multipart/form-data" class="form-flush">
                #csrfFormField()
                <label class="btn action-btn">
                    Enrol from CSV
                    <input type="file" name="file" accept=".csv,.txt" required
                           style="display:none" data-ck-submit-on-change>
                </label>
            </form>
            #endif
        </div>
    </div>
    #if(!course.isArchived):
    <div class="add-panel card#if(flashError): is-open#endif" id="add-staff-panel">
        <form method="post" action="/admin/courses/#(course.id)/staff" class="form-stack">
            #csrfFormField()
            <div class="toolbar">
                <div class="field-stack field-stack--grow">
                    <label for="add-staff-identifier">Username or email</label>
                    <input id="add-staff-identifier" class="form-input" type="text" name="identifier"
                           required autocomplete="off" aria-describedby="add-staff-note">
                </div>
                <div class="field-stack field-stack--narrow">
                    <label for="add-staff-role">Role</label>
                    <select id="add-staff-role" class="form-input" name="role">
                        <option value="instructor">Instructor</option>
                        <option value="ta">TA</option>
                    </select>
                </div>
            </div>
            <p class="field-note" id="add-staff-note">#if(placeholderAllowed):An email finds only an existing account. A username with no account gets one that the first sign-in adopts.#else:The username or email of an existing account.#endif</p>
            <div class="toolbar">
                <button class="btn btn-primary" type="submit">Add</button>
                <button class="btn action-btn js-add-cancel" type="button">Cancel</button>
            </div>
        </form>
    </div>
    #endif
    #if(count(enrolledUsers) == 0):
    <p class="empty">No students enrolled yet.</p>
    #else:
    <table class="results-table section-items section-items--manage">
        <colgroup>
            <col class="section-items-tile"><col><col class="section-items-status"><col class="section-items-actions">
        </colgroup>
        <thead class="visually-hidden">
            <tr><th scope="col">Person</th><th scope="col">Name</th><th scope="col">Role</th><th scope="col">Actions</th></tr>
        </thead>
        <tbody>
        #for(user in enrolledUsers):
            <tr>
                <td class="item-tile-cell">#if(user.hasAvatar):#extend("_avatar", user.avatar)#endif</td>
                <td class="item-main">
                    <div class="item-title">#if(user.displayName):#(user.displayName)#else:#(user.username)#endif</div>
                    <div class="item-details"><code>#(user.username)</code></div>
                </td>
                <td class="item-status">
                    #if(course.isArchived):
                    #(user.role)
                    #else:
                    #extend("_role-select", user.roleSelect)
                    #endif
                </td>
                <td class="item-actions-td">
                    <div class="assignment-actions-cell">
                        <a href="/admin/users/#(user.id)" class="btn action-btn action-btn-icon"
                           title="Manage user" aria-label="Manage @#(user.username)">
                            <svg class="icon" aria-hidden="true"><use href="#i-pencil"/></svg>
                        </a>
                        <details class="ext-details row-menu">
                            <summary class="btn action-btn action-btn-icon ext-summary" title="More actions" aria-label="More actions for @#(user.username)">
                                <svg class="icon" aria-hidden="true"><use href="#i-more"/></svg>
                            </summary>
                            <div class="popover-panel row-menu-panel" role="menu">
                                <form method="post" action="/admin/courses/#(course.id)/unenroll/#(user.id)"
                                      data-confirm="Remove @#(user.username) from #(course.code)? They lose access immediately. Their submissions and grades are kept, and you can add them back from this page.">
                                    #csrfFormField()
                                    <button class="row-menu-item row-menu-item--danger" type="submit" role="menuitem">
                                        <svg class="icon" aria-hidden="true"><use href="#i-trash"/></svg>Remove from course
                                    </button>
                                </form>
                            </div>
                        </details>
                    </div>
                </td>
            </tr>
        #endfor
        </tbody>
    </table>
    #endif
</section>
#endif
#endexport
#endextend
