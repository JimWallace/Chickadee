            #for(worker in workers):
                <tr data-load="#(worker.assignedJobs)"
                    data-max-jobs="#(worker.maxConcurrentJobs)"#if(worker.isOffline): class="runner-row-offline"#endif>
                    <td class="item-tile-cell"><span class="item-tile"><svg class="icon" aria-hidden="true"><use href="#i-server"/></svg></span></td>
                    <td class="item-main" data-sort-value="#(worker.workerID)">
                        <div class="item-title"><a href="/admin/runners/#(worker.workerID)"><code>#(worker.workerID)</code></a></div>
                        <div class="item-details">#(worker.detailsText)</div>
                    </td>
                    <td class="item-status" data-sort-value="#(worker.assignedJobs)">
                        #if(worker.isOffline):
                        <span class="tier">Offline</span>
                        #elseif(worker.hasSlots):
                        <span class="pips" aria-hidden="true">#for(pip in worker.pips):<span class="pip" data-state="#(pip.state)"></span>#endfor</span>
                        <div class="item-details">#(worker.loadLabel)</div>
                        #else:
                        #(worker.loadLabel)
                        #endif
                    </td>
                    <td class="col-hide-phone" data-iso="#(worker.lastActive)">
                        <span class="js-relative-time" data-iso="#(worker.lastActive)">#(worker.lastActive)</span>
                        <div class="item-details">last active</div>
                    </td>
                    <td>
                        <a class="btn action-btn action-btn-icon" href="/admin/runners/#(worker.workerID)"
                           title="Open runner" aria-label="Open runner #(worker.workerID)">
                            <svg class="icon" aria-hidden="true"><use href="#i-eye"/></svg>
                        </a>
                    </td>
                </tr>
            #endfor
