#extend("base"):
#export("title"):
Users
#endexport
#export("content"):
<p class="admin-version-banner">Chickadee v#appVersion()</p>
#extend("_admin-tabs")
#extend("_avatar-sprite")
<section class="page-section">
    <div class="page-titlebar">
        <h2>People <span class="text-muted">#(userCount) users · #(adminCount) admins</span></h2>
    </div>
    <div class="toolbar toolbar--end section-gap">
        <span class="filter-group">
            <label class="filter-label" for="users-filter">Filter</label>
            <input id="users-filter" class="form-input filter-input" type="search"
                   placeholder="Filter by name, username or role…"
                   data-list-filter="users-table"
                   data-list-filter-empty="No users match this filter.">
        </span>
    </div>
    <table class="results-table section-items section-items--manage sortable-table" id="users-table"
           data-sort-initial="last-seen:desc" data-sort-tiebreak="name"
           data-poll-url="/admin/users-data?fragment=rows" data-poll-interval="5000">
        <colgroup>
            <col class="section-items-tile"><col><col class="section-items-status">
            <col class="section-items-seen col-hide-phone"><col class="section-items-actions">
        </colgroup>
        <thead>
            <tr>
                <th scope="col"><span class="visually-hidden">Person</span></th>
                <th data-sort-key="name" data-sort-type="text"><button class="sort-header" type="button">Name</button></th>
                <th data-sort-key="role" data-sort-type="text"><button class="sort-header" type="button">Role</button></th>
                <th class="col-hide-phone" data-sort-key="last-seen" data-sort-type="date"><button class="sort-header" type="button">Last seen</button></th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        #extend("_user-rows")
        </tbody>
    </table>
</section>
<script src="/list-filter.js?v=#appVersion()"></script>
<script src="/sortable-table.js?v=#appVersion()"></script>
<script src="/table-poll.js?v=#appVersion()"></script>
#endexport
#endextend
