#extend("base"):
#export("title"):
Users
#endexport
#export("content"):
<p class="admin-version-banner">Chickadee v#appVersion()</p>
#extend("_admin-tabs")
<section class="page-section">
    <div class="toolbar toolbar--end section-gap">
        <span class="filter-group">
            <label class="filter-label" for="users-filter">Filter</label>
            <input id="users-filter" class="form-input filter-input" type="search"
                   placeholder="Filter by name, username or role…"
                   style="--filter-width:280px"
                   data-list-filter="users-table">
        </span>
    </div>
    <div class="table-scroll"><table class="results-table sortable-table" id="users-table"
           data-sort-initial="last-seen:desc" data-sort-tiebreak="username"
           data-poll-url="/admin/users-data?fragment=rows" data-poll-interval="5000">
        <thead>
            <tr>
                <th data-sort-key="name" data-sort-type="text"><button class="sort-header" type="button">Name</button></th>
                <th data-sort-key="username" data-sort-type="text"><button class="sort-header" type="button">Username</button></th>
                <th data-sort-key="role" data-sort-type="text"><button class="sort-header" type="button">Role</button></th>
                <th class="time col-hide-phone" data-sort-key="last-seen" data-sort-type="date"><button class="sort-header" type="button">Last Seen</button></th>
                <th class="time col-hide-phone" data-sort-key="joined" data-sort-type="date"><button class="sort-header" type="button">Joined</button></th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        #extend("_user-rows")
        </tbody>
    </table></div>
</section>
<style>
.role-form {
    display: flex;
    gap: .4rem;
    align-items: center;
}
.role-select {
    padding: .25rem .5rem;
    font-size: var(--text-sm);
}
.user-actions {
    display: flex;
    align-items: center;
    gap: .35rem;
}
.user-delete-form {
    display: inline;
}
</style>
<script src="/relative-time.js?v=#appVersion()"></script>
<script src="/list-filter.js?v=#appVersion()"></script>
<script src="/sortable-table.js?v=#appVersion()"></script>
<script src="/table-poll.js?v=#appVersion()"></script>
#endexport
#endextend
