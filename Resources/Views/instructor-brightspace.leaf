#extend("base"):
#export("title"):
LEARN
#endexport
#export("content"):
#extend("_instructor-tabs")
#extend("_avatar-sprite")

#if(hasActiveCourse):
<div class="page-titlebar">
    <h2>LEARN #if(brightspaceSyncEnabled):#if(syncHealthy):<span class="tier tier-open">Connected</span>#else:<span class="tier tier-danger">Paused</span>#endif#endif</h2>
    <div class="assignment-actions-cell">
        #if(showLTIGradesLink):
        <a class="btn action-btn" href="/instructor/lti-grades">LMS grades</a>
        #endif
        #if(canSyncNow):
        <form method="post" action="/instructor/brightspace/sync-now" class="inline-form">
            #csrfFormField()
            <button class="btn btn-primary" type="submit"
                    title="Re-queue any failed grades and push every pending grade to LEARN now">Sync now</button>
        </form>
        #endif
    </div>
</div>
#if(usesLTIGrades):
<div class="flash flash-neutral" role="status">Grades for this course go to the LMS through the LTI grade service, not the Valence sync.</div>
#endif
#endif

#if(!brightspaceSyncEnabled):
#elseif(!hasActiveCourse):
<section class="page-section">
    <p class="empty">Select a course to manage its LEARN grade sync.</p>
</section>
#else:

#if(!syncHealthy):
<div class="form-error" role="status">
    Grade sync is paused: the LEARN account this course pushes as is disconnected.
    #if(usesServiceAccount):
    Ask a Chickadee admin.
    #else:
    It resumes when they reconnect, or a connected co-instructor takes over below.
    #endif
</div>
#endif

<!-- ── Facts: who the course pushes as, and where ─────────────── -->
<section class="card page-section">
    <div class="facts-actions">
        <button class="btn action-btn" type="button" id="bs-test-connection"
                title="Verify this course's grade-push credentials against D2L">Test connection</button>
        #if(canBindOrgUnit):
        <details class="ext-details row-menu">
            <summary class="btn action-btn action-btn-icon ext-summary" title="More actions" aria-label="More actions for the LEARN connection">
                <svg class="icon" aria-hidden="true"><use href="#i-more"/></svg>
            </summary>
            <div class="popover-panel row-menu-panel" role="menu">
                <form method="post" action="/instructor/brightspace/bind-org-unit" class="toolbar">
                    #csrfFormField()
                    <label class="field-inline">
                        LEARN org unit ID
                        <input class="form-input input-compact" type="text" id="bs-org-unit-input"
                               name="orgUnitID" value="#(orgUnitFieldValue)" autocomplete="off"
                               placeholder="e.g. 1106038">
                    </label>
                    <button class="row-menu-item" type="submit" role="menuitem"
                            title="Bind this course to its LEARN org unit (blank to clear)">
                        <svg class="icon" aria-hidden="true"><use href="#i-link"/></svg>Change org unit
                    </button>
                </form>
            </div>
        </details>
        #endif
    </div>
    <dl class="detail-grid">
        <dt>Pushes as</dt>
        <dd><strong>#(pushesAsText)</strong>#if(pushesAsNote != ""): <span class="card-meta">#(pushesAsNote)</span>#endif</dd>
        <dt>Org unit</dt>
        <dd>#if(courseLinked):<strong>#(orgUnitDisplay)</strong>#else:<span class="text-muted">Not linked</span>#endif</dd>
        <dt>Last sync</dt>
        <dd>#if(lastSyncISO):<strong class="js-relative-time" data-iso="#(lastSyncISO)">#(lastSyncText)</strong>#else:<strong>#(lastSyncText)</strong>#endif <span class="card-meta">Automatic</span></dd>
    </dl>
    <div class="bs-test-result" id="bs-test-result" hidden></div>
</section>

#if(!usesServiceAccount):
<!-- ── Per-instructor LEARN identity (#1114) ─────────────────────
     Shown only when the deployment has no service account. With one, grades
     always push through it and this whole block is hidden (not removed). -->
<section class="page-section">
    <h2>Connection</h2>
    #if(account.connected):
    <p class="bs-conn-line">Your LEARN account: <strong>#(account.identity)</strong>#(account.since)</p>
    #else:
    <p class="bs-conn-line">Your LEARN account is not connected.</p>
    #endif
    #if(syncIdentity.hasName):
    <p class="bs-conn-line">This course pushes grades as <strong>#(syncIdentity.name)</strong>.</p>
    #endif
    #if(showConnectForm):
    <form method="post" action="/instructor/brightspace/connect" class="toolbar">
        #csrfFormField()
        <label class="field-inline">
            Valence User ID
            <input class="form-input input-compact" type="text" id="bs-valence-user-id"
                   name="userID" autocomplete="off" required aria-describedby="bs-connect-note">
        </label>
        <label class="field-inline">
            Valence User Key
            <input class="form-input input-compact" type="password" id="bs-valence-user-key"
                   name="userKey" autocomplete="off" required aria-describedby="bs-connect-note">
        </label>
        <button class="btn btn-primary" type="submit">Connect my LEARN account</button>
    </form>
    <p class="field-note" id="bs-connect-note">
        Follow the
        <a href="https://github.com/JimWallace/Chickadee/blob/main/docs/brightspace-setup.md#per-instructor-identity" target="_blank" rel="noopener noreferrer">LEARN setup guide <svg class="icon" aria-hidden="true"><use href="#i-external"/></svg><span class="visually-hidden">(opens in a new tab)</span></a>
        to get a Valence User ID and User Key for your own account.
    </p>
    #endif
    #if(showIdentityActions):
    <div class="toolbar">
        #if(showUseMyIdentity):
        <form method="post" action="/instructor/brightspace/use-my-identity" class="inline-form">
            #csrfFormField()
            <button class="btn action-btn" type="submit"
                    title="Push this course's grades as your LEARN account">Use my account for this course</button>
        </form>
        #endif
        <form method="post" action="/instructor/brightspace/disconnect" class="inline-form"
              data-confirm="Disconnect your LEARN account? Courses that push grades as you will pause until someone reconnects.">
            #csrfFormField()
            <button class="btn action-btn action-danger" type="submit">Disconnect my account</button>
        </form>
        <a class="btn action-btn" href="/instructor/grades.csv">Export Grades CSV</a>
    </div>
    #else:
    <div class="toolbar">
        <a class="btn action-btn" href="/instructor/grades.csv">Export Grades CSV</a>
    </div>
    #endif
</section>
#endif

<!-- ── Assignment → grade-item mapping ────────────────────── -->
<section class="page-section">
    <div class="page-titlebar">
        <h2>Grade-item mapping</h2>
        #if(!courseIsArchived):
        <form method="post" action="/instructor/brightspace/auto-map" class="inline-form">
            #csrfFormField()
            <button class="btn action-btn" type="submit"
                    title="Map unmapped assignments to grade items with a matching name">Auto-map by name</button>
        </form>
        #endif
    </div>
    #if(!hasAssignments):
    <p class="empty">No assignments in this course yet.</p>
    #else:
    <datalist id="bs-grade-objects" data-do-not-sync-token="#(doNotSyncToken)"></datalist>
    <table class="results-table section-items section-items--manage">
        <colgroup>
            <col class="section-items-tile"><col><col class="section-items-combo">
            <col class="section-items-grade col-hide-phone"><col class="section-items-count">
        </colgroup>
        <thead class="visually-hidden">
            <tr>
                <th scope="col">Type</th><th scope="col">Assignment</th><th scope="col">LEARN assessment</th>
                <th scope="col" class="col-hide-phone">Students synced</th><th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
        #for(row in assignmentRows):
            <tr>
                <td class="item-tile-cell"><span class="item-tile" data-kind="graded"><svg class="icon" aria-hidden="true"><use href="#i-calendar-check"/></svg></span></td>
                <td class="item-main">
                    <div class="item-title">#(row.title)</div>
                    <div class="item-details#if(row.hasSyncError): chip-err#endif">#(row.syncDetailText)</div>
                </td>
                <td class="item-status">
                    <form method="post" action="/instructor/#(row.assignmentID)/brightspace"
                          class="bs-grade-form" data-assignment-id="#(row.assignmentID)">
                        #csrfFormField()
                        <input type="hidden" name="returnTo" value="brightspace">
                        <input type="hidden" name="gradeObjectID" class="js-bs-grade-id-hidden">
                        <label class="visually-hidden" for="bs-go-#(row.assignmentID)">LEARN Assessment for #(row.title)</label>
                        <span class="state-select" data-state="#if(row.isMapped):mapped#else:unmapped#endif">
                            <input class="form-input bs-grade-input" type="text"
                                   id="bs-go-#(row.assignmentID)" list="bs-grade-objects"
                                   value="#(row.gradeFieldValue)" placeholder="Search assessments…"
                                   data-raw-id="#(row.gradeFieldValue)" autocomplete="off">
                        </span>
                        <button class="btn action-btn" type="submit">Save</button>
                    </form>
                </td>
                <td class="item-grade col-hide-phone">
                    #if(row.hasSyncActivity):
                    <div><strong title="Synced to LEARN">#(row.syncedCount)</strong> synced</div>
                    <div class="item-details#if(row.hasErrored): chip-err#endif"><span title="Failed to push">#(row.erroredCount)</span> failed</div>
                    #else:
                    <span class="empty">—</span>
                    #endif
                </td>
                <td class="item-actions-td">
                    #if(!courseIsArchived):
                    <div class="assignment-actions-cell">
                        <form method="post" action="/instructor/#(row.assignmentID)/brightspace/push-all"
                              class="inline-form"
                              data-confirm="Re-push every student's best grade for #(row.title) to LEARN?">
                            #csrfFormField()
                            <button class="btn action-btn action-btn-icon" type="submit"
                                    title="Re-push all grades for #(row.title)"
                                    aria-label="Re-push all grades for #(row.title)">
                                <svg class="icon" aria-hidden="true"><use href="#i-push-down"/></svg>
                            </button>
                        </form>
                    </div>
                    #endif
                </td>
            </tr>
        #endfor
        </tbody>
    </table>
    #endif
</section>

<!-- ── Class Roster ────────────────────────────────────────── -->
<section class="page-section">
    <div class="page-titlebar">
        <h2>Class Roster</h2>
        #if(canReconcile):
        <form method="post" action="/instructor/brightspace/reconcile-now" class="inline-form">
            #csrfFormField()
            <button class="btn action-btn" type="submit"
                    title="Re-check the roster against the LEARN classlist now">Reconcile now</button>
        </form>
        #endif
    </div>
    #if(!courseLinked):
    <p class="section-note">
        Link this course to its LEARN org unit (the ⋯ menu in the card above) to check
        whether each student's grade can be delivered to the LEARN gradebook.
    </p>
    #endif
    #if(courseLinked):
    #if(hasUnreachable):
    <p class="section-note">#(readinessSummary)</p>
    <table class="results-table section-items section-items--manage">
        <colgroup>
            <col class="section-items-tile"><col><col class="section-items-actions">
        </colgroup>
        <thead class="visually-hidden">
            <tr><th scope="col">Person</th><th scope="col">Student</th><th scope="col">Actions</th></tr>
        </thead>
        <tbody>
        #for(student in unreachableStudents):
            <tr>
                <td class="item-tile-cell">#extend("_avatar", student.avatar)</td>
                <td class="item-main">
                    <div class="item-title">#(student.displayName)</div>
                    <div class="item-details"><code>#(student.username)</code> · <span class="chip-err" title="#(student.detail)">Couldn't match to LEARN</span></div>
                </td>
                <td class="item-actions-td">
                    <div class="assignment-actions-cell">
                        <a class="btn action-btn action-btn-icon" href="/instructor/students?highlight=#(student.userID)"
                           title="Match this student's LEARN ID" aria-label="Match #(student.displayName)'s LEARN ID">
                            <svg class="icon" aria-hidden="true"><use href="#i-link"/></svg>
                        </a>
                        <details class="ext-details row-menu">
                            <summary class="btn action-btn action-btn-icon ext-summary" title="More actions" aria-label="More actions for #(student.displayName)">
                                <svg class="icon" aria-hidden="true"><use href="#i-more"/></svg>
                            </summary>
                            <div class="popover-panel row-menu-panel" role="menu">
                                <form method="post" action="#(student.unenrollURL)"
                                      data-confirm="Remove #(student.displayName) from this course?">
                                    #csrfFormField()
                                    <button class="row-menu-item row-menu-item--danger" type="submit" role="menuitem">
                                        <svg class="icon" aria-hidden="true"><use href="#i-trash"/></svg>Remove from course
                                    </button>
                                </form>
                            </div>
                        </details>
                    </div>
                </td>
            </tr>
        #endfor
        </tbody>
    </table>
    #else:
    <p class="empty">All students can receive grades in LEARN.</p>
    #endif
    #endif
</section>
#endif

<style>
.bs-grade-form { display: flex; gap: .4rem; align-items: center; margin: 0; }
.bs-grade-input { font-size: var(--text-base); }
.bs-conn-line { margin: 0 0 .45rem; }
.bs-test-result { margin: 0; padding: 0 1.25rem 1rem; font-size: var(--text-base); }
</style>
<!-- Connection test + grade-item pickers are wired by
     Public/instructor-brightspace.js; the reserved do-not-sync token
     rides on the datalist above. -->
<script src="/instructor-brightspace.js?v=#appVersion()"></script>
#endexport
#endextend
