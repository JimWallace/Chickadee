#extend("base"):
#export("title"):
AI agents
#endexport
#export("content"):
#extend("_instructor-tabs")

#if(!hasActiveCourse):
<section class="page-section">
    <p class="empty">Select a course to manage its authoring voice.</p>
</section>
#else:

<section class="page-section">
    <div class="page-titlebar">
        <h2>Agent access</h2>
        <a class="btn action-btn" href="/agents">Connected agents</a>
    </div>
    <p class="section-intro">What an agent that course staff connect can reach in #(courseCode).</p>
    <dl class="detail-grid">
        <dt>Course content</dt>
        <dd>#if(agentAccess.contentOn):<span class="tier tier-open">On</span>#else:<span class="tier tier-closed">Off</span>#endif</dd>
        <dt>Feedback on written answers</dt>
        <dd>#if(agentAccess.feedbackOn):<span class="tier tier-open">On</span>#else:<span class="tier tier-closed">Off</span>#endif</dd>
    </dl>
    #if(agentAccess.feedbackOn):
    #if(count(agentAccess.feedbackAssignments) == 0):
    <p class="empty">No assignment has AI-assisted feedback on yet.</p>
    #else:
    <table class="results-table">
        <thead>
            <tr>
                <th>Assignment</th>
                <th>Drafts to review</th>
            </tr>
        </thead>
        <tbody>
        #for(row in agentAccess.feedbackAssignments):
            <tr>
                <td><a href="#(row.reviewURL)">#(row.title)</a></td>
                <td>#(row.draftCount)</td>
            </tr>
        #endfor
        </tbody>
    </table>
    #endif
    #if(agentAccess.attestedAtISO):
    <form method="post" action="/instructor/mcp/attestation" class="form-stack">
        #csrfFormField()
        <input type="hidden" name="action" value="withdraw">
        <p class="field-note">You recorded <span class="js-relative-time" data-iso="#(agentAccess.attestedAtISO)">#(agentAccess.attestedAtISO)</span> that you connect only your UW-licensed AI account for feedback.</p>
        <div class="toolbar"><button class="btn action-btn" type="submit">Withdraw</button></div>
    </form>
    #elseif(agentAccess.canAttest):
    <form method="post" action="/instructor/mcp/attestation" class="form-stack">
        #csrfFormField()
        <input type="hidden" name="action" value="record">
        <p class="field-note">Connect only your UW-licensed AI account for feedback; a personal account is approved for public data only. <a href="https://github.com/JimWallace/Chickadee/blob/main/docs/ai-assisted-feedback.md#the-ai-agents-tab" target="_blank" rel="noopener noreferrer">Why <svg class="icon" aria-hidden="true"><use href="#i-external"/></svg><span class="visually-hidden">(opens in a new tab)</span></a></p>
        <div class="toolbar"><button class="btn btn-primary" type="submit">I connect only my UW-licensed AI account</button></div>
    </form>
    #endif
    #endif
</section>

<section class="page-section">
    <div class="page-titlebar">
        <h2>Authoring voice #if(isCustomized):<span class="tier tier-open">Customized</span>#else:<span class="tier tier-closed">Default</span>#endif</h2>
        #if(canEdit):
        <div class="toolbar">
            <button class="btn btn-primary" type="submit" form="mcp-guide">Save</button>
            #if(showResetButton):
            <details class="add-section-details popup-anchor">
                <summary class="btn action-btn action-btn-icon summary-btn" title="More actions" aria-label="More actions for the authoring voice">
                    <svg class="icon" aria-hidden="true"><use href="#i-more"/></svg>
                </summary>
                <div class="add-section-popup card suite-section-popup row-menu-panel" role="menu">
                    <button class="row-menu-item" type="submit" form="mcp-guide" name="action" value="reset" role="menuitem">Reset to Chickadee default</button>
                </div>
            </details>
            #endif
        </div>
        #endif
    </div>
    <p class="section-intro">What connected agents follow when they write assignment prose for #(courseCode).</p>

    <div class="editor-split">
        <form method="post" action="/instructor/mcp" id="mcp-guide" class="form-stack">
            #csrfFormField()
            <label class="form-label">
                Guide text
                <textarea class="form-input textarea-mono" name="instructions" rows="24"
                          maxlength="#(maxLength)"#if(!canEdit): disabled#endif>#(guidanceText)</textarea>
                <span class="field-note field-note--muted">Plain text; an empty box restores the Chickadee default.</span>
            </label>
        </form>
        <aside class="card">
            <dl class="detail-grid">
                <dt>Source</dt>
                <dd>#(sourceNote)</dd>
                <dt>MCP server</dt>
                <dd>#if(mcpDisabled):<span class="tier tier-closed">Disabled</span>#else:<span class="tier tier-open">Enabled</span>#endif</dd>
                <dt>Length</dt>
                <dd>#(guidanceLength) / #(maxLength)</dd>
            </dl>
            #if(mcpDisabled):
            <p class="section-note">The MCP server is disabled on this deployment, so no agent can connect yet.</p>
            #endif
            #if(readOnlyNote):
            <p class="section-note">#(readOnlyNote)</p>
            #endif
        </aside>
    </div>
</section>

#endif
#endexport
#endextend
