#extend("base"):
#export("title"):
GitHub
#endexport
#export("content"):
<p class="admin-version-banner">Chickadee v#appVersion()</p>
#extend("_admin-tabs")
<section class="page-section">
    <p class="page-crumb">Integrations</p>
    <div class="page-titlebar">
        <h2>GitHub App #if(app):#if(secretsUnavailable):<span class="tier tier-danger">Unavailable</span>#else:<span class="tier tier-open">Registered</span>#endif#else:<span class="tier tier-closed">Not registered</span>#endif</h2>
        #if(app):
        <div class="toolbar">
            <a class="btn action-btn" href="#(app.htmlURL)" target="_blank" rel="noopener noreferrer">Open on GitHub <svg class="icon" aria-hidden="true"><use href="#i-external"/></svg></a>
            <details class="add-section-details popup-anchor">
                <summary class="btn action-btn action-btn-icon summary-btn" title="More actions" aria-label="More actions for the GitHub App">
                    <svg class="icon" aria-hidden="true"><use href="#i-more"/></svg>
                </summary>
                <div class="add-section-popup card suite-section-popup row-menu-panel" role="menu">
                    <form method="post" action="/admin/github/delete"
                          data-confirm="Remove the GitHub App registration? Chickadee deletes the App credentials from this server and cannot restore them.">
                        #csrfFormField()
                        <button class="row-menu-item row-menu-item--danger" type="submit" role="menuitem">
                            <svg class="icon" aria-hidden="true"><use href="#i-trash"/></svg>
                            <span>Remove registration<br><span class="card-meta">Deletes credentials here, not the App on GitHub</span></span>
                        </button>
                    </form>
                </div>
            </details>
        </div>
        #endif
    </div>
    #if(app):
    <p class="section-intro">Chickadee reads student repositories through this App.</p>
    #if(secretsUnavailable):
    <div class="flash flash-warning" role="status">
        <strong>Secrets file #if(secretsMissing):missing#else:unreadable#endif.</strong> GitHub submission and webhooks are off until <code>#(secretsPath)</code> is restored, or the App is removed and registered again.
    </div>
    #endif
    <div class="card section-gap">
        <dl class="detail-grid detail-grid--cells">
            <div><dt>Name</dt>
            <dd>#(app.name)</dd></div>
            <div><dt>App ID</dt>
            <dd><code>#(app.appID)</code></dd></div>
            <div><dt>Client ID</dt>
            <dd><code>#(app.clientID)</code></dd></div>
            #if(app.owner):
            <div><dt>Owner</dt>
            <dd>#(app.owner)</dd></div>
            #endif
        </dl>
    </div>
    #else:
    <p class="empty">No GitHub App registered.</p>
    <p class="section-note">GitHub submission is off until an App is registered, which must wait for the privacy review.</p>
    #if(!baseURLConfigured):
    <div class="flash flash-warning" role="status">
        <code>PUBLIC_BASE_URL</code> is not set, so GitHub cannot return to this server. Set it and restart the server.
    </div>
    #endif
    #if(creation):
    <form method="post" action="#(creation.actionURL)" class="form-stack section-gap">
        <input type="hidden" name="manifest" value="#(creation.manifestJSON)">
        <p class="field-note">GitHub creates the App on #(creation.ownerLabel), then returns its credentials to this server.</p>
        <div class="toolbar toolbar--end">
            <button class="btn btn-primary" type="submit">Create App on GitHub</button>
        </div>
    </form>
    <details class="test-output-details"#if(organizationOpen): open#endif>
        <summary>Owner and permissions</summary>
        <form method="get" action="/admin/github" class="form-stack">
            <div class="field-stack">
                <label for="github-org">Organization</label>
                <input id="github-org" class="form-input" type="text" name="org"
                       value="#(organization)" placeholder="uwaterloo-cs">
            </div>
            <label class="form-label">
                <input type="checkbox" name="courseRepositories"#if(courseRepositories): checked#endif>
                Allow course repositories
            </label>
            <p class="field-note text-muted">Adds write access to repository administration and read access to organization members.</p>
            <label class="form-label">
                <input type="checkbox" name="pushEvents"#if(pushEvents): checked#endif>
                Receive push events
            </label>
            <p class="field-note text-muted">Shows staff the last push to each course repository.</p>
            <label class="form-label">
                <input type="checkbox" name="commitStatuses"#if(commitStatuses): checked#endif>
                Post commit statuses
            </label>
            <p class="field-note text-muted">Adds write access to commit statuses, so an assignment can post its public-test count.</p>
            <div class="toolbar toolbar--end">
                <button class="btn" type="submit">Apply</button>
            </div>
        </form>
    </details>
    #endif
    #endif
</section>
#endexport
#endextend
