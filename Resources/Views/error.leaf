#extend("base"):
#export("title"):
#(title)
#endexport
#export("content"):
<div class="error-page">
    <img class="error-bird" src="/images/chickadee-icon-alt.png" alt="">
    <div class="error-code">#(status)</div>
    <h1 class="error-title">#(title)</h1>
    <p class="error-message">#(message)</p>
    <a href="/" class="btn">Go home</a>
</div>
<style>
.error-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 5rem 1.5rem;
    gap: 1rem;
}
.error-bird {
    width: 5.5rem;
    height: 5.5rem;
    border-radius: 50%;
    opacity: .8;
    margin-bottom: .25rem;
}
.error-code {
    font-size: 5em;  /* display glyph — 5x body size */
    font-weight: 700;
    line-height: 1;
    /* gray-500, not lighter: the glyph is text to axe, and gray-300 on the
       page background fails even the large-text contrast threshold. */
    color: var(--gray-500);
    letter-spacing: -.05em;
}
.error-title {
    margin: 0;
    font-size: var(--text-2xl);
}
</style>
#endexport
#endextend
