#extend("base"):
#export("title"):
Admin
#endexport
#export("content"):
<p class="admin-version-banner">Chickadee v#appVersion()</p>
#extend("_admin-tabs")
<section class="diagnostics-section">
    <div class="diagnostics-cards" id="diagnostics-cards">
        <div class="diagnostic-card diagnostic-card-cyclable" data-activity-card
                 role="button" tabindex="0" aria-label="Active users, last 24 hours. Press to change the time window.">
            <div class="diagnostic-label"><span class="diagnostic-window-chip" id="activity-card-window">24h</span> Active Users</div>
            <div class="diagnostic-value" id="activity-card-value">—</div>
            <div class="diagnostic-spark" id="activity-card-spark" aria-hidden="true">
            #for(bucket in activityChart.buckets):
                <div class="spark-slot" data-count="#(bucket.count)" data-label="#(bucket.label)"><span class="spark-fill"></span></div>
            #endfor
            </div>
        </div>
        <div class="diagnostic-card diagnostic-card-cyclable" data-card="jobsProcessed"
                 role="button" tabindex="0" aria-label="Jobs processed, last 24 hours. Press to change time window.">
            <div class="diagnostic-label"><span class="diagnostic-window-chip">24h</span> Jobs Processed</div>
            <div class="diagnostic-value" id="diag-jobs-processed">—</div>
            <div class="diagnostic-spark" aria-hidden="true"></div>
        </div>
        <div class="diagnostic-card diagnostic-card-cyclable" data-card="load"
                 role="button" tabindex="0" aria-label="Max load, last 24 hours. Press to change time window.">
            <div class="diagnostic-label"><span class="diagnostic-window-chip">24h</span> Max Load</div>
            <div class="diagnostic-value" id="diag-max-load">—</div>
            <div class="diagnostic-spark" aria-hidden="true"></div>
        </div>
        <div class="diagnostic-card diagnostic-card-cyclable" data-card="queueWaitP95Ms"
                 role="button" tabindex="0" aria-label="P95 wait time, last 24 hours. Press to change time window.">
            <div class="diagnostic-label"><span class="diagnostic-window-chip">24h</span> P95 Wait Time</div>
            <div class="diagnostic-value" id="diag-queue-p95">—</div>
            <div class="diagnostic-spark" aria-hidden="true"></div>
        </div>
    </div>
</section>

<section class="page-section">
    <h2>Runners</h2>

    <div class="table-scroll"><table id="workers-table" class="results-table sortable-table"
            data-sort-initial="runner:asc" data-sort-tiebreak="runner"
            data-poll-url="/admin/runners?fragment=rows" data-poll-interval="5000">
            <thead>
                <!-- Phone keeps the three columns that answer "is it up and is
                     it coping": runner, load, last heartbeat. Version and job
                     count fold into the name cell as .row-phone-meta; the two
                     averages are trend figures, and trends are desk work. -->
                <tr>
                    <th data-sort-key="runner" data-sort-type="text"><button class="sort-header" type="button">Runner</button></th>
                    <th class="col-hide-phone" data-sort-key="version" data-sort-type="text"><button class="sort-header" type="button">Version</button></th>
                    <th class="time" data-sort-key="load" data-sort-type="number"><button class="sort-header" type="button">Load</button></th>
                    <th class="time col-hide-phone" data-sort-key="jobs-processed" data-sort-type="number"><button class="sort-header" type="button">Jobs Processed</button></th>
                    <th class="time col-hide-tablet" data-sort-key="avg-run" data-sort-type="duration"><button class="sort-header" type="button">Avg Run</button></th>
                    <th class="time col-hide-tablet" data-sort-key="avg-wait" data-sort-type="duration"><button class="sort-header" type="button">Avg Wait</button></th>
                    <th class="time" data-sort-key="last-active" data-sort-type="date"><button class="sort-header" type="button">Last Active</button></th>
                </tr>
            </thead>
            <tbody id="workers-body">
            #extend("_worker-rows")
            </tbody>
        </table></div>
</section>

<!-- The worker secret is a setting, so it reads as one: a label, a note saying
     what saving does, and the button beside the field it saves. It used to sit
     unlabelled in the Runners heading row, with a placeholder standing in for
     the label and no statement of the consequence. -->
<section class="page-section">
    <h2>Worker shared secret</h2>
    <form method="post" action="/admin/runner-secret" class="form-stack">
        #csrfFormField()
        <div class="field-stack">
            <label for="worker-secret">Secret</label>
            <input id="worker-secret"
                   class="form-input"
                   type="text"
                   name="secret"
                   value="#(workerSecret)"
                   autocomplete="new-password"
                   spellcheck="false">
            <p class="field-note">Runners re-authenticate on their next heartbeat. Changing this drops any runner still using the old value.</p>
        </div>
        <div class="toolbar toolbar--end">
            <button class="btn btn-primary" type="submit">Save secret</button>
        </div>
    </form>
</section>

<!-- ── Courses ────────────────────────────────────────── -->
<section class="page-section">
    <div class="page-titlebar admin-courses-head">
        <h2>Courses</h2>
        <div class="admin-courses-actions">
            <a href="/admin/courses/new" class="btn">Create course</a>
            <button class="btn btn-primary" type="button" id="importCourseBtn">Import course</button>
        </div>
    </div>

    <!-- Hidden import form — triggered by the button above -->
    <form method="post" action="/admin/courses/import" enctype="multipart/form-data"
          id="importCourseForm">
        #csrfFormField()
        <input type="file" name="file" accept=".zip" id="importCourseFile" hidden>
    </form>

    #if(count(courses) == 0):
    <p class="empty">No courses yet.</p>
    #else:
    <div class="table-scroll"><table class="results-table sortable-table" id="courses-table"
        data-sort-initial="code:asc" data-sort-tiebreak="code">
        <thead>
            <tr>
                <th data-sort-key="code" data-sort-type="text"><button class="sort-header" type="button">Code</button></th>
                <th data-sort-key="name" data-sort-type="text"><button class="sort-header" type="button">Name</button></th>
                <th data-sort-key="students" data-sort-type="number"><button class="sort-header" type="button">Students</button></th>
                <!-- Phone: the submission total is scale you read at a desk;
                     the enrolment count is the one an archive decision needs. -->
                <th class="col-hide-phone" data-sort-key="submissions" data-sort-type="number"><button class="sort-header" type="button">Submissions</button></th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        #for(course in courses):
            <tr class="status-open">
                <td><a href="/admin/courses/#(course.id)"><strong>#(course.code)</strong></a></td>
                <td>#(course.name)</td>
                <td>#(course.enrollmentCount)</td>
                <td class="col-hide-phone">#(course.submissionCount)</td>
                <td class="action-cell">
                    <form method="post" action="/admin/courses/#(course.id)/copy" class="inline-form">
                        #csrfFormField()
                        <button class="btn action-btn action-btn-icon" type="submit"
                                title="Copy course" aria-label="Copy course"
                                data-confirm="Copy #(course.code)? Its assignments and test suites are duplicated into a new course. The original is unchanged and the copy starts with no students enrolled.">
                            <svg class="icon" aria-hidden="true"><use href="#i-copy"/></svg>
                        </button>
                    </form>
                    <form method="post" action="/admin/courses/#(course.id)/archive" class="inline-form">
                        #csrfFormField()
                        <button class="btn action-btn action-btn-icon action-danger" type="submit"
                                title="Archive course" aria-label="Archive course"
                                data-confirm="Archive #(course.code)? #(course.enrollmentCount) students lose access immediately. Submissions, grades and audit records are kept, and you can un-archive from the course page.">
                            <svg class="icon" aria-hidden="true"><use href="#i-archive"/></svg>
                        </button>
                    </form>
                </td>
            </tr>
        #endfor
        </tbody>
    </table></div>
    #endif

</section>

<style>
/* Clickable diagnostic-card + sparkline styles are global (styles.css),
   shared with the instructor dashboard. */
.worker-host {
    font-size: .8em;
    color: var(--muted);
}
.runner-load-busy {
    font-weight: 600;
}
.admin-courses-head {
    gap: 0;
    flex-wrap: nowrap;
}
.admin-courses-actions {
    display: flex;
    gap: .5rem;
}
.action-cell {
    display: flex;
    gap: .4rem;
    flex-wrap: wrap;
    align-items: center;
}
tr.runner-row-offline {
    opacity: .5;
}
</style>
<script src="/sortable-table.js?v=#appVersion()"></script>
<script src="/table-poll.js?v=#appVersion()"></script>
<!-- Load summary, diagnostic cards, the Active Users card and the
     import-course picker are wired by Public/admin-dashboard.js. -->
<script src="/admin-dashboard.js?v=#appVersion()"></script>
#endexport
#endextend
