#extend("base"):
#export("title"):
Admin
#endexport
#export("content"):
<p class="admin-version-banner">Chickadee v#appVersion()</p>
#extend("_admin-tabs")
<section class="diagnostics-section">
    <div class="diagnostics-cards" id="diagnostics-cards">
        <div class="diagnostic-card diagnostic-card-cyclable" data-activity-card
                 role="button" tabindex="0" aria-label="Active users, last 24 hours. Press to change the time window.">
            <div class="diagnostic-label"><span class="diagnostic-window-chip" id="activity-card-window">24h</span> Active Users</div>
            <div class="diagnostic-value" id="activity-card-value">—</div>
            <div class="diagnostic-spark" id="activity-card-spark" aria-hidden="true">
            #for(bucket in activityChart.buckets):
                <div class="spark-slot" data-count="#(bucket.count)" data-label="#(bucket.label)"><span class="spark-fill"></span></div>
            #endfor
            </div>
        </div>
        <div class="diagnostic-card diagnostic-card-cyclable" data-card="jobsProcessed"
                 role="button" tabindex="0" aria-label="Jobs processed, last 24 hours. Press to change time window.">
            <div class="diagnostic-label"><span class="diagnostic-window-chip">24h</span> Jobs Processed</div>
            <div class="diagnostic-value" id="diag-jobs-processed">—</div>
            <div class="diagnostic-spark" aria-hidden="true"></div>
        </div>
        <div class="diagnostic-card diagnostic-card-cyclable" data-card="load"
                 role="button" tabindex="0" aria-label="Max load, last 24 hours. Press to change time window.">
            <div class="diagnostic-label"><span class="diagnostic-window-chip">24h</span> Max Load</div>
            <div class="diagnostic-value" id="diag-max-load">—</div>
            <div class="diagnostic-spark" aria-hidden="true"></div>
        </div>
        <div class="diagnostic-card diagnostic-card-cyclable" data-card="queueWaitP95Ms"
                 role="button" tabindex="0" aria-label="P95 wait time, last 24 hours. Press to change time window.">
            <div class="diagnostic-label"><span class="diagnostic-window-chip">24h</span> P95 Wait Time</div>
            <div class="diagnostic-value" id="diag-queue-p95">—</div>
            <div class="diagnostic-spark" aria-hidden="true"></div>
        </div>
    </div>
</section>

<section class="page-section">
    <h2>Runners</h2>

    <table id="workers-table" class="results-table section-items section-items--manage sortable-table"
           data-sort-initial="runner:asc" data-sort-tiebreak="runner"
           data-poll-url="/admin/runners?fragment=rows" data-poll-interval="5000">
        <colgroup>
            <col class="section-items-tile"><col><col class="section-items-status">
            <col class="section-items-seen col-hide-phone"><col class="section-items-count">
        </colgroup>
        <thead>
            <tr>
                <th scope="col"><span class="visually-hidden">Runner</span></th>
                <th data-sort-key="runner" data-sort-type="text"><button class="sort-header" type="button">Runner</button></th>
                <th data-sort-key="load" data-sort-type="number"><button class="sort-header" type="button">Load</button></th>
                <th class="col-hide-phone" data-sort-key="last-active" data-sort-type="date"><button class="sort-header" type="button">Last active</button></th>
                <th scope="col"><span class="visually-hidden">Open</span></th>
            </tr>
        </thead>
        <tbody id="workers-body">
        #extend("_worker-rows")
        </tbody>
    </table>
</section>

<!-- ── Courses ────────────────────────────────────────── -->
<section class="page-section">
    <div class="page-titlebar">
        <h2>Courses <span class="text-muted">#count(courses) active</span></h2>
        <details class="add-section-details popup-anchor">
            <summary class="btn action-btn summary-btn">+ Add <svg class="icon" aria-hidden="true"><use href="#i-chevron-down"/></svg></summary>
            <div class="add-section-popup card suite-section-popup row-menu-panel" role="menu">
                <a class="row-menu-item" href="/admin/courses/new" role="menuitem">
                    <span class="item-tile" data-kind="notebook"><svg class="icon" aria-hidden="true"><use href="#i-plus"/></svg></span>
                    <span>Create course<br><span class="card-meta">A new offering in a term</span></span>
                </a>
                <button class="row-menu-item" type="button" id="importCourseBtn" role="menuitem">
                    <span class="item-tile" data-kind="document"><svg class="icon" aria-hidden="true"><use href="#i-upload"/></svg></span>
                    <span>Import course bundle<br><span class="card-meta">From a .zip exported here</span></span>
                </button>
            </div>
        </details>
    </div>

    <!-- Hidden import form — triggered by the menu item above -->
    <form method="post" action="/admin/courses/import" enctype="multipart/form-data"
          id="importCourseForm">
        #csrfFormField()
        <input type="file" name="file" accept=".zip" id="importCourseFile" hidden>
    </form>

    #if(count(courses) == 0):
    <p class="empty">No courses yet.</p>
    #else:
    #if(showCourseFilter):
    <div class="toolbar toolbar--end section-gap">
        <span class="filter-group">
            <label class="filter-label" for="courses-filter">Filter</label>
            <input id="courses-filter" class="form-input filter-input" type="search"
                   placeholder="Filter by code or name…"
                   data-list-filter="courses-table"
                   data-list-filter-empty="No courses match this filter.">
        </span>
    </div>
    #endif
    <table class="results-table section-items section-items--manage" id="courses-table">
        <colgroup>
            <col class="section-items-tile"><col><col class="section-items-count"><col class="section-items-count">
        </colgroup>
        <thead class="visually-hidden">
            <tr>
                <th scope="col">Course</th>
                <th scope="col">Name</th>
                <th scope="col">Students</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
        #for(course in courses):
            <tr>
                <td class="item-tile-cell"><span class="item-tile" data-kind="notebook"><svg class="icon" aria-hidden="true"><use href="#i-layers"/></svg></span></td>
                <td class="item-main">
                    <div class="item-title"><a href="/admin/courses/#(course.id)">#(course.code) — #(course.name)</a></div>
                    <div class="item-details">#if(course.termLabel):#(course.termLabel) · #endif#(course.submissionCount) submissions</div>
                </td>
                <td class="item-status item-grade"><strong>#(course.enrollmentCount)</strong><div class="item-details">students</div></td>
                <td class="item-actions-td">
                    <div class="assignment-actions-cell">
                        <a class="btn action-btn action-btn-icon" href="/admin/courses/#(course.id)#clone-course"
                           title="Clone course" aria-label="Clone course">
                            <svg class="icon" aria-hidden="true"><use href="#i-copy"/></svg>
                        </a>
                        <details class="ext-details row-menu">
                            <summary class="btn action-btn action-btn-icon ext-summary" title="More actions" aria-label="More actions for #(course.code)">
                                <svg class="icon" aria-hidden="true"><use href="#i-more"/></svg>
                            </summary>
                            <div class="popover-panel row-menu-panel" role="menu">
                                <a class="row-menu-item" href="/admin/courses/#(course.id)/export" role="menuitem">
                                    <svg class="icon" aria-hidden="true"><use href="#i-download"/></svg>Export course bundle
                                </a>
                                <form method="post" action="/admin/courses/#(course.id)/archive"
                                      data-confirm="Archive #(course.code)? #(course.enrollmentCount) students lose access immediately. Submissions, grades and audit records are kept, and Unarchive on the course page puts it back.">
                                    #csrfFormField()
                                    <button class="row-menu-item row-menu-item--danger" type="submit" role="menuitem">
                                        <svg class="icon" aria-hidden="true"><use href="#i-archive"/></svg>Archive course
                                    </button>
                                </form>
                            </div>
                        </details>
                    </div>
                </td>
            </tr>
        #endfor
        </tbody>
    </table>
    #endif

</section>

<style>
/* Clickable diagnostic-card + sparkline styles are global (styles.css),
   shared with the instructor dashboard. */
tr.runner-row-offline {
    opacity: .5;
}
</style>
<script src="/sortable-table.js?v=#appVersion()"></script>
<script src="/list-filter.js?v=#appVersion()"></script>
<script src="/table-poll.js?v=#appVersion()"></script>
<!-- Load summary, diagnostic cards, the Active Users card and the
     import-course picker are wired by Public/admin-dashboard.js. -->
<script src="/admin-dashboard.js?v=#appVersion()"></script>
#endexport
#endextend
