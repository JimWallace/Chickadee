    #for(student in enrolledStudents):
        <tr class="student-row-link#if(student.isPending): student-row-pending#endif"
            data-student-id="#(student.id)"
            #if(!student.isPending):data-href="#(student.submissionsURL)"#endif>
            <td class="item-tile-cell">
                #if(student.hasAvatar):
                #extend("_avatar", student.avatar)
                #else:
                <span class="item-tile"><svg class="icon" aria-hidden="true"><use href="#i-calendar"/></svg></span>
                #endif
            </td>
            <td data-sort-value="#(student.displayName)">
                #if(student.isPending):
                <div class="item-title text-muted"><em>#(student.displayName)</em></div>
                <div class="item-details">#(student.pendingNote)</div>
                #else:
                <div class="item-title"><a href="#(student.submissionsURL)">#(student.displayName)</a>#if(student.learnFlag): <span class="learn-flag" title="Not on the LEARN classlist: remove if confirmed dropped">#(student.learnFlag)</span>#endif</div>
                <div class="item-details"><code>#(student.username)</code></div>
                #endif
            </td>
            <td>
                #if(student.isPending):
                <span class="tier tier-preview">Pending</span>
                #elseif(rosterReadOnly):
                #(student.role)
                #else:
                <form method="post" action="/courses/#(currentUser.activeCourse.id)/role/#(student.id)"
                      class="inline-form form-flush">
                    #csrfFormField()
                    <label class="visually-hidden" for="role-#(student.id)">Role for #(student.displayName)</label>
                    <span class="state-select" data-state="#(student.role)">
                        <select id="role-#(student.id)" name="role" class="form-input" data-ck-submit-on-change>
                            <option value="student"#if(student.role == "student"): selected#endif>Student</option>
                            <option value="ta"#if(student.role == "ta"): selected#endif>TA</option>
                            <option value="instructor"#if(student.role == "instructor"): selected#endif>Instructor</option>
                        </select>
                    </span>
                </form>
                #endif
            </td>
            <td class="col-hide-phone js-relative-time"
                #if(student.lastSeenAtISO):data-iso="#(student.lastSeenAtISO)"#endif>
                #(student.lastSeenAtText)
            </td>
            <td>
                #if(!rosterReadOnly):
                <div class="assignment-actions-cell">
                    #if(student.isPending):
                    <details class="ext-details form-flush">
                        <summary class="btn action-btn ext-summary" title="Register this student now"
                                 aria-label="Register pending student">Register</summary>
                        <form method="post" action="#(student.registerURL)" class="ext-panel">
                            #csrfFormField()
                            <p class="section-note">Materialize <code>#(student.username)</code> into a real account now (for grade-sync testing). They appear on assignment rosters immediately; their real login adopts this account.</p>
                            <label class="ext-field-label">
                                Display name
                                <input type="text" name="displayName" placeholder="#(student.username)" class="ext-field-input">
                            </label>
                            <label class="ext-field-label">
                                Student number (optional)
                                <input type="text" name="studentID" class="ext-field-input">
                            </label>
                            <label class="ext-field-label">
                                Email (optional)
                                <input type="email" name="email" class="ext-field-input">
                            </label>
                            <label class="ext-field-label">
                                SSO subject (optional)
                                <input type="text" name="externalSubject" placeholder="leave blank to adopt by username" class="ext-field-input">
                            </label>
                            <div class="ext-panel-actions">
                                <button class="btn action-btn" type="submit">Register</button>
                            </div>
                        </form>
                    </details>
                    #else:
                    <a class="btn action-btn action-btn-icon" href="#(student.submissionsURL)"
                       title="View #(student.displayName)'s submissions" aria-label="View #(student.displayName)'s submissions">
                        <svg class="icon" aria-hidden="true"><use href="#i-eye"/></svg>
                    </a>
                    #endif
                    <details class="ext-details row-menu">
                        <summary class="btn action-btn action-btn-icon ext-summary" title="More actions" aria-label="More actions for #(student.displayName)">
                            <svg class="icon" aria-hidden="true"><use href="#i-more"/></svg>
                        </summary>
                        <div class="popover-panel row-menu-panel" role="menu">
                            <form method="post" action="#(student.unenrollURL)" data-confirm="Remove @#(student.username) from this course?">
                                #csrfFormField()
                                <button class="row-menu-item row-menu-item--danger" type="submit" role="menuitem">
                                    <svg class="icon" aria-hidden="true"><use href="#i-trash"/></svg>Remove from course
                                </button>
                            </form>
                        </div>
                    </details>
                </div>
                #endif
            </td>
        </tr>
    #endfor
