<!-- Everything on the leaderboard that MOVES, rendered inline by
     leaderboard.leaf and again as its background refresh. The page's fixed
     chrome stays there, not here. Why: docs/class-activities.md, "Live-session
     controls (slice 8)". -->
    #if(hasWindow):
    <div class="chip-row">
        <span class="chip">#(window.label) <span class="js-relative-time" data-iso="#(window.boundaryISO)">#(window.boundaryText)</span></span>
    </div>
    #endif
    #if(showsMetricBoard):
    #if(hasYou):
    <section class="you-card card" aria-label="Your standing">
        #extend("_avatar", you.avatar)
        <div class="you-card-who">
            <div class="you-card-name">
                #if(you.hasHandle):<span data-avatar-handle>#(you.handle)</span> #endif<span class="you-pill">You</span>
            </div>
            #if(you.isRanked):
            <div class="you-card-rank">#(you.rankHeadline) <small>#(you.ofText)</small></div>
            #else:
            <div class="you-card-rank">#(you.rankHeadline)</div>
            <p class="section-note"><a href="#(you.submitURL)">Submit to get on the board.</a></p>
            #endif
            #if(you.hasHandle):
            <p class="section-note">#(you.privacyLine)</p>
            #endif
        </div>
        #if(you.isRanked):
        <dl class="you-card-stats">
            <dt>Your best</dt>
            <dd>#(you.bestText) <span class="text-muted">· <span class="js-relative-time" data-iso="#(you.bestAtISO)">#(you.bestAtText)</span></span></dd>
            #if(you.hasNextPlace):
            <dt>Next place</dt>
            <dd>#(you.nextPlaceText)</dd>
            #endif
        </dl>
        #endif
    </section>
    #endif
    #if(isStaff):
    <p class="section-note">#(staffSummary)</p>
    #endif
    #endif
    #if(hasHill):
    #if(champion):
    <p>
        Champion:
        #extend("_avatar", champion.avatar)
        <span data-avatar-handle>#(champion.handle)</span>
        #if(champion.isViewer):
        <span class="chip">you</span>
        #endif
        #if(isStaff):
        <span class="text-muted">· #(champion.name)</span>
        #endif
        <span class="text-muted">· took the hill <span class="js-relative-time" data-iso="#(champion.crownedAtISO)">#(champion.crownedAtText)</span> · #(champion.defencesText)</span>
    </p>
    #else:
    <p class="text-muted">No student holds the hill yet.</p>
    #endif
    #endif
    #if(showsBracket):
    #if(hasTournament):
    <p class="text-muted">#(tournament.statusText)</p>
    #if(tournament.hasWinner):
    <p>
        Winner:
        #if(tournament.winner.hasAvatar):
        #extend("_avatar", tournament.winner.avatar)
        #endif
        <span data-avatar-handle>#(tournament.winner.handle)</span>
        #if(tournament.winner.isViewer):
        <span class="chip">you</span>
        #endif
        #if(isStaff):
        <span class="text-muted">· #(tournament.winner.name)</span>
        #endif
    </p>
    #endif
    #for(round in tournament.rounds):
    <h3 class="submission-section-heading">Round #(round.number)</h3>
    <table class="results-table">
        <thead>
            <tr>
                <th>First entrant</th>
                <th>Second entrant</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
        #for(match in round.matches):
            <tr>
                <td>
                    #if(match.home.hasAvatar):
                    #extend("_avatar", match.home.avatar)
                    #endif
                    <span data-avatar-handle>#(match.home.handle)</span>
                    #if(match.home.isViewer):
                    <span class="chip">you</span>
                    #endif
                    #if(isStaff):
                    <span class="text-muted">· #(match.home.name)</span>
                    #endif
                    #if(match.homeWon):
                    <span class="tier tier-open">won</span>
                    #endif
                </td>
                <td>
                    #if(match.hasAway):
                    #if(match.away.hasAvatar):
                    #extend("_avatar", match.away.avatar)
                    #endif
                    <span data-avatar-handle>#(match.away.handle)</span>
                    #if(match.away.isViewer):
                    <span class="chip">you</span>
                    #endif
                    #if(isStaff):
                    <span class="text-muted">· #(match.away.name)</span>
                    #endif
                    #if(match.awayWon):
                    <span class="tier tier-open">won</span>
                    #endif
                    #else:
                    <span class="text-muted">—</span>
                    #endif
                </td>
                <td>#(match.resultText)</td>
            </tr>
        #endfor
        </tbody>
    </table>
    #endfor
    #else:
    <p class="empty">No tournament has been run yet.</p>
    #endif
    #elseif(showsUnion):
    #if(hasUnion):
    <p class="text-muted">#(union.summaryText)</p>
    <h3 class="submission-section-heading">Tests</h3>
    <table class="results-table">
        <thead>
            <tr>
                <th>Student</th>
                #if(isStaff):
                <th>Name</th>
                #endif
                <th class="time">Defeated</th>
                <th class="time">Tested</th>
            </tr>
        </thead>
        <tbody>
        #for(row in union.kills):
            <tr>
                <td>
                    #extend("_avatar", row.avatar)
                    <span data-avatar-handle>#(row.handle)</span>
                    #if(row.isViewer):
                    <span class="chip">you</span>
                    #endif
                </td>
                #if(isStaff):
                <td>#(row.name)</td>
                #endif
                <td class="time">#(row.defeated)</td>
                <td class="time">#(row.faced)</td>
            </tr>
        #endfor
        </tbody>
    </table>
    <h3 class="submission-section-heading">Code</h3>
    <table class="results-table">
        <thead>
            <tr>
                <th>Student</th>
                #if(isStaff):
                <th>Name</th>
                #endif
                <th class="time">Tested by</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
        #for(row in union.defences):
            <tr>
                <td>
                    #extend("_avatar", row.avatar)
                    <span data-avatar-handle>#(row.handle)</span>
                    #if(row.isViewer):
                    <span class="chip">you</span>
                    #endif
                </td>
                #if(isStaff):
                <td>#(row.name)</td>
                #endif
                <td class="time">#(row.faced)</td>
                <td>#(row.statusText)</td>
            </tr>
        #endfor
        </tbody>
    </table>
    #else:
    <p class="empty">No student has submitted yet.</p>
    #endif
    #elseif(showsStandings):
    #if(count(standings) == 0):
    <p class="empty">No submission has played a match yet.</p>
    #else:
    <table class="results-table">
        <thead>
            <tr>
                <th>Rank</th>
                <th>Student</th>
                #if(isStaff):
                <th>Name</th>
                #endif
                <th class="time">Played</th>
                <th class="time">Won</th>
                <th class="time col-hide-phone">Drawn</th>
                <th class="time col-hide-phone">Lost</th>
                <th class="time">Average</th>
            </tr>
        </thead>
        <tbody>
        #for(row in standings):
            <tr>
                <td>#(row.rank)</td>
                <td>
                    #extend("_avatar", row.avatar)
                    <span data-avatar-handle>#(row.handle)</span>
                    #if(row.isViewer):
                    <span class="chip">you</span>
                    #endif
                </td>
                #if(isStaff):
                <td>#(row.name)</td>
                #endif
                <td class="time">#(row.played)</td>
                <td class="time">#(row.wins)</td>
                <td class="time col-hide-phone">#(row.draws)</td>
                <td class="time col-hide-phone">#(row.losses)</td>
                <td class="time">#(row.averageText)</td>
            </tr>
        #endfor
        </tbody>
    </table>
    #endif
    #elseif(count(rows) == 0):
    <p class="empty">No submission has reported a ranking metric yet.</p>
    #else:
    <table class="results-table section-items" id="leaderboard-table">
        <colgroup>
            <col class="leaderboard-rank"><col class="section-items-tile"><col><col class="section-items-status">#if(isStaff):<col class="section-items-actions">#endif
        </colgroup>
        <thead class="visually-hidden">
            <tr>
                <th scope="col">Rank</th>
                <th scope="col">Bird</th>
                <th scope="col">Student</th>
                <th scope="col">Metric</th>
                #if(isStaff):
                <th scope="col">Actions</th>
                #endif
            </tr>
        </thead>
        <tbody>
        #for(item in displayItems):
        #if(item.isGap):
            <tr class="leaderboard-gap">
                <td colspan="#if(isStaff):5#else:4#endif"><a href="#(allURL)">#(item.gapLabel)</a></td>
            </tr>
        #else:
            <tr#if(item.row.isViewer): class="leaderboard-row--you"#endif>
                <td class="leaderboard-rank"><span class="rank-disc" data-rank-tier="#(item.row.rankTier)">#(item.row.rankText)</span></td>
                <td class="item-tile-cell">#extend("_avatar", item.row.avatar)</td>
                <td>
                    <div class="item-title"><span data-avatar-handle>#(item.row.handle)</span>#if(item.row.isViewer): <span class="you-pill">You</span>#endif</div>
                    #if(isStaff):
                    <div class="item-details">#(item.row.name) · <code>#(item.row.username)</code> · #(item.row.submissionCountText) · best <span class="js-relative-time" data-iso="#(item.row.bestAtISO)">#(item.row.bestAtText)</span></div>
                    #elseif(item.row.hasTieNote):
                    <div class="item-details">#(item.row.tieNote)</div>
                    #endif
                </td>
                <td class="item-grade">#(item.row.metricText)</td>
                #if(isStaff):
                <td>
                    <div class="assignment-actions-cell">
                        <a class="btn action-btn action-btn-icon" href="#(item.row.bestSubmissionURL)" title="View best submission" aria-label="View best submission of #(item.row.handle)"><svg class="icon" aria-hidden="true"><use href="#i-eye"/></svg></a>
                    </div>
                </td>
                #endif
            </tr>
        #endif
        #endfor
        </tbody>
    </table>
    #if(showingAll):
    <p class="section-note"><a href="#(boardURL)">Show my standing</a></p>
    #endif
    #endif
