<!-- Everything on the leaderboard that MOVES, rendered inline by
     leaderboard.leaf and again as its background refresh. The page's fixed
     chrome stays there, not here. Why: docs/class-activities.md, "Live-session
     controls (slice 8)". -->
    #if(hasWindow):
    <div class="chip-row">
        <span class="chip">#(window.label) <span class="js-relative-time" data-iso="#(window.boundaryISO)">#(window.boundaryText)</span></span>
    </div>
    #endif
    #if(hasYou):
    <section class="you-card card" aria-label="Your standing">
        #extend("_avatar", you.avatar)
        <div class="you-card-who">
            <div class="you-card-name">
                #if(you.hasHandle):<span data-avatar-handle>#(you.handle)</span> #endif<span class="you-pill">You</span>
            </div>
            #if(you.isRanked):
            <div class="you-card-rank">#(you.rankHeadline) <small>#(you.ofText)</small></div>
            #else:
            <div class="you-card-rank">#(you.rankHeadline)</div>
            <p class="section-note"><a href="#(you.submitURL)">Submit to get on the board.</a></p>
            #endif
            #if(you.hasHandle):
            <p class="section-note">#(you.privacyLine)</p>
            #endif
        </div>
        #if(you.isRanked):
        <dl class="you-card-stats">
            <dt>#(you.bestLabel)</dt>
            <dd>#(you.bestText)#if(you.hasBestAt): <span class="text-muted">· <span class="js-relative-time" data-iso="#(you.bestAtISO)">#(you.bestAtText)</span></span>#endif</dd>
            #if(you.hasNextPlace):
            <dt>Next place</dt>
            <dd>#(you.nextPlaceText)</dd>
            #endif
        </dl>
        #endif
    </section>
    #endif
    #if(showsMetricBoard):
    #if(isStaff):
    <p class="section-note">#(staffSummary)</p>
    #endif
    #endif
    #if(hasHill):
    #if(champion):
    <section class="champion-card card#if(champion.isViewer): you-card#endif" aria-label="Holder of the hill">
        #extend("_avatar", champion.avatar)
        <div class="you-card-who">
            <div class="you-card-kicker">Holds the hill</div>
            <div class="you-card-name"><span data-avatar-handle>#(champion.handle)</span>#if(champion.isViewer): <span class="you-pill">You</span>#endif#if(isStaff): <span class="text-muted">· #(champion.name)</span>#endif</div>
            <p class="section-note">Took it <span class="js-relative-time" data-iso="#(champion.crownedAtISO)">#(champion.crownedAtText)</span> · #(champion.defencesText)</p>
        </div>
    </section>
    #else:
    <p class="text-muted">No student holds the hill yet.</p>
    #endif
    #endif
    #if(showsBracket):
    #if(hasTournament):
    <p class="text-muted">#(tournament.statusText)</p>
    #if(tournament.hasWinner):
    <section class="champion-card card#if(tournament.winner.isViewer): you-card#endif" aria-label="Winner">
        #if(tournament.winner.hasAvatar):
        #extend("_avatar", tournament.winner.avatar)
        #endif
        <div class="you-card-who">
            <div class="you-card-kicker">Winner</div>
            <div class="you-card-name"><span data-avatar-handle>#(tournament.winner.handle)</span>#if(tournament.winner.isViewer): <span class="you-pill">You</span>#endif#if(isStaff): <span class="text-muted">· #(tournament.winner.name)</span>#endif</div>
        </div>
    </section>
    #endif
    #extend("_leaderboard-bracket", tournament)
    #else:
    <p class="empty">No tournament has been run yet.</p>
    #endif
    #elseif(showsUnion):
    #if(hasUnion):
    #if(union.hasYou):
    <section class="you-card card" aria-label="Your standing">
        #extend("_avatar", union.you.avatar)
        <div class="you-card-who">
            <div class="you-card-kicker">#(union.you.kicker)</div>
            <div class="you-card-rank">#(union.you.titleText)</div>
            #if(union.you.isRanked):
            <p class="section-note">#(union.you.noteText)</p>
            #else:
            <p class="section-note"><a href="#(union.you.submitURL)">Submit to get on the board.</a></p>
            #endif
            #if(union.you.hasHandle):
            <p class="section-note">#(union.you.privacyLine)</p>
            #endif
        </div>
    </section>
    #endif
    <p class="text-muted">#(union.summaryText)</p>
    <h3 class="submission-section-heading">Tests</h3>
    #extend("_leaderboard-list", union.killList)
    #if(showingAll):
    <p class="section-note"><a href="#(boardURL)">Show my standing</a></p>
    #endif
    <h3 class="submission-section-heading">Code</h3>
    <table class="results-table section-items" id="leaderboard-code-table">
        <colgroup>
            <col class="section-items-tile"><col>
        </colgroup>
        <thead class="visually-hidden">
            <tr>
                <th scope="col">Bird</th>
                <th scope="col">Student</th>
            </tr>
        </thead>
        <tbody>
        #for(row in union.defences):
            <tr#if(row.isViewer): class="leaderboard-row--you"#endif>
                <td class="item-tile-cell">#extend("_avatar", row.avatar)</td>
                <td class="item-main">
                    <div class="item-title"><span data-avatar-handle>#(row.handle)</span>#if(row.isViewer): <span class="you-pill">You</span>#endif</div>
                    <div class="item-details">#if(isStaff):#(row.name) · #endif#(row.detailsText)</div>
                </td>
            </tr>
        #endfor
        </tbody>
    </table>
    #else:
    <p class="empty">No student has submitted yet.</p>
    #endif
    #elseif(showsStandings):
    #if(count(standings) == 0):
    <p class="empty">No submission has played a match yet.</p>
    #else:
    #extend("_leaderboard-list", standingList)
    #if(showingAll):
    <p class="section-note"><a href="#(boardURL)">Show my standing</a></p>
    #endif
    #endif
    #elseif(count(rows) == 0):
    <p class="empty">No submission has reported a ranking metric yet.</p>
    #else:
    <table class="results-table section-items" id="leaderboard-table">
        <colgroup>
            <col class="leaderboard-rank"><col class="section-items-tile"><col><col class="section-items-status">#if(isStaff):<col class="section-items-actions">#endif
        </colgroup>
        <thead class="visually-hidden">
            <tr>
                <th scope="col">Rank</th>
                <th scope="col">Bird</th>
                <th scope="col">Student</th>
                <th scope="col">Metric</th>
                #if(isStaff):
                <th scope="col">Actions</th>
                #endif
            </tr>
        </thead>
        <tbody>
        #for(item in displayItems):
        #if(item.isGap):
            <tr class="leaderboard-gap">
                <td colspan="#if(isStaff):5#else:4#endif"><a href="#(allURL)">#(item.gapLabel)</a></td>
            </tr>
        #else:
            <tr#if(item.row.isViewer): class="leaderboard-row--you"#endif>
                <td class="leaderboard-rank"><span class="rank-disc" data-rank-tier="#(item.row.rankTier)">#(item.row.rankText)</span></td>
                <td class="item-tile-cell">#extend("_avatar", item.row.avatar)</td>
                <td class="item-main">
                    <div class="item-title"><span data-avatar-handle>#(item.row.handle)</span>#if(item.row.isViewer): <span class="you-pill">You</span>#endif</div>
                    #if(isStaff):
                    <div class="item-details">#(item.row.name) · <code>#(item.row.username)</code> · #(item.row.submissionCountText) · best <span class="js-relative-time" data-iso="#(item.row.bestAtISO)">#(item.row.bestAtText)</span></div>
                    #elseif(item.row.hasTieNote):
                    <div class="item-details">#(item.row.tieNote)</div>
                    #endif
                </td>
                <td class="item-status item-grade">#(item.row.metricText)</td>
                #if(isStaff):
                <td class="item-actions-td">
                    <div class="assignment-actions-cell">
                        <a class="btn action-btn action-btn-icon" href="#(item.row.bestSubmissionURL)" title="View best submission" aria-label="View best submission of #(item.row.handle)"><svg class="icon" aria-hidden="true"><use href="#i-eye"/></svg></a>
                    </div>
                </td>
                #endif
            </tr>
        #endif
        #endfor
        </tbody>
    </table>
    #if(showingAll):
    <p class="section-note"><a href="#(boardURL)">Show my standing</a></p>
    #endif
    #endif
