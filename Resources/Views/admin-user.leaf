#extend("base"):
#export("title"):
Courses — #if(displayName):#(displayName)#else:#(username)#endif
#endexport
#export("content"):
<div class="page-titlebar">
    <h1>
        #if(displayName):#(displayName)#else:#(username)#endif — Courses
    </h1>
</div>
<p class="page-subtitle">
    @#(username) · #(role)
</p>

<section class="page-section">
    <h2>Enrolled courses</h2>
    #if(enrolledCourses.isEmpty):
    <p class="empty">Not enrolled in any courses.</p>
    #else:
    <table class="results-table">
        <thead>
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        #for(course in enrolledCourses):
            <tr>
                <td><strong>#(course.code)</strong></td>
                <td>#(course.name)</td>
                <td>
                    <form method="post"
                          action="/admin/users/#(targetUserID)/unenroll/#(course.id)"
                          class="inline-form">
                        #csrfFormField()
                        <button class="btn action-btn action-btn-icon action-danger" type="submit"
                                title="Remove from course" aria-label="Remove from course">
                            <svg class="icon" aria-hidden="true"><use href="#i-trash"/></svg>
                        </button>
                    </form>
                </td>
            </tr>
        #endfor
        </tbody>
    </table>
    #endif
</section>

<section class="page-section">
    <h2>Add to course</h2>
    #if(availableCourses.isEmpty):
    <p class="empty">
        #if(enrolledCourses.isEmpty):
        No active courses are available.
        #else:
        Enrolled in all active courses.
        #endif
    </p>
    #else:
    <form method="post"
          action="/admin/users/#(targetUserID)/enroll"
          class="toolbar user-enroll-form">
        #csrfFormField()
        <select name="courseID" class="form-input user-enroll-select">
            #for(course in availableCourses):
            <option value="#(course.id)">#(course.code) — #(course.name)</option>
            #endfor
        </select>
        <button class="btn btn-primary" type="submit">Add</button>
    </form>
    #endif
</section>

<style>
.user-enroll-form { max-width: 500px; }
.user-enroll-select { flex: 1; }
</style>
#endexport
#endextend
