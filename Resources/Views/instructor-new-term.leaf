#extend("base"):
#export("title"):
New term
#endexport
#export("content"):
#extend("_instructor-tabs")

#if(!hasActiveCourse):
<section class="page-section">
    <p class="empty">Select a course to clone it for a new term.</p>
</section>
#elseif(justCloned):
<section class="page-section">
    <h2>#(courseCode)#if(termLabel): #(termLabel)#endif — #(courseName)</h2>
    <p class="section-intro">This is the new course. Its assignments are closed and have no dates.</p>
    <div class="toolbar">
        <a class="btn btn-primary" href="/instructor">Open its assignments</a>
    </div>
</section>
#else:

<section class="page-section">
    <h2>Clone #(courseCode)#if(termLabel): #(termLabel)#endif for a new term</h2>
    <p class="section-intro">Copies this course's content into a new course that you teach; students, submissions and grades stay here.</p>
    <p class="section-note">Copied assignments start closed, with no dates and with the solution reveal off.</p>
    #if(canClone):
    <form method="post" action="/instructor/new-term" class="form-stack">
        #csrfFormField()
        #extend("_course-fields", cloneForm)
        <div class="toolbar">
            <button class="btn btn-primary" type="submit">Clone course</button>
        </div>
    </form>
    #else:
    <p class="section-note">Only this course's instructors can clone it.</p>
    #endif
</section>

#endif
#endexport
#endextend
