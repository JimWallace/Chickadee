#extend("base"):
#export("title"):
Submission History
#endexport
#export("content"):
<h1>#(assignmentTitle)</h1>
#if(count(rows) == 0):
<p class="empty">No submissions yet for this assignment.</p>
#else:
<table class="results-table">
    <thead>
        <tr>
            <th class="col-hide-phone">Attempt</th>
            <th>Submitted</th>
            <th>Status</th>
            <th>Grade</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    #for(row in rows):
        <tr>
            <td class="col-hide-phone">#(row.attemptNumber)</td>
            <td>#(row.submittedAt)</td>
            <td>#(row.status)</td>
            <td>#(row.gradeText)</td>
            <td>
                <div class="history-actions">
                    <a class="btn action-btn action-btn-icon" href="/submissions/#(row.submissionID)" title="View results" aria-label="View results">
                        <svg class="icon" aria-hidden="true"><use href="#i-eye"/></svg>
                    </a>
                    <a class="btn action-btn action-btn-icon" href="/api/v1/submissions/#(row.submissionID)/download" title="Download submission" aria-label="Download submission">
                        <svg class="icon" aria-hidden="true"><use href="#i-download"/></svg>
                    </a>
                    #if(row.canOpenInNotebook):
                    <a class="btn action-btn action-btn-icon" href="#(row.openInNotebookURL)" title="Open in notebook" aria-label="Open in notebook">
                        <svg class="icon" aria-hidden="true"><use href="#i-book"/></svg>
                    </a>
                    #endif
                </div>
            </td>
        </tr>
    #endfor
    </tbody>
</table>
#endif
<style>
.history-actions {
    display: flex;
    gap: .4rem;
    flex-wrap: wrap;
    align-items: center;
}
</style>
#endexport
#endextend
