#extend("base"):
#export("title"):
#(assignmentTitle) — Leaderboard
#endexport
#export("content"):
#if(courseLabel != ""):
<p class="page-crumb">#(courseLabel)</p>
#endif
<h1>#(assignmentTitle)</h1>

#extend("_avatar-sprite")

<section class="page-section">
    <div class="page-titlebar">
        <h2>Leaderboard</h2>
        <div class="toolbar">
            <span class="chip">#(kindLabel)</span>
            #if(isStaff):
            <form method="post" action="/instructor/#(assignmentPublicID)/activity" class="inline-form form-flush">
                #csrfFormField()
                <input type="hidden" name="returnTo" value="#(boardURL)">
                <label class="visually-hidden" for="leaderboard-visibility">Visibility to students</label>
                <span class="state-select" data-state="#if(visibleToStudents):visible#else:hidden#endif">
                    <select id="leaderboard-visibility" name="visibility" class="form-input" data-ck-submit-on-change>
                        <option value="visible"#if(visibleToStudents): selected#endif>Visible to students</option>
                        <option value="hidden"#if(!visibleToStudents): selected#endif>Hidden from students</option>
                    </select>
                </span>
            </form>
            <a class="btn action-btn" href="#(boardURL)?present=1" target="_blank" rel="noopener"><svg class="icon" aria-hidden="true"><use href="#i-slides"/></svg> Present</a>
            #endif
        </div>
    </div>
    #if(showsBracket):
    <p class="section-intro">Each match plays the first entrant's frozen submission against the second's. Rounds advance as matches land. Students appear under their class handle.</p>
    #elseif(showsUnion):
    <p class="section-intro">Every student's tests run against every classmate's latest submission. Most faults found first, then most classmates tested; code that is still holding first. Students appear under their class handle.</p>
    #elseif(showsStandings):
    <p class="section-intro">Highest average match score first, then most wins. Each row is the student's latest submission. Students appear under their class handle.</p>
    #else:
    <p class="section-intro">Highest metric first. A tie goes to the submission that reached it first. Students appear under their class handle.</p>
    #endif
    #if(showFilter):
    <div class="toolbar toolbar--end section-gap">
        <span class="filter-group">
            <label class="filter-label" for="leaderboard-filter">Filter</label>
            <input id="leaderboard-filter" class="form-input filter-input" type="search"
                   placeholder="#(filterPlaceholder)"
                   data-list-filter="leaderboard-table"
                   data-list-filter-empty="Nobody on the board matches this filter.">
        </span>
    </div>
    #endif
    <div id="activity-results"#if(pollsLive): data-poll-swap="region" data-poll-url="#(pollURL)" data-poll-interval="5000"#if(hasPollUntil): data-poll-until="#(pollUntilISO)"#endif#endif>
    #extend("_leaderboard-body")
    </div>
</section>
#if(showFilter):
<script src="/list-filter.js?v=#appVersion()"></script>
#endif
#endexport
#endextend
