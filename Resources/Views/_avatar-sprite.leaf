            <circle class="av-wing-mark" cx="47.85" cy="41" r="1.05"/>
            <circle class="av-wing-mark" cx="49.75" cy="41" r="1.05"/>
            <circle class="av-wing-mark" cx="47.99" cy="44.5" r="1.05"/>
            <g transform="translate(64 0) scale(-1 1)"><path class="av-wing" d="M52.99,33.5 A21,21 0 0 1 48.09,47.5 C44.59,45 43.6,41.5 44.8,35.7 C47.4,33 50.39,32.6 52.99,33.5 Z"/>
            <circle class="av-wing-mark" cx="48.1" cy="37" r="1.05"/>
            <circle class="av-wing-mark" cx="50.49" cy="37" r="1.05"/>
            <circle class="av-wing-mark" cx="47.85" cy="41" r="1.05"/>
            <circle class="av-wing-mark" cx="49.75" cy="41" r="1.05"/>
