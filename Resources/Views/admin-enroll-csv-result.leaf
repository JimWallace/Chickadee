#extend("base"):
#export("title"):
CSV Enrollment Result
#endexport
#export("content"):
<div class="csv-result-head">
    <a href="#(returnURL)" class="btn">← #(courseCode)</a>
    <h1 class="csv-result-title">CSV Enrollment — #(courseCode)</h1>
</div>
<p class="csv-result-subtitle">#(courseName)</p>

<section class="admin-section">
    <h2>Results</h2>
    <dl class="csv-result-list">
        <dt class="csv-result-term">Enrolled (existing accounts)</dt>
        <dd class="csv-result-def">#(enrolledCount)</dd>
        <dt class="csv-result-term">Pre-enrolled (resolved on first login)</dt>
        <dd class="csv-result-def">#(preEnrolledCount)</dd>
        <dt class="csv-result-term">Already enrolled (skipped)</dt>
        <dd class="csv-result-def">#(alreadyEnrolledCount)</dd>
        <dt class="csv-result-term">Rejected (invalid format)</dt>
        <dd class="csv-result-def">#(rejectedCount)</dd>
    </dl>
    #if(hasPreEnrolled):
    <p class="csv-result-pre-note">
        Pre-enrolled usernames are recorded as pending; each one is automatically added to the roster the first time that student signs in.  No action needed from you.
    </p>
    #endif
</section>

#if(hasRejected):
<section class="admin-section">
    <h2>Rejected usernames</h2>
    <p class="csv-result-reject-note">
        These rows in the CSV had a format we couldn't accept (empty, too long, or contained unsafe characters).  Fix the CSV and re-upload.
    </p>
    <ul class="csv-result-reject-list">
    #for(name in rejectedUsernames):
        <li><code>#(name)</code></li>
    #endfor
    </ul>
</section>
#endif

<style>
.csv-result-head {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
}
.csv-result-title {
    margin: 0;
}
.csv-result-subtitle {
    color: var(--gray-600);
    margin-top: -.75rem;
    margin-bottom: 1.5rem;
}
.csv-result-list {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: .4rem 1.5rem;
    max-width: 480px;
    margin: 0;
}
.csv-result-term {
    font-weight: 600;
}
.csv-result-def {
    margin: 0;
}
.csv-result-pre-note {
    font-size: .85rem;
    color: var(--gray-600);
    margin-top: .75rem;
    margin-bottom: 0;
}
.csv-result-reject-note {
    font-size: .875rem;
    color: var(--gray-600);
    margin-top: 0;
}
.csv-result-reject-list {
    margin: .25rem 0 0 1.25rem;
    padding: 0;
}
</style>
#endexport
#endextend
