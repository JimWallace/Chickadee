#extend("base"):
#export("title"):
CSV Enrollment Result
#endexport
#export("content"):
<div class="page-titlebar">
    <h1>CSV Enrollment — #(courseCode)</h1>
    <a href="#(returnURL)" class="btn">← #(courseCode)</a>
</div>
<p class="page-subtitle">#(courseName)</p>

<section class="page-section">
    <h2>Results</h2>
    <div class="card section-gap">
    <dl class="detail-grid">
        <dt>Enrolled (existing accounts)</dt>
        <dd>#(enrolledCount)</dd>
        <dt>Pre-enrolled</dt>
        <dd>#(preEnrolledCount)</dd>
        <dt>Already enrolled (skipped)</dt>
        <dd>#(alreadyEnrolledCount)</dd>
        <dt>Rejected (invalid format)</dt>
        <dd>#count(rejectedUsernames)</dd>
    </dl>
    </div>
    #if(preEnrolledCount > 0):
    <p class="section-note">Each pre-enrolled username joins the roster the first time that student signs in.</p>
    #endif
</section>

#if(count(rejectedUsernames) > 0):
<section class="page-section">
    <h2>Rejected usernames</h2>
    <p class="section-note">These usernames are too long or hold unsupported characters; correct them and submit again.</p>
    <ul class="csv-rejected-list">
    #for(name in rejectedUsernames):
        <li><code>#(name)</code></li>
    #endfor
    </ul>
</section>
#endif

<style>
.csv-rejected-list { margin-left: 1.25rem; }
</style>
#endexport
#endextend
