#extend("base"):
#export("title"):
Audit Log
#endexport
#export("content"):
<p class="admin-version-banner">Chickadee v#appVersion()</p>
#extend("_admin-tabs")
<section class="page-section">
    <div class="page-titlebar">
        <h2>Audit Log</h2>
    </div>

    <p class="section-intro">
        Records sensitive admin actions, authentication events, and agent
        (MCP / OAuth) activity.  The most recent 200 matching entries are
        shown; older entries remain in the database.
    </p>

    <form method="get" action="/admin/audit"
        class="toolbar section-gap">
        <label class="field-inline">
            <span>Action</span>
            <select name="action" class="form-input input-compact">
                <option value="">All actions</option>
                #for(option in actionOptions):
                <option value="#(option.value)"#if(option.selected): selected#endif>#(option.label)</option>
                #endfor
            </select>
        </label>
        <span class="filter-group">
            <label class="filter-label" for="audit-actor">Filter by person</label>
            <input id="audit-actor" class="form-input filter-input" type="search"
                   name="actor" value="#(filterActor)" placeholder="username">
        </span>
        <button type="submit" class="btn">Filter</button>
        #if(filtered):
        <a href="/admin/audit" class="btn">Clear</a>
        #endif
    </form>

    #if(count(rows) == 0):
    <p class="text-muted">#if(filtered):No audit entries match this filter.#else:No audit entries recorded yet.#endif</p>
    #else:
    <p class="text-muted">
        Showing #count(rows) of #(matchCount) matching #if(matchCount == 1):entry#else:entries#endif.
    </p>
    <!-- The log/event shape: when, who, what, how it went, and a payload that
         is usually noise.  Category, target, remote address and metadata all
         live in the closed disclosure — nothing is dropped, it just stops
         competing with the four facts a reader scans. -->
    <div class="table-scroll"><table class="results-table sortable-table"
        data-sort-initial="when:desc" data-sort-tiebreak="when">
        <thead>
            <tr>
                <th class="audit-col-time" data-sort-key="when" data-sort-type="date"><button class="sort-header" type="button">When</button></th>
                <th class="audit-col-actor" data-sort-key="actor" data-sort-type="text"><button class="sort-header" type="button">Actor</button></th>
                <th class="audit-col-action" data-sort-key="event" data-sort-type="text"><button class="sort-header" type="button">Event</button></th>
                <th class="audit-col-outcome" data-sort-key="outcome" data-sort-type="text"><button class="sort-header" type="button">Outcome</button></th>
                <!-- Phone drops the payload disclosure: it is the column this
                     shape exists to demote, and the four facts beside it are
                     what a reader opened the log for. -->
                <th class="col-hide-phone">Detail</th>
            </tr>
        </thead>
        <tbody>
            #for(row in rows):
            <tr>
                <td class="audit-col-time" data-sort-value="#(row.timestampISO)">
                    <span class="js-relative-time" data-iso="#(row.timestampISO)">#(row.timestamp)</span>
                    <span class="log-when-absolute">#(row.timestamp)</span>
                </td>
                <td>#(row.actor)</td>
                <td>#(row.label)<br><code class="audit-action-code">#(row.action)</code></td>
                <td><span class="tier #(row.outcomeTier)">#(row.outcome)</span></td>
                <td class="col-hide-phone">
                    <details class="test-output-details">
                        <summary>Payload</summary>
                        <dl class="detail-grid log-payload">
                            <dt>Category</dt>
                            <dd>#(row.category)</dd>
                            <dt>Target</dt>
                            <dd>#if(row.targetType):#(row.targetType)#if(row.targetID): · <code>#(row.targetID)</code>#endif#else:—#endif</dd>
                            <dt>Remote</dt>
                            <dd><code>#(row.remoteAddr)</code></dd>
                            <dt>Metadata</dt>
                            <dd class="audit-metadata">#if(row.metadata == ""):—#else:#(row.metadata)#endif</dd>
                        </dl>
                    </details>
                </td>
            </tr>
            #endfor
        </tbody>
    </table></div>
    #endif
</section>
<style>
.audit-col-time { width: 11rem; }
.audit-col-actor { width: 8rem; }
.audit-col-action { width: 14rem; }
.audit-col-outcome { width: 7rem; }
/* The forensic instant, under the relative reading that leads the cell. */
.log-when-absolute {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--gray-600);
}
.audit-action-code {
    font-size: var(--text-xs);
    color: var(--muted);
}
.audit-metadata {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    white-space: pre-wrap;
    word-break: break-word;
}
</style>
<script src="/sortable-table.js?v=#appVersion()"></script>
<script src="/list-filter.js?v=#appVersion()"></script>
#endexport
#endextend
