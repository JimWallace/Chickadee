#extend("base"):
#export("title"):
Audit Log
#endexport
#export("content"):
<p class="admin-version-banner">Chickadee v#appVersion()</p>
#extend("_admin-tabs")
<section class="page-section">
    <div class="page-titlebar">
        <h2>Audit Log</h2>
    </div>

    <p class="section-intro">
        Records sensitive admin actions, authentication events, and agent
        (MCP / OAuth) activity.  The most recent 200 matching entries are
        shown; older entries remain in the database.
    </p>

    <form method="get" action="/admin/audit"
        class="toolbar section-gap">
        <label class="field-inline">
            <span>Action</span>
            <select name="action" class="form-input input-compact">
                <option value="">All actions</option>
                #for(option in actionOptions):
                <option value="#(option.value)"#if(option.selected): selected#endif>#(option.label)</option>
                #endfor
            </select>
        </label>
        <span class="filter-group">
            <label class="filter-label" for="audit-actor">Filter by person</label>
            <input id="audit-actor" class="form-input filter-input" type="search"
                   name="actor" value="#(filterActor)" placeholder="username">
        </span>
        <button type="submit" class="btn">Filter</button>
        #if(filtered):
        <a href="/admin/audit" class="btn">Clear</a>
        #endif
    </form>

    #if(count(rows) == 0):
    <p class="text-muted">#if(filtered):No audit entries match this filter.#else:No audit entries recorded yet.#endif</p>
    #else:
    <p class="text-muted">
        Showing #count(rows) of #(matchCount) matching #if(matchCount == 1):entry#else:entries#endif.
    </p>
    <div class="table-scroll"><table class="results-table">
        <thead>
            <tr>
                <th class="audit-col-time">Time</th>
                <th class="audit-col-actor">Actor</th>
                <th class="audit-col-category">Category</th>
                <th class="audit-col-action">Action</th>
                <th class="audit-col-target">Target</th>
                <th>Metadata</th>
                <th class="audit-col-remote">Remote</th>
            </tr>
        </thead>
        <tbody>
            #for(row in rows):
            <tr>
                <td class="audit-mono">#(row.timestamp)</td>
                <td>#(row.actor)</td>
                <td>#(row.category)</td>
                <td>#(row.label)<br><code class="audit-action-code">#(row.action)</code></td>
                <td>#if(row.targetType):#(row.targetType)#if(row.targetID): · <code>#(row.targetID)</code>#endif#else:—#endif</td>
                <td class="audit-metadata">#(row.metadata)</td>
                <td class="audit-mono">#(row.remoteAddr)</td>
            </tr>
            #endfor
        </tbody>
    </table></div>
    #endif
</section>
<style>
.audit-col-time { width: 11rem; }
.audit-col-actor { width: 8rem; }
.audit-col-category { width: 9rem; }
.audit-col-action { width: 14rem; }
.audit-col-target { width: 9rem; }
.audit-col-remote { width: 9rem; }
.audit-mono {
    font-family: var(--font-mono);
    font-size: var(--text-base);
}
.audit-action-code {
    font-size: var(--text-xs);
    color: var(--muted);
}
.audit-metadata {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    white-space: pre-wrap;
    word-break: break-word;
}
</style>
<script src="/list-filter.js?v=#appVersion()"></script>
#endexport
#endextend
