#extend("base"):
#export("title"):
Audit Log
#endexport
#export("content"):
<p class="admin-version-banner">Chickadee v#appVersion()</p>
#extend("_admin-tabs")
<section class="page-section">
    <div class="page-titlebar">
        <h2>Audit Log</h2>
    </div>

    <p class="section-intro">
        Records sensitive admin actions, authentication events, and agent
        (MCP / OAuth) activity.  The most recent 200 matching entries are
        shown; older entries remain in the database.
    </p>

    <form method="get" action="/admin/audit"
        class="toolbar section-gap">
        <label class="field-inline">
            <span>Action</span>
            <select name="action" class="form-input input-compact">
                <option value="">All actions</option>
                #for(option in actionOptions):
                <option value="#(option.value)"#if(option.selected): selected#endif>#(option.label)</option>
                #endfor
            </select>
        </label>
        <span class="filter-group">
            <label class="filter-label" for="audit-actor">Filter by person</label>
            <input id="audit-actor" class="form-input filter-input" type="search"
                   name="actor" value="#(filterActor)" placeholder="username">
        </span>
        <button type="submit" class="btn">Filter</button>
        #if(filtered):
        <a href="/admin/audit" class="btn">Clear</a>
        #endif
    </form>

    #if(count(rows) == 0):
    <p class="text-muted">#if(filtered):No audit entries match this filter.#else:No audit entries recorded yet.#endif</p>
    #else:
    <p class="text-muted">
        Showing #count(rows) of #(matchCount) matching #if(matchCount == 1):entry#else:entries#endif.
    </p>
    <!-- The log/event shape: when, who, what, how it went, and a payload that
         is usually noise.  Category, target, remote address and metadata live
         in the closed disclosure on a full-width second row — the same shape a
         submission's output panel uses.  Nothing is dropped; it just stops
         competing with the four facts a reader scans.  In the last column
         instead, the payload would have wrapped JSON into the ~200px the four
         fixed widths left over.

         Deliberately NOT a sortable-table: the server sends the most recent
         200 of matchCount, newest first, so a client-side re-sort would offer
         "oldest" rows that are only the oldest of that window — a wrong answer
         wearing a sorted table's authority, on a compliance surface. -->
    <div class="table-scroll"><table class="results-table">
        <thead>
            <tr>
                <th class="audit-col-time">When</th>
                <th class="audit-col-actor">Actor</th>
                <th class="audit-col-action">Event</th>
                <th class="audit-col-outcome">Outcome</th>
            </tr>
        </thead>
        <tbody>
            #for(row in rows):
            <tr>
                <td class="audit-col-time">
                    <span class="js-relative-time" data-iso="#(row.timestampISO)"></span>
                    <span class="log-when-absolute">#(row.timestamp)</span>
                </td>
                <td>#(row.actor)</td>
                <td>#(row.label)<br><code class="audit-action-code">#(row.action)</code></td>
                <td><span class="tier #(row.outcomeTier)">#(row.outcome)</span></td>
            </tr>
            <tr class="test-output-row">
                <td colspan="4">
                    <details class="test-output-details">
                        <summary>Payload</summary>
                        <dl class="detail-grid log-payload">
                            <dt>Category</dt>
                            <dd>#(row.category)</dd>
                            <dt>Target</dt>
                            <dd>#if(row.targetType):#(row.targetType)#if(row.targetID): · <code>#(row.targetID)</code>#endif#else:—#endif</dd>
                            <dt>Remote</dt>
                            <dd><code>#(row.remoteAddr)</code></dd>
                            <dt>Metadata</dt>
                            <dd class="audit-metadata">#if(row.metadata == ""):—#else:#(row.metadata)#endif</dd>
                        </dl>
                    </details>
                </td>
            </tr>
            #endfor
        </tbody>
    </table></div>
    #endif
</section>
<style>
.audit-col-time { width: 11rem; }
.audit-col-actor { width: 8rem; }
.audit-col-action { width: 14rem; }
.audit-col-outcome { width: 7rem; }
/* Forensic instant; also the no-JS fallback for the empty relative span. */
.log-when-absolute {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--gray-600);
}
.audit-action-code {
    font-size: var(--text-xs);
    color: var(--muted);
}
.audit-metadata {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    white-space: pre-wrap;
    word-break: break-word;
}
</style>
<script src="/list-filter.js?v=#appVersion()"></script>
#endexport
#endextend
