#extend("base"):
#export("title"):
Audit Log
#endexport
#export("content"):
<p class="admin-version-banner">Chickadee v#appVersion()</p>
<nav class="admin-tabs" aria-label="Admin sections">
    <a class="admin-tab" href="/admin"#if(activeAdminTab == "overview"): aria-current="page"#endif>Overview</a>
    <a class="admin-tab" href="/admin/users"#if(activeAdminTab == "users"): aria-current="page"#endif>Users</a>
    <a class="admin-tab" href="/admin/storage"#if(activeAdminTab == "storage"): aria-current="page"#endif>Storage</a>
    <a class="admin-tab" href="/admin/retention"#if(activeAdminTab == "retention"): aria-current="page"#endif>Retention</a>
    #if(mcpEnabled()):<a class="admin-tab" href="/admin/mcp"#if(activeAdminTab == "mcp"): aria-current="page"#endif>MCP</a>#endif
    <a class="admin-tab" href="/admin/audit"#if(activeAdminTab == "audit"): aria-current="page"#endif>Audit Log</a>
    <a class="admin-tab" href="/admin/alerts"#if(activeAdminTab == "alerts"): aria-current="page"#endif>Health Alerts</a>
</nav>
<section class="admin-section">
    <div class="page-titlebar">
        <h2>Audit Log</h2>
    </div>

    <p class="audit-intro">
        Records sensitive admin actions, authentication events, and agent
        (MCP / OAuth) activity.  The most recent 200 matching entries are
        shown; older entries remain in the database.
    </p>

    <form method="get" action="/admin/audit"
        class="audit-filter-form">
        <label class="audit-filter-field">
            <span class="audit-filter-label">Action</span>
            <select name="action" class="audit-action-select">
                <option value="">All actions</option>
                #for(option in actionOptions):
                <option value="#(option.value)"#if(option.selected): selected#endif>#(option.label)</option>
                #endfor
            </select>
        </label>
        <label class="audit-filter-field">
            <span class="audit-filter-label">Actor contains</span>
            <input type="text" name="actor" value="#(filterActor)" placeholder="username" autocomplete="off" />
        </label>
        <button type="submit" class="btn">Filter</button>
        #if(filtered):
        <a href="/admin/audit" class="btn btn--secondary">Clear</a>
        #endif
    </form>

    #if(!rows.count):
    <p class="audit-muted">#if(filtered):No audit entries match this filter.#else:No audit entries recorded yet.#endif</p>
    #else:
    <p class="audit-count">
        Showing #count(rows) of #(matchCount) matching #if(matchCount == 1):entry#else:entries#endif.
    </p>
    <div class="table-scroll"><table class="results-table">
        <thead>
            <tr>
                <th class="audit-col-time">Time</th>
                <th class="audit-col-actor">Actor</th>
                <th class="audit-col-category">Category</th>
                <th class="audit-col-action">Action</th>
                <th class="audit-col-target">Target</th>
                <th>Metadata</th>
                <th class="audit-col-remote">Remote</th>
            </tr>
        </thead>
        <tbody>
            #for(row in rows):
            <tr>
                <td class="audit-mono">#(row.timestamp)</td>
                <td>#(row.actor)</td>
                <td>#(row.category)</td>
                <td>#(row.label)<br><code class="audit-action-code">#(row.action)</code></td>
                <td>#if(row.targetType):#(row.targetType)#if(row.targetID): · <code>#(row.targetID)</code>#endif#else:—#endif</td>
                <td class="audit-metadata">#(row.metadata)</td>
                <td class="audit-mono">#(row.remoteAddr)</td>
            </tr>
            #endfor
        </tbody>
    </table></div>
    #endif
</section>
<style>
.audit-col-time { width: 11rem; }
.audit-col-actor { width: 8rem; }
.audit-col-category { width: 9rem; }
.audit-col-action { width: 14rem; }
.audit-col-target { width: 9rem; }
.audit-col-remote { width: 9rem; }
.audit-mono {
    font-family: var(--font-mono, monospace);
    font-size: .85rem;
}
.audit-action-code {
    font-size: .75rem;
    color: var(--muted);
}
.audit-metadata {
    font-family: var(--font-mono, monospace);
    font-size: .8rem;
    white-space: pre-wrap;
    word-break: break-word;
}
</style>
#endexport
#endextend
