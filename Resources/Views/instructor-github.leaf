#extend("base"):
#export("title"):
GitHub
#endexport
#export("content"):
#extend("_instructor-tabs")

#if(!hasActiveCourse):
<section class="page-section">
    <p class="empty">Select a course to set up its GitHub organization.</p>
</section>
#else:

<section class="page-section">
    <h2>GitHub organization — #(courseCode)</h2>
    #if(organization):
    <dl class="detail-grid">
        <dt>Organization</dt>
        <dd><a href="#(organization.url)">#(organization.login)</a></dd>
    </dl>
    #if(organization.forksAllowed):
    <div class="flash flash-warning" role="status">Members of this organization can fork private repositories. Turn off private forks in its settings on GitHub.</div>
    #endif
    #if(organization.forksUnknown):
    <p class="section-note">The fork setting of this organization could not be read.</p>
    #endif
    #if(canEdit):
    <form method="post" action="/instructor/github/unbind">
        #csrfFormField()
        <div class="toolbar">
            <button class="btn action-btn action-danger" type="submit"
                    data-confirm="Unbind #(organization.login)? The course repositories stay on GitHub.">Unbind</button>
        </div>
    </form>
    #endif
    #else:
    <p class="empty">No organization is bound.</p>
    <p class="section-note">Course repositories are made in an organization that an owner binds to this course. First <a href="#(installURL)">install the GitHub App on the organization</a>.</p>
    #if(canEdit):
    <form method="post" action="/instructor/github/bind" class="form-stack">
        #csrfFormField()
        <label class="form-label">
            Organization
            <input class="form-input" type="text" name="organization" value="#(organizationText)"
                   placeholder="uwaterloo-cs" required>
        </label>
        <div class="toolbar">
            <button class="btn btn-primary" type="submit">Bind on GitHub</button>
        </div>
    </form>
    #endif
    #endif
</section>

#if(organization):
<section class="page-section">
    <h2>Templates</h2>
    #if(templatesUnavailable):
    <p class="section-note">The template list could not be read from GitHub.</p>
    #endif
    #if(count(assignments) == 0):
    <p class="empty">No assignment accepts GitHub submission.</p>
    <p class="section-note">Turn it on in an assignment's Student Options.</p>
    #else:
    <table class="results-table">
        <thead>
            <tr>
                <th>Assignment</th>
                <th>Template</th>
                <th>Repositories</th>
            </tr>
        </thead>
        <tbody>
        #for(row in assignments):
            <tr>
                <td>#(row.title)</td>
                <td>
                    #if(canEdit):
                    <form method="post" action="/instructor/github/templates" class="inline-form">
                        #csrfFormField()
                        <input type="hidden" name="testSetupID" value="#(row.testSetupID)">
                        <select class="form-input" name="templateID" aria-label="Template for #(row.title)">
                            #for(option in row.templateOptions):
                            <option value="#(option.value)" #if(option.selected):selected#endif>#(option.label)</option>
                            #endfor
                        </select>
                        <button class="btn action-btn" type="submit">Save</button>
                    </form>
                    #else:
                    #if(row.templateName):#(row.templateName)#else:None#endif
                    #endif
                </td>
                <td>#(row.repositoryCount)</td>
            </tr>
        #endfor
        </tbody>
    </table>
    #endif
    #if(canEdit):
    <form method="post" action="/instructor/github/archive" class="section-gap">
        #csrfFormField()
        <div class="toolbar">
            <button class="btn action-btn" type="submit"
                    data-confirm="Archive every course repository? They become read-only and stay on GitHub.">Archive repositories</button>
        </div>
    </form>
    #endif
</section>

<section class="page-section">
    <h2>Course repositories</h2>
    #if(count(repositories) == 0):
    <p class="empty">No student has made a course repository.</p>
    <p class="section-note">Students make one on the GitHub page of an assignment that has a template.</p>
    #else:
    <table class="results-table">
        <thead>
            <tr>
                <th>Assignment</th>
                <th>Student</th>
                <th>Repository</th>
                <th>Last push</th>
            </tr>
        </thead>
        <tbody>
        #for(row in repositories):
            <tr>
                <td>#(row.assignmentTitle)</td>
                <td>#(row.studentName)</td>
                <td><a href="#(row.repositoryURL)">#(row.repositoryName)</a>#if(row.archived): <span class="tier tier-closed">archived</span>#endif</td>
                #if(row.lastPushedISO):
                <td class="time js-relative-time" data-iso="#(row.lastPushedISO)">#(row.lastPushedText)</td>
                #else:
                <td>#(row.lastPushedText)</td>
                #endif
            </tr>
        #endfor
        </tbody>
    </table>
    #endif
</section>
#endif

#endif
#endexport
#endextend
