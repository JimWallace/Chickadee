#extend("base"):
#export("title"):
#if(currentUser.activeCourse):#(currentUser.activeCourse.code) — #(currentUser.activeCourse.name)#else:Assignments#endif
#endexport
#export("content"):
#extend("_instructor-tabs")
#if(currentUser.activeCourse):
<h2 class="page-heading">#(currentUser.activeCourse.code) — #(currentUser.activeCourse.name)</h2>
#else:
<h2 class="page-heading">Assignments</h2>
#endif
<section class="diagnostics-section">
    <div class="diagnostics-cards">
        <div class="diagnostic-card diagnostic-card-cyclable" data-idash-card="submissions"
                 role="button" tabindex="0"
                 aria-label="Submissions, last 24 hours. Press to change time window.">
            <div class="diagnostic-label"><span class="diagnostic-window-chip">24h</span> Submissions</div>
            <div class="diagnostic-value" id="idash-submissions">—</div>
            <div class="diagnostic-spark" aria-hidden="true"></div>
        </div>
        <div class="diagnostic-card diagnostic-card-cyclable" data-idash-card="activeStudents"
                 role="button" tabindex="0"
                 aria-label="Active students, last 24 hours. Press to change time window.">
            <div class="diagnostic-label"><span class="diagnostic-window-chip">24h</span> Active Students</div>
            <div class="diagnostic-value" id="idash-active-students">—</div>
            <div class="diagnostic-spark" aria-hidden="true"></div>
        </div>
        <div class="diagnostic-card diagnostic-card-cyclable" data-idash-card="activeAssignments"
                 role="button" tabindex="0"
                 aria-label="Active assignments, last 24 hours. Press to change time window.">
            <div class="diagnostic-label"><span class="diagnostic-window-chip">24h</span> Active Assignments</div>
            <div class="diagnostic-value" id="idash-active-assignments">—</div>
            <div class="diagnostic-spark" aria-hidden="true"></div>
        </div>
        <div class="diagnostic-card diagnostic-card-cyclable" data-idash-card="browserErrors"
                 role="button" tabindex="0"
                 aria-label="Browser errors, last 24 hours. Press to change time window.">
            <div class="diagnostic-label"><span class="diagnostic-window-chip">24h</span> Browser Errors</div>
            <div class="diagnostic-value" id="idash-browser-errors">—</div>
            <div class="diagnostic-spark" aria-hidden="true"></div>
        </div>
    </div>
</section>
<div class="section-toolbar">
    <!-- Add Section inline form -->
    <details class="add-section-details popup-anchor" id="add-section-details">
        <summary class="btn action-btn summary-btn">+ Add Section</summary>
        <div class="add-section-popup card suite-section-popup">
            <form method="post" action="/instructor/sections" class="form popup-form">
                #csrfFormField()
                <label class="form-label">
                    Section name
                    <input class="form-input editor-input" type="text" name="name" placeholder="e.g. Labs" required>
                </label>
                <label class="form-label">
                    Default grading mode
                    <select class="form-input editor-input" name="defaultGradingMode">
                        <option value="worker">Chickadee</option>
                        <option value="browser">Student Browser</option>
                    </select>
                </label>
                <button class="btn btn-primary btn-compact" type="submit">Create section</button>
            </form>
        </div>
    </details>
</div>

#if(showEmptyMessage):
<p class="empty">No assignments yet. <a href="/instructor/new">Create one to get started.</a></p>
#else:

<!-- Sections -->
<div id="sections-container">
#for(section in sections):
<div class="section-block" data-section-id="#(section.sectionID)">
    <div class="section-header">
        <span class="section-drag-handle" title="Drag to reorder section" aria-hidden="true">⋮⋮</span>

        <!-- View mode -->
        <div class="section-view">
            <strong>#(section.name)</strong>
            <span class="section-mode-note">tested in #if(section.defaultGradingMode == "worker"):Chickadee#else:Student Browser#endif</span>
            <button class="btn-link js-section-edit-toggle icon-btn-text" type="button"
                    title="Edit section" aria-label="Edit section">
                <svg class="icon" aria-hidden="true"><use href="#i-pencil"/></svg>
            </button>
            <a class="btn action-btn section-action section-action--push" href="/instructor/new?sectionID=#(section.sectionID)">+ Create New</a>
        </div>

        <!-- Edit mode (hidden by default) -->
        <div class="section-edit" style="display:none">
            <form class="section-rename-form" method="post" action="/instructor/sections/#(section.sectionID)/rename">
                #csrfFormField()
                <input class="form-input section-name-input" type="text" name="name" value="#(section.name)" required>
                <select class="form-input grading-mode-select" name="defaultGradingMode">
                    <option value="worker" #if(section.defaultGradingMode == "worker"):selected#endif>Chickadee</option>
                    <option value="browser" #if(section.defaultGradingMode == "browser"):selected#endif>Student Browser</option>
                </select>
                <button class="btn btn-primary btn-compact" type="submit">Save</button>
            </form>
            <button class="btn action-btn action-danger js-section-delete-btn" type="button"
                    data-action="/instructor/sections/#(section.sectionID)/delete"
                    data-name="#(section.name)">Delete</button>
            <button class="btn-link js-section-edit-cancel icon-btn-text" type="button"
                    aria-label="Cancel" title="Cancel">✕</button>
        </div>
    </div>

    <!-- Toolbar: add ungraded reference material to this section (interleaved
         with the assignments in the drag-orderable table below). -->
    <div class="content-lane">
        <details class="add-section-details popup-anchor">
            <summary class="btn action-btn summary-btn">+ Add material</summary>
            <div class="add-section-popup card">
                <form method="post" action="/instructor/content-items" enctype="multipart/form-data" class="form popup-form">
                    #csrfFormField()
                    <input type="hidden" name="sectionID" value="#(section.sectionID)">
                    <label class="form-label">Title
                        <input class="form-input editor-input" type="text" name="title" placeholder="e.g. Lecture 1" required>
                    </label>
                    <label class="form-label">Type
                        <select class="form-input editor-input" name="kind">
                            <option value="link">Link</option>
                            <option value="notebook">Notebook</option>
                            <option value="document">Document</option>
                            <option value="slides">Slides</option>
                            <option value="outline">Outline</option>
                            <option value="heading">Heading</option>
                        </select>
                    </label>
                    <div class="content-item-link-fields">
                        <span class="content-item-link-pair">
                            <input class="form-input editor-input" type="text" name="linkLabels[]" placeholder="Label (e.g. PDF)">
                            <input class="form-input editor-input" type="text" name="linkURLs[]" placeholder="https://…">
                        </span>
                        <span class="content-item-link-pair">
                            <input class="form-input editor-input" type="text" name="linkLabels[]" placeholder="Label (e.g. Notebook)">
                            <input class="form-input editor-input" type="text" name="linkURLs[]" placeholder="https://…">
                        </span>
                    </div>
                    <label class="form-label">Description
                        <input class="form-input editor-input" type="text" name="description">
                    </label>
                    <label class="form-label">Updated label
                        <input class="form-input editor-input" type="text" name="updatedLabel" placeholder="e.g. 2026-05-11">
                    </label>
                    <label class="form-label">Visibility
                        <select class="form-input editor-input" name="isPublished">
                            <option value="true">Published</option>
                            <option value="false">Hidden</option>
                        </select>
                    </label>
                    <label class="form-label">Files (optional)
                        <input class="form-input editor-input" type="file" name="attachmentFiles" multiple>
                    </label>
                    <button class="btn btn-primary btn-compact" type="submit">Add material</button>
                </form>
            </div>
        </details>
    </div>

    <table class="results-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Status</th>
                <th>Validation</th>
                <th class="due-col col-hide-phone">Due</th>
                <th class="col-hide-phone">Submissions</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody data-section-id="#(section.sectionID)">
        #if(count(section.items) == 0):
        <tr class="section-empty-row">
            <td colspan="6" class="section-empty-cell">
                Drag items here or use <a href="/instructor/new?sectionID=#(section.sectionID)">+ Create New</a>
            </td>
        </tr>
        #else:
        #for(item in section.items):
        #extend("_course-item-row")
        #endfor
        #endif
        </tbody>
    </table>
</div>
#endfor
</div><!-- #sections-container -->

<!-- Ungrouped bucket: shown when there are ungrouped items, or when no sections exist at all (flat-table mode) -->
#if(showUngroupedBlock):
<div class="dashboard-block">
    #if(hasSections):
    <h2 class="ungrouped-heading">Ungrouped</h2>
    #endif

    <!-- Toolbar: add ungraded reference material with no section (interleaved
         with the ungrouped assignments in the drag-orderable table below). -->
    <div class="content-lane">
        <details class="add-section-details popup-anchor">
            <summary class="btn action-btn summary-btn">+ Add material</summary>
            <div class="add-section-popup card">
                <form method="post" action="/instructor/content-items" enctype="multipart/form-data" class="form popup-form">
                    #csrfFormField()
                    <input type="hidden" name="sectionID" value="">
                    <label class="form-label">Title
                        <input class="form-input editor-input" type="text" name="title" placeholder="e.g. Course outline" required>
                    </label>
                    <label class="form-label">Type
                        <select class="form-input editor-input" name="kind">
                            <option value="link">Link</option>
                            <option value="notebook">Notebook</option>
                            <option value="document">Document</option>
                            <option value="slides">Slides</option>
                            <option value="outline">Outline</option>
                            <option value="heading">Heading</option>
                        </select>
                    </label>
                    <div class="content-item-link-fields">
                        <span class="content-item-link-pair">
                            <input class="form-input editor-input" type="text" name="linkLabels[]" placeholder="Label (e.g. PDF)">
                            <input class="form-input editor-input" type="text" name="linkURLs[]" placeholder="https://…">
                        </span>
                        <span class="content-item-link-pair">
                            <input class="form-input editor-input" type="text" name="linkLabels[]" placeholder="Label (e.g. Notebook)">
                            <input class="form-input editor-input" type="text" name="linkURLs[]" placeholder="https://…">
                        </span>
                    </div>
                    <label class="form-label">Description
                        <input class="form-input editor-input" type="text" name="description">
                    </label>
                    <label class="form-label">Updated label
                        <input class="form-input editor-input" type="text" name="updatedLabel" placeholder="e.g. 2026-05-11">
                    </label>
                    <label class="form-label">Visibility
                        <select class="form-input editor-input" name="isPublished">
                            <option value="true">Published</option>
                            <option value="false">Hidden</option>
                        </select>
                    </label>
                    <label class="form-label">Files (optional)
                        <input class="form-input editor-input" type="file" name="attachmentFiles" multiple>
                    </label>
                    <button class="btn btn-primary btn-compact" type="submit">Add material</button>
                </form>
            </div>
        </details>
    </div>

    #if(count(ungroupedItems) > 0):
    <table class="results-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Status</th>
                <th>Validation</th>
                <th class="due-col col-hide-phone">Due</th>
                <th class="col-hide-phone">Submissions</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="assignments-body" data-section-id="">
        #for(item in ungroupedItems):
        #extend("_course-item-row")
        #endfor
        </tbody>
    </table>
    #endif
</div>
#endif

#endif

<style>
.assignment-name-cell {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
}
.assignment-drag-handle {
    display: inline-flex;
    align-items: center;
    color: var(--gray-500);
    font-weight: 700;
    cursor: grab;
    user-select: none;
    flex: 0 0 auto;
}
.status-form {
    display: inline-flex;
    align-items: center;
}
tr.assignment-draggable.dragging {
    opacity: .55;
}
tr.assignment-draggable td {
    cursor: grab;
}
.section-empty-row td {
    cursor: default !important;
}
/* .add-section-details* and .section-block.section-dragging now live in the
   global stylesheet (shared with assignment-edit.leaf). */
</style>
<script src="/section-items-dnd.js?v=#appVersion()"></script>
<!-- Diagnostic cards, section reorder/edit/delete, copy-student-link
     buttons and the publish-form UW-date warning are wired by
     Public/assignments.js. -->
<script src="/assignments.js?v=#appVersion()"></script>
#endexport
#endextend
