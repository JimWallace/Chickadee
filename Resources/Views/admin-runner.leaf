#extend("base"):
#export("title"):
Runner #(runner.workerID)
#endexport
#export("content"):
<section class="page-section">
    <div data-runner-id="#(runner.workerID)" class="runner-header">
        <div>
            <h2 class="runner-header-title"><code>#(runner.workerID)</code> <span id="runner-offline-badge" class="runner-badge-offline" style="display:none">Offline</span></h2>
            <p class="runner-subhead">
                <span id="runner-hostname">#if(runner.hostname != ""):#(runner.hostname)#else:Unknown host#endif</span>
                ·
                <span id="runner-version">#if(runner.runnerVersion != ""):#(runner.runnerVersion)#else:Unknown version#endif</span>
            </p>
            #if(!tags.isEmpty):
            <div class="chip-row runner-tags">
                #for(tag in tags):
                <span class="chip">#(tag)</span>
                #endfor
            </div>
            #endif
        </div>
        <div class="runner-meta">
            <div><strong>Last active:</strong> <span id="runner-last-active" class="js-relative-time" data-iso="#(runner.lastActive)">#(runner.lastActive)</span></div>
            #if(firstSeenAt):<div><strong>Online since:</strong> <span class="js-relative-time" data-iso="#(firstSeenAt)">#(firstSeenAt)</span></div>#endif
            <div><strong>Capacity:</strong> #(summary.activeJobs) / #(summary.maxJobs)</div>
            <div><strong>Jobs processed:</strong> #(summary.jobsProcessed)</div>
            <div><strong>Avg run:</strong> #if(summary.avgExecutionFormatted):#(summary.avgExecutionFormatted)#else:—#endif</div>
            <div><strong>Avg wait:</strong> #if(summary.avgQueueWaitFormatted):#(summary.avgQueueWaitFormatted)#else:—#endif</div>
            <div><strong>Avg setup/other:</strong> #if(summary.avgOverheadFormatted):#(summary.avgOverheadFormatted)#else:—#endif</div>
            <div><strong>Avg cache acquire:</strong> #if(summary.avgCacheAcquireFormatted):#(summary.avgCacheAcquireFormatted)#else:—#endif</div>
            <div><strong>Cache hit rate:</strong> #if(summary.cacheHitRateFormatted):#(summary.cacheHitRateFormatted)#else:—#endif</div>
            <div><strong>Avg download:</strong> #if(summary.avgDownloadFormatted):#(summary.avgDownloadFormatted)#else:—#endif</div>
            <div><strong>Avg prep:</strong> #if(summary.avgPrepFormatted):#(summary.avgPrepFormatted)#else:—#endif</div>
        </div>
    </div>

    <div class="diagnostics-cards section-gap">
        <div class="diagnostic-card"><span class="diagnostic-label">Passed</span><span class="diagnostic-value">#(summary.passedCount)</span></div>
        <div class="diagnostic-card"><span class="diagnostic-label">Failed</span><span class="diagnostic-value">#(summary.failedCount)</span></div>
        <div class="diagnostic-card"><span class="diagnostic-label">Errored</span><span class="diagnostic-value">#(summary.errorCount)</span></div>
        <div class="diagnostic-card"><span class="diagnostic-label">Timed Out</span><span class="diagnostic-value">#(summary.timeoutCount)</span></div>
    </div>
</section>

<section class="page-section">
    <h3>Recent Jobs</h3>
    #if(recentJobs.isEmpty):
    <p class="empty">No recorded jobs for this runner yet.</p>
    #else:
    <div class="table-scroll"><table class="results-table sortable-table">
        <thead>
            <tr>
                <th data-sort-type="text"><button class="sort-header" type="button">Submission</button></th>
                <th data-sort-type="text"><button class="sort-header" type="button">User</button></th>
                <th data-sort-type="text"><button class="sort-header" type="button">Status</button></th>
                <th class="time" data-sort-type="number"><button class="sort-header" type="button">Queue Wait</button></th>
                <th class="time" data-sort-type="number"><button class="sort-header" type="button">Execution</button></th>
                <th class="time" data-sort-type="number"><button class="sort-header" type="button">Total</button></th>
                <th class="time" data-sort-type="number"><button class="sort-header" type="button">Peak Disk</button></th>
                <th class="time" data-sort-type="date"><button class="sort-header" type="button">Completed</button></th>
            </tr>
        </thead>
        <tbody>
        #for(job in recentJobs):
            <tr>
                <td data-sort-value="#(job.submissionID)"><a href="/submissions/#(job.submissionID)"><code>#(job.submissionID)</code></a></td>
                <td data-sort-value="#if(job.username):#(job.username)#else:~#endif">#if(job.username):#(job.username)#else:—#endif</td>
                <td data-sort-value="#(job.finalStatus)">#(job.finalStatus)</td>
                <td class="time" #if(job.queueWaitMs):data-sort-value="#(job.queueWaitMs)"#else:data-sort-value="-1"#endif>#if(job.queueWaitFormatted):#(job.queueWaitFormatted)#else:—#endif</td>
                <td class="time" #if(job.executionMs):data-sort-value="#(job.executionMs)"#else:data-sort-value="-1"#endif>#if(job.executionFormatted):#(job.executionFormatted)#else:—#endif</td>
                <td class="time" #if(job.totalProcessingMs):data-sort-value="#(job.totalProcessingMs)"#else:data-sort-value="-1"#endif>#if(job.totalProcessingFormatted):#(job.totalProcessingFormatted)#else:—#endif</td>
                <td class="time" #if(job.workdirPeakBytes):data-sort-value="#(job.workdirPeakBytes)"#else:data-sort-value="-1"#endif>#if(job.workdirPeakFormatted):#(job.workdirPeakFormatted)#else:—#endif</td>
                <td class="time js-relative-time" #if(job.completedAt):data-iso="#(job.completedAt)" data-sort-value="#(job.completedAt)"#else:data-sort-value=""#endif>
                    #if(job.completedAt):#(job.completedAt)#else:—#endif
                </td>
            </tr>
        #endfor
        </tbody>
    </table></div>
    #endif
</section>

<section class="page-section">
    <h3>Recent Snapshots</h3>
    #if(snapshots.isEmpty):
    <p class="empty">No heartbeat or poll snapshots recorded yet.</p>
    #else:
    <div class="table-scroll"><table class="results-table sortable-table">
        <thead>
            <tr>
                <th class="time" data-sort-type="date"><button class="sort-header" type="button">Recorded</button></th>
                <th class="time" data-sort-type="number"><button class="sort-header" type="button">Active Jobs</button></th>
                <th class="time" data-sort-type="number"><button class="sort-header" type="button">Utilization %</button></th>
                <th class="time" data-sort-type="date"><button class="sort-header" type="button">Last Poll</button></th>
            </tr>
        </thead>
        <tbody>
        #for(snapshot in snapshots):
            <tr>
                <td class="time js-relative-time" data-iso="#(snapshot.recordedAt)" data-sort-value="#(snapshot.recordedAt)">#(snapshot.recordedAt)</td>
                <td class="time" data-sort-value="#(snapshot.activeJobs)">#(snapshot.activeJobsLabel)</td>
                <td class="time" data-sort-value="#(snapshot.utilizationPercent)">#(snapshot.utilizationPercent)%</td>
                <td class="time js-relative-time" #if(snapshot.lastPollAt):data-iso="#(snapshot.lastPollAt)" data-sort-value="#(snapshot.lastPollAt)"#else:data-sort-value=""#endif>
                    #if(snapshot.lastPollAt):#(snapshot.lastPollAt)#else:—#endif
                </td>
            </tr>
        #endfor
        </tbody>
    </table></div>
    #endif
</section>

<style>
.runner-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
}
.runner-header-title {
    margin: 0;
}
.runner-subhead {
    margin: .4rem 0 0;
    color: var(--muted);
}
.runner-meta {
    min-width: 220px;
}
.runner-tags {
    margin-top: .6rem;
}
</style>
<script src="/relative-time.js?v=#appVersion()"></script>
<script>
(function () {
    'use strict';

    var offlineBadge = document.getElementById('runner-offline-badge');

    // Show/hide the offline badge based on how recently the runner checked in.
    function updateOfflineBadge() {
        if (offlineBadge) {
            var laEl = document.getElementById('runner-last-active');
            var laIso = laEl ? laEl.getAttribute('data-iso') : null;
            var laMs = laIso ? new Date(laIso).getTime() : 0;
            var isOffline = laMs > 0 && (Date.now() - laMs) > 5 * 60 * 1000;
            offlineBadge.style.display = isOffline ? '' : 'none';
        }
    }
    ChickadeeRelativeTime.applyRelativeTimes();
    updateOfflineBadge();

    // Poll the runners endpoint every 5 seconds and update the live-status
    // fields in the header (version, hostname, last active) without a full
    // page reload. This mirrors what the main /admin page already does.
    var RUNNER_ID = (document.querySelector('[data-runner-id]') || {})
        .getAttribute ? document.querySelector('[data-runner-id]').getAttribute('data-runner-id') : '';

    setInterval(function () {
        if (document.hidden) return;
        ChickadeeRelativeTime.applyRelativeTimes();
        updateOfflineBadge();
        if (!RUNNER_ID) return;
        fetch('/admin/runners', { headers: { 'Accept': 'application/json', 'X-Background-Refresh': '1' }, cache: 'no-store' })
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (rows) {
                if (!Array.isArray(rows)) return;
                var runner = rows.find(function (w) { return w.workerID === RUNNER_ID; });
                if (!runner) return;
                var vEl  = document.getElementById('runner-version');
                var hEl  = document.getElementById('runner-hostname');
                var laEl = document.getElementById('runner-last-active');
                if (vEl)  vEl.textContent = runner.runnerVersion || 'Unknown version';
                if (hEl)  hEl.textContent = runner.hostname      || 'Unknown host';
                if (laEl && runner.lastActive) {
                    laEl.setAttribute('data-iso', runner.lastActive);
                    laEl.textContent = ChickadeeRelativeTime.formatRelative(runner.lastActive);
                    laEl.title = new Date(runner.lastActive).toLocaleString();
                }
            })
            .catch(function () {});
    }, 5000);
})();
</script>
<script src="/sortable-table.js?v=#appVersion()"></script>
#endexport
#endextend
