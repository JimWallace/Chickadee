#extend("base"):
#export("title"):
Import result — Admin
#endexport
#export("content"):
<div class="page-titlebar">
    <div class="toolbar">
        <h1>Bundle imported</h1>
        <span class="tier tier-open">success</span>
    </div>
</div>

<section class="page-section">
    <h2>#(courseCode)#if(termLabel): #(termLabel)#endif — #(courseName)</h2>
    #if(termLabel):#else:
    <div class="flash flash-warning" role="status">The bundle has no year and term. Set them on the <a href="/admin/courses/#(courseID)">course page</a>.</div>
    #endif
    <div class="card section-gap">
    <dl class="detail-grid">
        <dt>Test setups</dt>
        <dd>#(testSetupsImported)</dd>
        <dt>Assignments</dt>
        <dd>#(assignmentsImported)</dd>
        <dt>Users matched</dt>
        <dd>#(usersMatched)</dd>
        <dt>Users created</dt>
        <dd>#(usersCreated)</dd>
        <dt>Submissions</dt>
        <dd>#(submissionsImported)</dd>
        <dt>Results</dt>
        <dd>#(resultsImported)</dd>
    </dl>
    </div>
    <p class="section-note">Assignments keep their open or closed state; validation is reset, so re-run it from each assignment page.</p>
    #if(usersCreated > 0):
    <p class="section-note">New accounts have no password; they sign in through SSO or a password reset.</p>
    #endif
    <div class="toolbar">
        <a href="/admin/courses/#(courseID)" class="btn btn-primary">View course</a>
        <a href="/admin" class="btn">Admin dashboard</a>
    </div>
</section>
#endexport
#endextend
