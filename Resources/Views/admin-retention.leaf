#extend("base"):
#export("title"):
Retention
#endexport
#export("content"):
<p class="admin-version-banner">Chickadee v#appVersion()</p>
#extend("_admin-tabs")
<section class="page-section">
    <p class="page-crumb">Data</p>
    <div class="page-titlebar">
        <h2>Retention <span class="text-muted">#count(rows) archived · #(deletableCount) eligible to delete</span></h2>
    </div>
    <p class="section-intro">Archived courses can be restored at any time. #(retentionDays) days after archiving, an admin may permanently delete one, which can&rsquo;t be undone.</p>

    #if(count(rows) == 0):
    <p class="text-muted">No archived courses. The retention clock starts when a course is archived.</p>
    #else:
    <!-- Server order: delete-eligible courses first, then the soonest to become
         eligible. The list is short and already in the order an admin acts in. -->
    <table class="results-table section-items section-items--manage">
        <colgroup>
            <col class="section-items-tile"><col><col class="section-items-status"><col class="section-items-actions">
        </colgroup>
        <thead class="visually-hidden">
            <tr><th scope="col">Course</th><th scope="col">Detail</th><th scope="col">Status</th><th scope="col">Actions</th></tr>
        </thead>
        <tbody>
            #for(row in rows):
            <tr>
                <td class="item-tile-cell"><span class="item-tile"><svg class="icon" aria-hidden="true"><use href="#i-archive"/></svg></span></td>
                <td class="item-main">
                    <div class="item-title"><a href="/admin/courses/#(row.id)"><strong>#(row.code)</strong></a> — #(row.name)</div>
                    <div class="item-details">#if(row.termLabel):#(row.termLabel) · #endif archived #(row.archivedAt) · #(row.submissionCount) submissions</div>
                </td>
                <td class="item-status">
                    #if(row.isDeletable):
                    <span class="tier tier-danger">Eligible to delete</span>
                    #else:
                    <span class="tier tier-closed">Deletable #(row.purgeEligibleAt)</span>
                    #endif
                </td>
                <td class="item-actions-td">
                    <div class="assignment-actions-cell">
                        <form method="post" action="/admin/courses/#(row.id)/archive" class="inline-form">
                            #csrfFormField()
                            <button class="btn action-btn action-btn-icon" type="submit"
                                    title="Restore course" aria-label="Restore #(row.code)"
                                    data-confirm="Restore #(row.code)? Students regain access immediately. Its submissions are kept and the retention clock stops.">
                                <svg class="icon" aria-hidden="true"><use href="#i-rewind"/></svg>
                            </button>
                        </form>
                        <a class="btn action-btn action-btn-icon" href="/admin/courses/#(row.id)/export"
                           title="Export course bundle" aria-label="Export #(row.code)">
                            <svg class="icon" aria-hidden="true"><use href="#i-download"/></svg>
                        </a>
                        #if(row.isDeletable):
                        <details class="ext-details row-menu">
                            <summary class="btn action-btn action-btn-icon ext-summary" title="More actions" aria-label="More actions for #(row.code)">
                                <svg class="icon" aria-hidden="true"><use href="#i-more"/></svg>
                            </summary>
                            <div class="popover-panel row-menu-panel" role="menu">
                                <form method="post" action="/admin/courses/#(row.id)/delete"
                                      data-confirm="Permanently delete #(row.code)? Its course record, assignments, test suites and every submission are erased. This cannot be undone.">
                                    #csrfFormField()
                                    <button class="row-menu-item row-menu-item--danger" type="submit" role="menuitem">
                                        <svg class="icon" aria-hidden="true"><use href="#i-trash"/></svg>Delete course permanently
                                    </button>
                                </form>
                            </div>
                        </details>
                        #else:
                        <span class="row-menu-spacer" aria-hidden="true"></span>
                        #endif
                    </div>
                </td>
            </tr>
            #endfor
        </tbody>
    </table>
    #endif
</section>
#endexport
#endextend
