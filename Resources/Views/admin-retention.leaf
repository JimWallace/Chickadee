#extend("base"):
#export("title"):
Retention
#endexport
#export("content"):
<p class="admin-version-banner">Chickadee v#appVersion()</p>
#extend("_admin-tabs")
<section class="page-section">
    #extend("_flash")

    <p class="section-intro">
        Archived courses can be restored at any time. #(retentionDays) days
        after a course is archived, an admin may permanently delete it and all
        its data. <strong>Deletion cannot be undone.</strong>
    </p>

    #if(rows.isEmpty):
    <p class="text-muted">No archived courses. The retention clock starts when a course is archived.</p>
    #else:
    #if(deletableCount > 0):
    <p class="text-muted">#(deletableCount) course(s) past retention and eligible to delete.</p>
    #endif
    <div class="table-scroll"><table class="results-table sortable-table">
        <thead>
            <tr>
                <th data-sort-type="text"><button class="sort-header" type="button">Code</button></th>
                <th data-sort-type="text"><button class="sort-header" type="button">Name</button></th>
                <th data-sort-type="date" class="retention-col-date"><button class="sort-header" type="button">Archived</button></th>
                <th data-sort-type="number" class="retention-col-subs"><button class="sort-header" type="button">Submissions</button></th>
                <th data-sort-type="date" class="retention-col-date"><button class="sort-header" type="button">Delete eligible</button></th>
                <th class="retention-col-action">Action</th>
            </tr>
        </thead>
        <tbody>
            #for(row in rows):
            <tr class="#if(row.isDeletable):status-closed#else:status-open#endif">
                <td><a href="/admin/courses/#(row.id)"><strong>#(row.code)</strong></a></td>
                <td>#(row.name)</td>
                <td class="retention-date-cell" data-sort-value="#(row.archivedAtISO)">#(row.archivedAt)</td>
                <td>#(row.submissionCount)</td>
                <td class="retention-date-cell" data-sort-value="#(row.purgeEligibleAtISO)">
                    #if(row.isDeletable):
                    <span class="tier tier-closed">eligible</span>
                    #else:
                    #(row.purgeEligibleAt)
                    #endif
                </td>
                <td>
                    <div class="retention-actions">
                        <form method="post" action="/admin/courses/#(row.id)/archive" class="inline-form">
                            #csrfFormField()
                            <button class="btn action-btn action-btn-icon" type="submit"
                                    title="Restore course" aria-label="Restore course"
                                    data-confirm="Restore #(row.code)? Students will be able to see it again and its retention clock resets.">
                                <svg class="icon" aria-hidden="true"><use href="#i-rewind"/></svg>
                            </button>
                        </form>
                        <a class="btn action-btn action-btn-icon" href="/admin/courses/#(row.id)/export"
                           title="Export course bundle" aria-label="Export course bundle">
                            <svg class="icon" aria-hidden="true"><use href="#i-download"/></svg>
                        </a>
                        #if(row.isDeletable):
                        <form method="post" action="/admin/courses/#(row.id)/delete" class="inline-form">
                            #csrfFormField()
                            <button class="btn action-btn action-danger action-btn-icon" type="submit"
                                    title="Delete course" aria-label="Delete course"
                                    data-confirm="Permanently delete #(row.code) and ALL its data — course, assignments, test suites, and submissions? This cannot be undone.">
                                <svg class="icon" aria-hidden="true"><use href="#i-trash"/></svg>
                            </button>
                        </form>
                        #endif
                    </div>
                </td>
            </tr>
            #endfor
        </tbody>
    </table></div>
    #endif
</section>
<style>
.retention-col-date {
    width: 11rem;
}
.retention-col-subs {
    width: 7rem;
}
.retention-col-action {
    width: 11rem;
}
.retention-date-cell {
    font-size: var(--text-base);
}
.retention-actions {
    display: flex;
    gap: .4rem;
    flex-wrap: nowrap;
}
@media (max-width: 640px) {
    .retention-actions { flex-wrap: wrap; }
}
</style>
<script src="/sortable-table.js?v=#appVersion()"></script>
#endexport
#endextend
