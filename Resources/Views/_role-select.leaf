<form method="post" action="#(action)" class="inline-form form-flush">
    #csrfFormField()
    <label class="visually-hidden" for="role-#(userID)">Role for #(personName)</label>
    <span class="state-select" data-state="#(role)">
        <select id="role-#(userID)" name="role" class="form-input" data-ck-submit-on-change>
            <option value="student"#if(role == "student"): selected#endif>Student</option>
            <option value="ta"#if(role == "ta"): selected#endif>TA</option>
            <option value="instructor"#if(role == "instructor"): selected#endif>Instructor</option>
        </select>
    </span>
</form>
