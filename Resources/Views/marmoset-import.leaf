#extend("base"):
#export("title"):
Import from Marmoset — #(courseCode)
#endexport
#export("content"):
<div class="page-titlebar marmoset-titlebar">
    <h1>Import from Marmoset</h1>
    <span class="marmoset-course-name">#(courseCode) — #(courseName)</span>
</div>

#if(error):
<div class="form-error section-gap">#(error)</div>
#endif

<section class="admin-section">
    <h2>Upload Marmoset export</h2>
    <p class="marmoset-intro">
        Upload a Marmoset course export zip (e.g. <code>COURSE-export.zip</code>).
        One assignment will be created for each project found in the archive.
        Assignments will be closed and require validation before opening.
    </p>
    <form method="post"
          action="/instructor/import-marmoset"
          enctype="multipart/form-data"
          class="marmoset-upload-form">
        #csrfFormField()
        #if(sectionID):
        <input type="hidden" name="sectionID" value="#(sectionID)">
        #endif
        <label class="form-label">
            Marmoset export zip
            <input class="form-input marmoset-file-input" type="file" name="file" accept=".zip" required>
        </label>
        <div class="marmoset-form-buttons">
            <button class="btn btn-primary" type="submit">Import</button>
            <a href="/instructor" class="btn">Cancel</a>
        </div>
    </form>
</section>

<section class="admin-section marmoset-imported-section">
    <h2>What gets imported</h2>
    <table class="results-table marmoset-imported-table">
        <thead>
            <tr>
                <th>Marmoset file</th>
                <th>Chickadee action</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><code>&lt;n&gt;-test-setup.zip</code></td>
                <td>Creates a test setup. <code>test.properties</code> is converted to a Chickadee manifest; all other files are kept.</td>
            </tr>
            <tr>
                <td><code>&lt;n&gt;-canonical.zip</code></td>
                <td>Stored for download. Use it on the validate page to run the test suite against the reference solution.</td>
            </tr>
            <tr>
                <td><code>&lt;n&gt;-project-starter-files.zip</code></td>
                <td>If a <code>.ipynb</code> is found, it becomes the JupyterLite notebook for the assignment.</td>
            </tr>
            <tr>
                <td><code>&lt;n&gt;.project.out</code></td>
                <td>Assignment title is extracted if possible; otherwise defaults to "Imported Assignment N".</td>
            </tr>
        </tbody>
    </table>
    <p class="marmoset-footnote">
        After import, edit each assignment to set <strong>requiredFiles</strong>
        (the file students must submit) and then run validation before opening.
    </p>
</section>
<style>
.marmoset-titlebar { margin-bottom: 1.5rem; }
.marmoset-course-name { color: var(--text-secondary); }
.marmoset-intro { margin-bottom: 1rem; color: var(--text-secondary); font-size: .9rem; }
.marmoset-upload-form { display: flex; flex-direction: column; gap: 1rem; max-width: 480px; }
.marmoset-file-input { display: block; margin-top: .25rem; }
.marmoset-form-buttons { display: flex; gap: .75rem; }
.marmoset-imported-section { margin-top: 1.5rem; }
.marmoset-imported-table { max-width: 640px; }
.marmoset-footnote { margin-top: .75rem; color: var(--text-secondary); font-size: .85rem; }
</style>
#endexport
#endextend
