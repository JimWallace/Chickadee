#extend("base"):
#export("title"):
Server Health Alerts
#endexport
#export("content"):
<p class="admin-version-banner">Chickadee v#appVersion()</p>
#extend("_admin-tabs")
<section class="page-section">
    <div class="page-titlebar">
        <h2>Health alerts #if(enabled):<span class="tier tier-open">Enabled</span>#else:<span class="tier tier-closed">Disabled</span>#endif</h2>
        <form method="post" action="/admin/alerts/test" class="form-flush">
            #csrfFormField()
            <button class="btn action-btn" type="submit">Send test alert</button>
        </form>
    </div>

    #if(!enabled):
    <div class="flash flash-warning" role="status">
        <strong>Alerting is off.</strong> Set <code>ALERT_ENABLED=1</code> and restart to evaluate rules.
    </div>
    #endif

    <div class="card section-gap">
        <div class="facts-actions">
            <details class="add-section-details popup-anchor">
                <summary class="btn action-btn summary-btn">Edit webhook <svg class="icon" aria-hidden="true"><use href="#i-chevron-down"/></svg></summary>
                <div class="add-section-popup card suite-section-popup" role="dialog" aria-label="Edit webhook">
                    <form method="post" action="/admin/alerts/config" class="form popup-form">
                        #csrfFormField()
                        <label class="form-label" for="alert-webhook">
                            Webhook URL
                            <input id="alert-webhook" class="form-input" type="url" name="webhookURL"
                                   value="#(webhookURL)" placeholder="https://hooks.slack.com/services/…">
                            <span class="field-note field-note--muted">Alerts POST here as they fire and resolve.</span>
                        </label>
                        <div class="toolbar">
                            <button class="btn btn-primary btn-compact" type="submit">Save webhook</button>
                        </div>
                    </form>
                </div>
            </details>
        </div>
        <dl class="detail-grid">
            <dt>Webhook</dt>
            <dd><code>#(webhookDisplay)</code>#if(webhookURLFromEnvironment): <span class="card-meta">A fallback is set in <code>ALERT_WEBHOOK_URL</code></span>#endif</dd>
            <dt>Last delivery</dt>
            <dd>#if(hasLastDelivery):#(lastDeliveryResult) <span class="card-meta js-relative-time" data-iso="#(lastDeliveryISO)">#(lastDeliveryISO)</span>#else:No deliveries yet#endif</dd>
        </dl>
    </div>
</section>

<section class="page-section">
    <h2>Rules</h2>
    <table class="results-table section-items section-items--manage">
        <colgroup>
            <col class="section-items-tile"><col><col class="section-items-count"><col class="section-items-seen col-hide-phone">
        </colgroup>
        <thead class="visually-hidden">
            <tr><th scope="col">Rule</th><th scope="col">Condition</th><th scope="col">Status</th><th scope="col">Last fired</th></tr>
        </thead>
        <tbody>
        #for(rule in rules):
            <tr>
                <td class="item-tile-cell"><span class="item-tile" data-kind="#if(rule.isFiring):alert#else:ok#endif"><svg class="icon" aria-hidden="true"><use href="#i-bell"/></svg></span></td>
                <td>
                    <div class="item-title">#(rule.humanReadable)</div>
                    <div class="item-details">#(rule.thresholdText) · <code>#(rule.rule)</code></div>
                </td>
                <td>
                    #if(rule.isFiring):
                    <span class="tier tier-danger">Firing</span>
                    #else:
                    <span class="tier tier-open">OK</span>
                    #endif
                </td>
                <td class="col-hide-phone">
                    #if(rule.lastFiredAt):
                    <span class="js-relative-time" data-iso="#(rule.lastFiredAt)">#(rule.lastFiredAt)</span>
                    #else:
                    Never
                    #endif
                    <div class="item-details">last fired</div>
                </td>
            </tr>
        #endfor
        </tbody>
    </table>
</section>

<section class="page-section">
    <h2>Recent firings</h2>
    #if(firingCount == 0):
    <p class="empty">No alerts have fired since startup.</p>
    #else:
    <!-- The audit log's shape: when, what, how it went.  The actor is left out,
         because a rule fires itself and a column reading "system" on every row
         carries no information.  The summary is the reading a firing exists to
         deliver ("queue backed up: 64 pending"); how it was delivered is one
         line under it, in red when the page did not reach the operator.  When
         stays relative: a firing is operational activity where recency is the
         question, and the audit log is the forensic table that carries the
         absolute instant. -->
    <table class="results-table section-items section-items--manage">
        <colgroup>
            <col class="section-items-tile"><col><col class="section-items-count"><col class="section-items-seen col-hide-phone">
        </colgroup>
        <thead class="visually-hidden">
            <tr><th scope="col">Event</th><th scope="col">Summary</th><th scope="col">Outcome</th><th scope="col">When</th></tr>
        </thead>
        <tbody>
        #for(day in firingDays):
            <tr class="section-items-heading">
                <td colspan="4"><strong>#(day.label)</strong></td>
            </tr>
            #for(firing in day.rows):
            <tr>
                <td class="item-tile-cell"><span class="item-tile" data-kind="#if(firing.resolved):ok#else:alert#endif"><svg class="icon" aria-hidden="true"><use href="#i-bell"/></svg></span></td>
                <td>
                    <div class="item-title">#(firing.summary)</div>
                    <div class="item-details#if(firing.deliveryFailed): item-details--danger#endif"><code>#(firing.rule)</code> · #(firing.deliveryText)</div>
                </td>
                <td>
                    #if(firing.resolved):
                    <span class="tier tier-open">Resolved</span>
                    #else:
                    <span class="tier tier-danger">Fired</span>
                    #endif
                </td>
                <td class="col-hide-phone js-relative-time" data-iso="#(firing.firedAt)">#(firing.firedAt)</td>
            </tr>
            #endfor
        #endfor
        </tbody>
    </table>
    #endif
</section>
#endexport
#endextend
