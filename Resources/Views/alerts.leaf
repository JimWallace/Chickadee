#extend("base"):
#export("title"):
Server Health Alerts
#endexport
#export("content"):
<p class="admin-version-banner">Chickadee v#appVersion()</p>
#extend("_admin-tabs")
<section class="page-section">

    #if(!enabled):
    <div class="flash flash-neutral" role="status">
        Alerting is currently <strong>disabled</strong>.  Set <code>ALERT_ENABLED=1</code> in the
        environment and restart the server to begin evaluating rules.
    </div>
    #endif

    <h2>Webhook</h2>
    <form method="post" action="/admin/alerts/config" class="form-stack section-gap">
        #csrfFormField()
        <div class="field-stack">
            <label for="alert-webhook">Webhook URL</label>
            <input id="alert-webhook"
                   class="form-input"
                   type="url"
                   name="webhookURL"
                   value="#(webhookURL)"
                   placeholder="https://hooks.slack.com/services/…">
            <p class="field-note">Alerts POST here as they fire and resolve.</p>
            #if(webhookURLFromEnvironment):
            <p class="field-note">A fallback URL is also set in the environment as <code>ALERT_WEBHOOK_URL</code>.</p>
            #endif
        </div>
        <div class="toolbar toolbar--end">
            <button class="btn btn-primary" type="submit">Save webhook</button>
        </div>
    </form>
    <form method="post" action="/admin/alerts/test" class="alerts-test-form">
        #csrfFormField()
        <button class="btn" type="submit">Send test alert</button>
    </form>

    <h2>Rules</h2>
    <div class="table-scroll"><table class="results-table">
        <thead>
            <tr>
                <th>Rule</th>
                <th>Threshold</th>
                <th>Status</th>
                <th class="time">Last fired</th>
            </tr>
        </thead>
        <tbody>
        #for(rule in rules):
            <tr>
                <td>
                    <strong>#(rule.humanReadable)</strong><br>
                    <code class="alerts-rule-code">#(rule.rule)</code>
                </td>
                <td>
                    #if(rule.rule == "runnerOffline"):
                        no runner heartbeat for #(runnerOfflineSeconds)s
                    #elseif(rule.rule == "queueBackedUp"):
                        ≥ #(queueDepthThreshold) pending OR oldest > #(oldestPendingSeconds)s
                    #elseif(rule.rule == "errorRateSpike"):
                        ≥ #(errorRatePercent)% errors+timeouts in last 50 jobs
                    #elseif(rule.rule == "databaseUnreachable"):
                        SELECT 1 fails
                    #endif
                </td>
                <td>
                    #if(rule.isFiring):
                        <span class="tier tier-danger">FIRING</span>
                    #else:
                        <span class="tier tier-open">ok</span>
                    #endif
                </td>
                <td class="time js-relative-time" data-iso="#(rule.lastFiredAt)">
                    #if(rule.lastFiredAt):#(rule.lastFiredAt)#else:—#endif
                </td>
            </tr>
        #endfor
        </tbody>
    </table></div>

    <h2 class="alerts-recent-heading">Recent firings</h2>
    #if(count(recentFirings) == 0):
    <p class="empty">No alerts have fired since startup.</p>
    #else:
    <!-- The audit log's shape — when, what, how it went, payload — minus the
         actor column, because a rule fires itself and a column reading "system"
         on every row carries no information.  Two log tables share a shape by
         asking the same questions, not by having the same column count.

         The summary is the reading a firing exists to deliver ("queue backed
         up: 64 pending"), so it stays on the page; the payload row holds the
         delivery mechanics, which are what an operator checks only when the
         page did not reach them.  WHEN stays relative-only: a firing is
         operational activity where recency is the question, and the audit log
         is the forensic table that carries the absolute instant. -->
    <div class="table-scroll"><table class="results-table">
        <thead>
            <tr>
                <th class="time">When</th>
                <th>Event</th>
                <th>Outcome</th>
                <th>Summary</th>
            </tr>
        </thead>
        <tbody>
        #for(firing in recentFirings):
            <tr>
                <td class="time js-relative-time" data-iso="#(firing.firedAt)">#(firing.firedAt)</td>
                <td><code>#(firing.rule)</code></td>
                <td>
                    #if(firing.resolved):
                        <span class="tier tier-open">resolved</span>
                    #else:
                        <span class="tier tier-danger">fired</span>
                    #endif
                </td>
                <td>#(firing.summary)</td>
            </tr>
            <tr class="test-output-row">
                <td colspan="4">
                    <details class="test-output-details">
                        <summary>Payload</summary>
                        <dl class="detail-grid log-payload">
                            <dt>Delivery</dt>
                            <dd>
                                #if(firing.paged):
                                    #if(firing.delivered):
                                        delivered
                                    #else:
                                        <span class="text-error">failed</span>
                                        #if(firing.deliveryError):<br><code class="alerts-delivery-error">#(firing.deliveryError)</code>#endif
                                    #endif
                                #else:
                                    advisory — not paged
                                #endif
                            </dd>
                        </dl>
                    </details>
                </td>
            </tr>
        #endfor
        </tbody>
    </table></div>
    #endif
</section>
<style>
.alerts-test-form { margin-bottom: 1.5rem; }
.alerts-rule-code { font-size: .8em; color: var(--muted); }
.alerts-recent-heading { margin-top: 1.5rem; }
.alerts-delivery-error { font-size: .75em; color: var(--muted); }
</style>
#endexport
#endextend
