#extend("base"):
#export("title"):
#(assignmentTitle) — Submissions
#endexport
#export("content"):
<div class="page-titlebar">
    <h1>#(assignmentTitle)</h1>
</div>

<section class="diagnostics-section">
    #extend("_diagnostic-cards")
</section>

#if(hasCoverage):
<section class="page-section">
    <div class="editor-block-head">
        <h2>Bug coverage</h2>
        <span class="chip">#(coverageSummary)</span>
    </div>
    <div class="table-scroll">
        <table class="results-table">
            <thead>
                <tr>
                    <th>Item</th>
                    <th>Status</th>
                    <th>First found by</th>
                    <th class="col-hide-phone">When</th>
                </tr>
            </thead>
            <tbody>
            #for(row in coverageRows):
                <tr>
                    <td>#(row.item)</td>
                    <td>#if(row.found):<span class="chip chip-ok">found</span>#else:<span class="chip chip-err">not found</span>#endif</td>
                    <td>#if(row.found):#(row.foundBy)#else:—#endif</td>
                    <td class="col-hide-phone">#if(row.found):#(row.foundAt)#else:—#endif</td>
                </tr>
            #endfor
            </tbody>
        </table>
    </div>
</section>
#endif

#if(rows.isEmpty):
<p class="empty">No student users found.</p>
#else:
<div class="toolbar toolbar--end section-gap">
    <span class="filter-group">
        <label class="filter-label" for="submissions-filter">Filter</label>
        <input id="submissions-filter" class="form-input filter-input" type="search"
               placeholder="Filter by name or ID…"
               data-list-filter="assignment-submissions-table"
               data-list-filter-empty="No submissions match this filter.">
    </span>
</div>
<table class="results-table sortable-table" id="assignment-submissions-table"
       data-sort-initial="history:desc" data-sort-tiebreak="surname">
    <thead>
        <tr>
            <th data-sort-key="surname" data-sort-type="text"><button class="sort-header" type="button">Surname</button></th>
            <th data-sort-key="given_names" data-sort-type="text"><button class="sort-header" type="button">Given Names</button></th>
            <th class="col-hide-phone" data-sort-key="student_id" data-sort-type="text"><button class="sort-header" type="button">Student ID</button></th>
            <th data-sort-key="grade" data-sort-type="number"><button class="sort-header" type="button">Grade</button></th>
            <th class="col-hide-phone" data-sort-key="history" data-sort-type="date"><button class="sort-header" type="button">History</button></th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
    #for(row in rows):
        <tr>
            <td>#(row.surname)</td>
            <td>#(row.givenNames)</td>
            <td class="col-hide-phone"><strong>#(row.studentID)</strong>#if(secretRevealEnabled):#if(row.secretRevealSpent): <span title="Student spent their secret-reveal token — secret test results are visible to them">🔓</span>#endif#endif</td>
            <td>#(row.gradeText)#if(row.gradeIsOverridden):<span class="grade-override-tag" title="Grade manually overridden by an instructor">overridden</span>#endif</td>
            <td class="col-hide-phone" data-sort-value="#(row.latestSubmittedAtEpoch)">
                #if(row.submissionCount > 0):
                    <div class="submission-history-cell">
                        #if(row.hasLatestSubmission):
                            <a href="/submissions/#(row.latestSubmissionID)" class="submission-history-latest">#(row.latestSubmittedAtText)</a>
                        #endif
                        #if(row.additionalSubmissionCount > 0):
                            <a href="#(row.fullHistoryURL)" class="submission-history-more">+#(row.additionalSubmissionCount) more</a>
                        #endif
                    </div>
                #else:
                    <span class="empty">No submissions yet</span>
                #endif
            </td>
            <td>
                <div class="subm-row-actions">
                    #if(row.hasLatestSubmission):
                        <form method="post" action="/instructor/#(assignmentID)/submissions/#(row.latestSubmissionID)/retest" data-confirm="Send this submission back to the testing queue?" class="form-flush">
                            #csrfFormField()
                            <input type="hidden" name="returnTo" value="/instructor/#(assignmentID)/submissions">
                            <button class="btn action-btn action-btn-icon" type="submit"
                                    aria-label="Re-test latest submission" title="Re-test latest submission">
                                <svg class="icon" aria-hidden="true"><use href="#i-refresh"/></svg>
                            </button>
                        </form>
                    #endif
                    <details class="ext-details form-flush">
                        <summary class="btn action-btn action-btn-icon ext-summary#if(row.gradeIsOverridden): grade-override-active#endif" title="#if(row.gradeIsOverridden):Edit this student’s grade override#else:Override this student’s grade#endif" aria-label="#if(row.gradeIsOverridden):Edit grade override#else:Override grade#endif">
                            <svg class="icon" aria-hidden="true"><use href="#i-scissors"/></svg>
                        </summary>
                        <form method="post" action="/instructor/#(assignmentID)/students/#(row.studentUUID)/grade-override" class="ext-panel">
                            #csrfFormField()
                            <input type="hidden" name="returnTo" value="/instructor/#(assignmentID)/submissions">
                            <label class="ext-field-label">
                                Override grade (%)
                                <input type="number" name="overridePercent" min="0" max="100" step="1" value="#(row.gradeOverridePercent)" required class="ext-field-input">
                            </label>
                            <label class="ext-field-label">
                                Note (optional)
                                <input type="text" name="note" placeholder="Reason for override" class="ext-field-input">
                            </label>
                            <div class="ext-panel-actions">
                                <button class="btn action-btn" type="submit">Save</button>
                                #if(row.gradeIsOverridden):
                                <button class="btn action-btn" type="submit" formaction="/instructor/#(assignmentID)/students/#(row.studentUUID)/grade-override/delete" formnovalidate data-confirm="Clear this student’s grade override and revert to the auto-graded result?">Clear</button>
                                #endif
                            </div>
                        </form>
                    </details>
                    <form method="post" action="/instructor/#(assignmentID)/students/#(row.studentUUID)/reset-notebook" data-confirm="Reset this student’s working-copy notebook back to the original assignment starter? Past submissions are not affected. The student will see the fresh starter automatically on their next visit." class="form-flush">
                        #csrfFormField()
                        <input type="hidden" name="returnTo" value="/instructor/#(assignmentID)/submissions">
                        <button class="btn action-btn action-btn-icon action-danger" type="submit"
                                aria-label="Reset notebook to starter" title="Reset notebook to starter (past submissions unaffected)">
                            <svg class="icon" aria-hidden="true"><use href="#i-rewind"/></svg>
                        </button>
                    </form>
                    #if(secretRevealEnabled):#if(row.secretRevealSpent):
                    <form method="post" action="/instructor/#(assignmentID)/students/#(row.studentUUID)/regrant-reveal-token" data-confirm="Re-grant this student’s secret-reveal token? Secret test results will be hidden from them again until they spend it." class="form-flush">
                        #csrfFormField()
                        <input type="hidden" name="returnTo" value="/instructor/#(assignmentID)/submissions">
                        <button class="btn action-btn action-btn-icon" type="submit"
                                aria-label="Re-grant secret-reveal token" title="Re-grant secret-reveal token (student spent theirs)">
                            <svg class="icon" aria-hidden="true"><use href="#i-lock"/></svg>
                        </button>
                    </form>
                    #endif#endif
                </div>
            </td>
        </tr>
    #endfor
    </tbody>
</table>
#endif
<style>
.subm-row-actions {
    display: flex;
    gap: .2rem;
    flex-wrap: wrap;
    align-items: center;
}
</style>
<script src="/list-filter.js?v=#appVersion()"></script>
<script src="/sortable-table.js?v=#appVersion()"></script>
<!-- The submissions trend card is wired by
     Public/assignment-submissions.js. -->
<script src="/assignment-submissions.js?v=#appVersion()"></script>
#endexport
#endextend
