#extend("base"):
#export("title"):
#if(currentUser.activeCourse):#(currentUser.activeCourse.code) — #(currentUser.activeCourse.name)#else:Assignments#endif
#endexport
#export("content"):
#if(currentUser.activeCourse):
<h1>#(currentUser.activeCourse.code) — #(currentUser.activeCourse.name)</h1>
#else:
<h1>Assignments</h1>
#endif
#if(slipDaySummary):
<p class="text-muted slip-day-summary">#(slipDaySummary)</p>
#endif
#if(!hasAny):
#if(currentUser.activeCourse):
<p class="empty">No assignments available yet.</p>
#else:
<p class="empty">You are not enrolled in any courses.
    <a href="/account">Go to My Account</a> to see your course memberships.
</p>
#endif
#else:
#for(group in displayGroups):
#if(group.name):
<h2 class="assignment-section-heading">#(group.name)</h2>
#endif
<table class="results-table assignment-table">
    #extend("_assignment-table-head")
    <tbody>
    #for(item in group.items):
    #if(item.isContent):
        <tr class="content-item-row">
            <td>
                <span class="content-item-kind">#(item.content.kindLabel)</span>
                <span class="content-item-title">#(item.content.title)</span>
                #if(!item.content.isPublished):<span class="content-item-hidden">Hidden</span>#endif
                #if(item.content.itemDescription):<div class="content-item-desc text-muted">#(item.content.itemDescription)</div>#endif
            </td>
            <td colspan="4" class="col-hide-phone content-item-links">
                #for(link in item.content.links):<a class="content-item-link" href="#(link.url)" target="_blank" rel="noopener noreferrer">#(link.label)</a>#endfor
                #for(att in item.content.attachments):<a class="content-item-link" href="#(att.downloadURL)">#(att.displayName)</a>#endfor
            </td>
            <td class="col-hide-phone">#if(item.content.updatedLabel):#(item.content.updatedLabel)#else:<span class="text-muted">—</span>#endif</td>
        </tr>
    #else:
        <tr>
            <td>
                #if(item.setup.title):
                    <div class="assignment-title-cell">
                        <strong>#(item.setup.title)</strong>
                        #if(!item.setup.badges.isEmpty):
                        <span class="achievement-badges achievement-badges-compact">
                            #for(badge in item.setup.badges):
                            <span class="achievement-badge achievement-badge-compact" title="#(badge.tooltip)">#(badge.label)</span>
                            #endfor
                            #if(item.setup.extraBadgeCount > 0):
                            <span class="achievement-badge achievement-badge-compact achievement-badge-overflow" title="Also earned: #(item.setup.extraBadgesTooltip)">+#(item.setup.extraBadgeCount)</span>
                            #endif
                        </span>
                        #endif
                    </div>
                #else:
                <span class="text-muted">Unpublished</span>
                #endif
            </td>
            <td>
                #if(item.setup.staffOnly):
                <span class="tier tier-preview staff-only-tag" title="Visible to course staff only — students can't see this assignment yet.">preview</span>
                #elseif(item.setup.status == "extended"):
                <span class="tier tier-extended" title="Your instructor granted you a personal deadline extension — you can still submit past the class deadline.">extended</span>
                #else:
                <span class="tier
                    #if(item.setup.status == "open"):tier-open
                    #elseif(item.setup.status == "closed"):tier-closed
                    #elseif(item.setup.status == "unpublished"):tier-unpublished
                    #endif">#(item.setup.status)</span>
                #endif
            </td>
            <td class="due-col col-hide-phone">
                #if(item.setup.opensAtText):
                    <span title="This assignment opens automatically at this time.">Opens #(item.setup.opensAtText)</span>
                #elseif(item.setup.hasActiveExtension):
                    <span title="Personal deadline extension granted by your instructor.">#(item.setup.effectiveDueAtText)<br><span class="due-extension-note">(extension)</span></span>
                #elseif(item.setup.dueAt):
                    #(item.setup.dueAt)
                #else:
                    —
                #endif
            </td>
            <td>
                #if(item.setup.bestGradeText):
                    <strong>#(item.setup.bestGradeText)</strong>
                    #if(item.setup.gradeIsOverridden):
                    <span class="grade-override-tag" title="Your grade was set by your instructor">adjusted</span>
                    #endif
                #else:
                    <span class="empty">—</span>
                #endif
            </td>
            <td class="col-hide-phone">
                #if(item.setup.submissionCount > 0):
                    <div class="submission-history-cell">
                        #if(item.setup.hasLatestSubmission):
                            <a href="/submissions/#(item.setup.latestSubmissionID)" class="submission-history-latest">#(item.setup.latestSubmittedAtText)</a>
                        #endif
                        #if(item.setup.additionalSubmissionCount > 0):
                            <a href="#(item.setup.historyURL)" class="submission-history-more">+#(item.setup.additionalSubmissionCount) more</a>
                        #endif
                    </div>
                #else:
                    <span class="empty">—</span>
                #endif
            </td>
            <td>
                <div class="assignment-actions-cell">
                    #if(item.setup.canEdit && item.setup.submissionMode != "upload" && (item.setup.gradingMode == "browser" || item.setup.hasNotebook)):
                    <a class="btn action-btn action-btn-icon" href="#(item.setup.notebookURL)" title="Edit" aria-label="Edit">
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
                    </a>
                    #endif
                    #if(item.setup.isOpen && item.setup.gradingMode != "browser"):
                    <a class="btn action-btn action-btn-icon" href="#(item.setup.submitURL)" title="Upload" aria-label="Upload">
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="21" x2="12" y2="4"/><polyline points="6 10 12 4 18 10"/><path d="M4 21h16"/></svg>
                    </a>
                    #endif
                    #if(item.setup.isOpen && item.setup.hasNotebook && item.setup.submissionMode != "upload"):
                    <form method="post" action="/testsetups/#(item.setup.id)/reset-notebook" onsubmit="return confirm('Reset your notebook back to the original starter? This discards your current edits for this assignment. Your past submissions are not affected.')" class="inline-form">
                        #csrfFormField()
                        <button class="btn action-btn action-btn-icon action-danger" type="submit"
                                title="Reset notebook to starter (discards current edits; past submissions unaffected)"
                                aria-label="Reset notebook to starter">
                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
                        </button>
                    </form>
                    #endif
                    #if(item.setup.slipDayAvailable):
                    <a class="btn action-btn action-btn-icon" href="#(item.setup.slipDayURL)"
                       title="#(item.setup.slipDayActionLabel)"
                       aria-label="#(item.setup.slipDayActionLabel)">
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    </a>
                    #endif
                </div>
            </td>
        </tr>
    #endif
    #endfor
    </tbody>
</table>
#endfor
#endif
#endexport
#endextend
