#extend("base"):
#export("title"):
#if(currentUser.activeCourse):#(currentUser.activeCourse.code) — #(currentUser.activeCourse.name)#else:Assignments#endif
#endexport
#export("content"):
#if(currentUser.activeCourse):
<h1>#(currentUser.activeCourse.code) — #(currentUser.activeCourse.name)</h1>
#else:
<h1>Assignments</h1>
#endif
#if(slipDaySummary):
<div class="chip-row">
    <span class="chip">#(slipDaySummary)</span>
</div>
#endif
#if(!hasAny):
#if(currentUser.activeCourse):
<div class="notice-box">
    <p class="empty">No assignments available yet.</p>
    <p class="section-note">Labs open one at a time as the term goes on.</p>
    <p><a href="/account">Check your course memberships</a></p>
</div>
#else:
<p class="empty">You are not enrolled in any courses.
    <a href="/account">Go to My Account</a> to see your course memberships.
</p>
#endif
#else:
#for(group in displayGroups):
#if(group.name):
<h2 class="assignment-section-heading">#(group.name)</h2>
#endif
#if(group.showFilter):
<div class="toolbar toolbar--end section-gap">
    <span class="filter-group">
        <label class="filter-label" for="filter-assignments-#(index)">Filter</label>
        <input id="filter-assignments-#(index)" class="form-input filter-input" type="search"
               placeholder="Filter this section…"
               data-list-filter="assignments-#(index)"
               data-list-filter-empty="No items in this section match.">
    </span>
</div>
#endif
<table class="results-table section-items" id="assignments-#(index)">
    <colgroup>
        <col class="section-items-tile"><col><col class="section-items-status">
        <col class="section-items-grade col-hide-phone"><col class="section-items-actions">
    </colgroup>
    <thead class="visually-hidden">
        <tr>
            <th scope="col">Type</th>
            <th scope="col" data-sort-key="name">Name</th>
            <th scope="col" data-sort-key="status">Status</th>
            <th scope="col" class="col-hide-phone">Grade</th>
            <th scope="col">Actions</th>
        </tr>
    </thead>
    <tbody>
    #for(item in group.items):
    #if(item.isContent):
    #if(item.content.isHeading):
        <tr class="section-items-heading">
            <td colspan="5"><strong>#(item.content.title)</strong>#if(item.content.itemDescription): <span class="text-muted">#(item.content.itemDescription)</span>#endif</td>
        </tr>
    #else:
        <tr>
            <td class="item-tile-cell"><span class="item-tile" data-kind="#(item.content.kind)"><svg class="icon" aria-hidden="true"><use href="#(item.content.iconHref)"/></svg></span></td>
            <td>
                <div class="item-title">#(item.content.title)#if(!item.content.isPublished): <span class="content-item-hidden">Hidden</span>#endif</div>
                <div class="item-details"><span class="content-item-kind" data-kind="#(item.content.kind)">#(item.content.kindLabel)</span>#if(item.content.detailsText != ""): · #(item.content.detailsText)#endif</div>
            </td>
            <td></td>
            <td class="col-hide-phone"></td>
            <td>
                <div class="assignment-actions-cell">
                    #for(action in item.content.actions):
                    <a class="btn action-btn action-btn-icon" href="#(action.href)" title="#(action.label)" aria-label="#(action.label)"#if(action.opensNewTab): target="_blank" rel="noopener noreferrer"#endif>
                        <svg class="icon" aria-hidden="true"><use href="#(action.iconHref)"/></svg>
                    </a>
                    #endfor
                </div>
            </td>
        </tr>
    #endif
    #else:
        <tr>
            <td class="item-tile-cell"><span class="item-tile" data-kind="graded"><svg class="icon" aria-hidden="true"><use href="#i-calendar-check"/></svg></span></td>
            <td>
                #if(item.setup.title):
                    <div class="assignment-title-cell">
                        <strong>#(item.setup.title)</strong>
                        #if(count(item.setup.badges) > 0):
                        <span class="achievement-badges achievement-badges-compact">
                            #for(badge in item.setup.badges):
                            <span class="achievement-badge achievement-badge-compact" title="#(badge.tooltip)">#(badge.label)</span>
                            #endfor
                            #if(item.setup.extraBadgeCount > 0):
                            <span class="achievement-badge achievement-badge-compact achievement-badge-overflow" title="Also earned: #(item.setup.extraBadgesTooltip)">+#(item.setup.extraBadgeCount)</span>
                            #endif
                        </span>
                        #endif
                    </div>
                    <div class="item-details">
                        #if(item.setup.opensAtText):
                        <span title="This assignment opens automatically at this time.">Opens #(item.setup.opensAtText)</span>
                        #elseif(item.setup.hasActiveExtension):
                        Due <span class="js-relative-time" data-iso="#(item.setup.effectiveDueAtISO)">#(item.setup.effectiveDueAtText)</span> · #(item.setup.effectiveDueAtText) <span class="due-extension-note">(extension)</span>
                        #elseif(item.setup.dueAt):
                        Due <span class="js-relative-time" data-iso="#(item.setup.dueAtISO)">#(item.setup.dueAt)</span> · #(item.setup.dueAt)
                        #else:
                        No due date
                        #endif
                        #if(item.setup.submissionCount == 1):
                        · <a href="#(item.setup.historyURL)">1 submission</a>
                        #elseif(item.setup.submissionCount > 1):
                        · <a href="#(item.setup.historyURL)">#(item.setup.submissionCount) submissions</a>
                        #endif
                        #if(item.setup.gradeIsOverridden):
                        · <span class="grade-override-tag" title="Your grade was set by your instructor">adjusted</span>
                        #endif
                        #if(item.setup.bestGradeText):
                        <span class="row-phone-meta">Grade #(item.setup.bestGradeText)</span>
                        #endif
                    </div>
                #else:
                <span class="text-muted">Unpublished</span>
                #endif
            </td>
            <td>
                #if(item.setup.staffOnly):
                <span class="tier tier-preview staff-only-tag" title="Visible to course staff only — students can't see this assignment yet.">preview</span>
                #elseif(item.setup.status == "extended"):
                <span class="tier tier-extended" title="Your instructor granted you a personal deadline extension — you can still submit past the class deadline.">extended</span>
                #else:
                <span class="tier
                    #if(item.setup.status == "open"):tier-open
                    #elseif(item.setup.status == "closed"):tier-closed
                    #elseif(item.setup.status == "unpublished"):tier-unpublished
                    #endif">#(item.setup.status)</span>
                #endif
            </td>
            <td class="item-grade col-hide-phone">#if(item.setup.bestGradeText):<strong>#(item.setup.bestGradeText)</strong>#else:<span class="empty">—</span>#endif</td>
            <td>
                <div class="assignment-actions-cell">
                    #if(!item.setup.hasAnyAction):
                    <span class="empty">—</span>
                    #endif
                    #if(item.setup.showEditAction):
                    <a class="btn action-btn action-btn-icon" href="#(item.setup.notebookURL)" title="Edit" aria-label="Edit">
                        <svg class="icon" aria-hidden="true"><use href="#i-pencil"/></svg>
                    </a>
                    #endif
                    #if(item.setup.showUploadAction):
                    <a class="btn action-btn action-btn-icon" href="#(item.setup.submitURL)" title="Upload" aria-label="Upload">
                        <svg class="icon" aria-hidden="true"><use href="#i-upload"/></svg>
                    </a>
                    #endif
                    #if(item.setup.showResetNotebookAction):
                    <form method="post" action="/testsetups/#(item.setup.id)/reset-notebook" data-confirm="Reset your notebook back to the original starter? This discards your current edits for this assignment. Your past submissions are not affected." class="inline-form">
                        #csrfFormField()
                        <button class="btn action-btn action-btn-icon action-danger" type="submit"
                                title="Reset notebook to starter (discards current edits; past submissions unaffected)"
                                aria-label="Reset notebook to starter">
                            <svg class="icon" aria-hidden="true"><use href="#i-rewind"/></svg>
                        </button>
                    </form>
                    #endif
                    #if(item.setup.slipDayAvailable):
                    <a class="btn action-btn action-btn-icon" href="#(item.setup.slipDayURL)"
                       title="#(item.setup.slipDayActionLabel)"
                       aria-label="#(item.setup.slipDayActionLabel)">
                        <svg class="icon" aria-hidden="true"><use href="#i-calendar"/></svg>
                    </a>
                    #endif
                    #if(item.setup.solutionAvailable):
                    <a class="btn action-btn action-btn-icon" href="#(item.setup.solutionURL)"
                       title="Solution" aria-label="Solution">
                        <svg class="icon" aria-hidden="true"><use href="#i-key"/></svg>
                    </a>
                    #endif
                    #if(item.setup.leaderboardURL):
                    <a class="btn action-btn action-btn-icon" href="#(item.setup.leaderboardURL)"
                       title="Leaderboard" aria-label="Leaderboard">
                        <svg class="icon" aria-hidden="true"><use href="#i-award"/></svg>
                    </a>
                    #endif
                </div>
            </td>
        </tr>
    #endif
    #endfor
    </tbody>
</table>
#endfor
#endif
<script src="/list-filter.js?v=#appVersion()"></script>
#endexport
#endextend
