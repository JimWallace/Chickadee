<!-- One row of the instructor Overview item list: a graded assignment, an
     unpublished setup, a piece of ungraded material, or a heading.  Every row is
     a tile, a name with one details line, a state track, a submitted count and an
     actions track; the drag handle sits in its own leading cell.  Rendered inside a loop whose
     variable is named `item`, and reads `enrolledStudentCount` from the page
     context, so both call sites in assignments.leaf must keep those names.

     This exists because the sections table and the ungrouped table are the
     same table.  They were two copies, and the copies drifted: the ungrouped
     one had lost the retest action from all three of its status branches and
     the copy-student-link action from one of them, so an assignment outside a
     section - which is every assignment on a course that has never created a
     section - rendered without them. -->
#if(item.isContent):
    <tr data-content-item-id="#(item.content.id)"#if(item.content.isHeading): class="section-items-heading"#endif>
        <td class="section-items-handle"><span class="suite-drag-handle" title="Drag to reorder or move between sections" aria-hidden="true">⋮⋮</span></td>
        #if(item.content.isHeading):
        <td colspan="4"><strong>#(item.content.title)</strong>#if(item.content.itemDescription): <span class="text-muted">#(item.content.itemDescription)</span>#endif</td>
        #else:
        <td class="item-tile-cell"><span class="item-tile" data-kind="#(item.content.kind)"><svg class="icon" aria-hidden="true"><use href="#(item.content.iconHref)"/></svg></span></td>
        <td class="item-main">
            <div class="item-title#if(!item.content.isPublished): text-muted#endif">#(item.content.title)</div>
            <div class="item-details"><span class="content-item-kind" data-kind="#(item.content.kind)">#(item.content.kindLabel)</span>#if(item.content.detailsText != ""): · #(item.content.detailsText)#endif</div>
        </td>
        <td class="item-status">
            <form method="post" action="/instructor/content-items/#(item.content.id)/visibility" class="status-form">
                #csrfFormField()
                <label class="visually-hidden" for="visibility-#(item.content.id)">Visibility of #(item.content.title)</label>
                <span class="state-select" data-state="#if(item.content.isPublished):visible#else:hidden#endif">
                    <select id="visibility-#(item.content.id)" class="form-input" name="isPublished" data-ck-submit-on-change>
                        <option value="true" #if(item.content.isPublished):selected#endif>Visible</option>
                        <option value="false" #if(!item.content.isPublished):selected#endif>Hidden</option>
                    </select>
                </span>
            </form>
        </td>
        <td class="col-hide-phone"></td>
        #endif
        <td class="item-actions-td">
            <div class="assignment-actions-cell">
                #for(action in item.content.actions):
                <a class="btn action-btn action-btn-icon" href="#(action.href)" title="#(action.label)" aria-label="#(action.label)"#if(action.opensNewTab): target="_blank" rel="noopener noreferrer"#endif>
                    <svg class="icon" aria-hidden="true"><use href="#(action.iconHref)"/></svg>
                </a>
                #endfor
                <details class="ext-details popup-anchor">
                    <summary class="btn action-btn action-btn-icon ext-summary" title="Edit" aria-label="Edit #(item.content.title)">
                        <svg class="icon" aria-hidden="true"><use href="#i-pencil"/></svg>
                    </summary>
                    <div class="popover-panel">
                    <form method="post" action="/instructor/content-items/#(item.content.id)/edit" enctype="multipart/form-data" class="form popup-form">
                        #csrfFormField()
                        <label class="form-label">Title
                            <input class="form-input editor-input" type="text" name="title" value="#(item.content.title)" required>
                        </label>
                        <label class="form-label">Type
                            <select class="form-input editor-input" name="kind">
                                <option value="link" #if(item.content.kind == "link"):selected#endif>Link</option>
                                <option value="notebook" #if(item.content.kind == "notebook"):selected#endif>Notebook</option>
                                <option value="document" #if(item.content.kind == "document"):selected#endif>Document</option>
                                <option value="slides" #if(item.content.kind == "slides"):selected#endif>Slides</option>
                                <option value="outline" #if(item.content.kind == "outline"):selected#endif>Outline</option>
                                <option value="heading" #if(item.content.kind == "heading"):selected#endif>Heading</option>
                            </select>
                        </label>
                        <div class="content-item-link-fields">
                            #for(link in item.content.links):
                            <span class="content-item-link-pair">
                                <input class="form-input editor-input" type="text" name="linkLabels[]" value="#(link.label)" placeholder="Label">
                                <input class="form-input editor-input" type="text" name="linkURLs[]" value="#(link.url)" placeholder="https://…">
                            </span>
                            #endfor
                            <span class="content-item-link-pair">
                                <input class="form-input editor-input" type="text" name="linkLabels[]" placeholder="Label">
                                <input class="form-input editor-input" type="text" name="linkURLs[]" placeholder="https://…">
                            </span>
                        </div>
                        <label class="form-label">Description
                            <input class="form-input editor-input" type="text" name="description" value="#if(item.content.itemDescription):#(item.content.itemDescription)#endif">
                        </label>
                        <label class="form-label">Updated label
                            <input class="form-input editor-input" type="text" name="updatedLabel" value="#if(item.content.updatedLabel):#(item.content.updatedLabel)#endif" placeholder="e.g. 2026-05-11">
                        </label>
                        <label class="form-label">Visibility
                            <select class="form-input editor-input" name="isPublished">
                                <option value="true" #if(item.content.isPublished):selected#endif>Published</option>
                                <option value="false" #if(!item.content.isPublished):selected#endif>Hidden</option>
                            </select>
                        </label>
                        <label class="form-label">Add files
                            <input class="form-input editor-input" type="file" name="attachmentFiles" multiple>
                        </label>
                        <button class="btn btn-primary btn-compact" type="submit">Save changes</button>
                    </form>
                    #if(count(item.content.attachments) > 0):
                    <div class="content-item-attachment-list">
                        #for(att in item.content.attachments):
                        <div class="content-item-attachment">
                            <a href="#(att.downloadURL)">#(att.displayName)</a>
                            <span class="text-muted content-item-attachment-size">#(att.sizeLabel)</span>
                            <form method="post" action="/instructor/content-items/#(item.content.id)/attachments/#(att.id)/delete" data-confirm="Remove this file?">
                                #csrfFormField()
                                <button class="btn action-btn action-danger" type="submit">Remove</button>
                            </form>
                        </div>
                        #endfor
                    </div>
                    #endif
                    </div>
                </details>
                <details class="ext-details row-menu">
                    <summary class="btn action-btn action-btn-icon ext-summary" title="More actions" aria-label="More actions for #(item.content.title)">
                        <svg class="icon" aria-hidden="true"><use href="#i-more"/></svg>
                    </summary>
                    <div class="popover-panel row-menu-panel" role="menu">
                        <form method="post" action="/instructor/content-items/#(item.content.id)/delete" data-confirm="Delete this material?">
                            #csrfFormField()
                            <button class="row-menu-item row-menu-item--danger" type="submit" role="menuitem">
                                <svg class="icon" aria-hidden="true"><use href="#i-trash"/></svg>Delete material
                            </button>
                        </form>
                    </div>
                </details>
            </div>
        </td>
    </tr>
#else:
    <tr class="#if(item.row.status == "open"):status-open#elseif(item.row.status == "preview"):status-preview#elseif(item.row.status == "closed"):status-closed#endif"
        #if(item.row.assignmentID):data-assignment-id="#(item.row.assignmentID)"#endif>
        <td class="section-items-handle">#if(item.row.assignmentID):<span class="suite-drag-handle" title="Drag to reorder or move between sections" aria-hidden="true">⋮⋮</span>#endif</td>
        <td class="item-tile-cell">
            #if(item.row.assignmentID):
            <span class="item-tile" data-kind="graded"><svg class="icon" aria-hidden="true"><use href="#i-calendar-check"/></svg></span>
            #else:
            <span class="item-tile"><svg class="icon" aria-hidden="true"><use href="#i-upload"/></svg></span>
            #endif
        </td>
        <td class="item-main">
            #if(item.row.assignmentID):
            <div class="item-title"><a href="/instructor/#(item.row.assignmentID)/submissions">#(item.row.title)</a></div>
            <div class="item-details">
                #if(item.row.dueAt):Due #(item.row.dueAt)#else:No due date#endif
                #if(item.row.variantState == "failed"):
                · <span class="tier tier-danger" title="Reference solution graded on synthetic per-student seeds">#(item.row.variantSummaryText)</span>
                · Students on those variants fail too
                #if(item.row.failedVariantSubmissionID):
                · <a href="/submissions/#(item.row.failedVariantSubmissionID)">View variant</a>
                #endif
                #elseif(item.row.variantState == "pending"):
                · <span title="Reference solution graded on synthetic per-student seeds">#(item.row.variantSummaryText)</span>
                #elseif(item.row.variantState == "passed"):
                · <span title="Reference solution graded on synthetic per-student seeds">#(item.row.variantSummaryText)</span>
                #endif
                #if(item.row.validationStatus == "failed"):
                #if(item.row.validationSubmissionID):· <a href="/submissions/#(item.row.validationSubmissionID)">View results</a>#endif
                #elseif(item.row.validationStatus == "pending"):
                #if(item.row.validationSubmissionID):· <a href="/submissions/#(item.row.validationSubmissionID)">Track status</a>#endif
                #elseif(item.row.validationStatus == "no-runner"):
                · Ask an admin for a compatible runner, then re-save.
                #endif
            </div>
            #else:
            <div class="item-title text-muted"><em>Unpublished</em></div>
            <div class="item-details">Uploaded #(item.row.createdAt) · #(item.row.suiteCount) tests</div>
            #endif
        </td>
        <td class="item-status">
            #if(!item.row.assignmentID):
            <span class="tier tier-unpublished">Unpublished</span>
            #elseif(item.row.validationStatus == "passed"):
            <form method="post" action="/instructor/#(item.row.assignmentID)/status" class="status-form">
                #csrfFormField()
                <label class="visually-hidden" for="status-#(item.row.assignmentID)">Status for #(item.row.title)</label>
                <span class="state-select" data-state="#(item.row.status)">
                    <select id="status-#(item.row.assignmentID)" class="form-input" name="status" data-ck-submit-on-change>
                        <option value="open" #if(item.row.status == "open"):selected#endif>open</option>
                        <option value="preview" #if(item.row.status == "preview"):selected#endif>staff only</option>
                        <option value="closed" #if(item.row.status == "closed"):selected#endif>closed</option>
                    </select>
                </span>
            </form>
            #elseif(item.row.validationStatus == "failed"):
            <span class="tier tier-danger">Validation failed</span>
            #elseif(item.row.validationStatus == "pending"):
            <span class="tier tier-preview">Validating…</span>
            #elseif(item.row.validationStatus == "no-runner"):
            <span class="tier tier-danger" title="No runner could grade this when it was last saved, so validation did not run.">No runner</span>
            #else:
            <span class="tier tier-closed">closed</span>
            #endif
        </td>
        <td class="col-hide-phone nowrap">
            #if(item.row.assignmentID):
            <span title="#(item.row.submittedStudentCount) / #(enrolledStudentCount) students submitted">#(item.row.submittedStudentCount) / #(enrolledStudentCount)</span>
            <div class="item-details">submitted</div>
            #endif
        </td>
        <td class="item-actions-td">
            #if(item.row.status == "unpublished"):
            <div class="assignment-actions-cell">
                <details class="publish-details">
                    <summary class="btn action-btn summary-btn">Publish…</summary>
                    <form class="publish-form" method="post" action="/instructor">
                        <input type="hidden" name="testSetupID" value="#(item.row.setupID)">
                        <label class="form-label publish-label">
                            Title
                            <input class="form-input editor-input" type="text" name="title"
                                   placeholder="e.g. Lab 1 — Warmup" required>
                        </label>
                        <label class="form-label publish-label">
                            Due date (optional)
                            <input class="form-input js-publish-due-date editor-input" type="datetime-local" name="dueAt">
                        </label>
                        <div class="publish-uw-warning card-meta" style="display:none"></div>
                        <button class="btn btn-primary btn-compact" type="submit">Create draft</button>
                    </form>
                </details>
                <details class="ext-details row-menu">
                    <summary class="btn action-btn action-btn-icon ext-summary" title="More actions" aria-label="More actions for unpublished setup #(item.row.setupID)">
                        <svg class="icon" aria-hidden="true"><use href="#i-more"/></svg>
                    </summary>
                    <div class="popover-panel row-menu-panel" role="menu">
                        <form method="post" action="/instructor/setup/#(item.row.setupID)/delete"
                              data-confirm="Delete this unpublished setup? This cannot be undone.">
                            #csrfFormField()
                            <button class="row-menu-item row-menu-item--danger" type="submit" role="menuitem">
                                <svg class="icon" aria-hidden="true"><use href="#i-trash"/></svg>Delete setup
                            </button>
                        </form>
                    </div>
                </details>
            </div>
            #else:
            <!-- Every published status - open, closed, staff-only preview -
                 gets the same actions: copy link and edit up front, the rest
                 in the row menu. -->
            <div class="assignment-actions-cell">
                <button class="btn action-btn action-btn-icon" type="button"
                        title="Copy student link" aria-label="Copy student link"
                        data-copy-url="#(item.row.vanityURL)">
                    <svg class="icon" aria-hidden="true"><use href="#i-link"/></svg>
                </button>
                <a class="btn action-btn action-btn-icon" href="/instructor/#(item.row.assignmentID)/workbench"
                   title="Edit assignment" aria-label="Edit assignment">
                    <svg class="icon" aria-hidden="true"><use href="#i-pencil"/></svg>
                </a>
                <details class="ext-details row-menu">
                    <summary class="btn action-btn action-btn-icon ext-summary" title="More actions" aria-label="More actions for #(item.row.title)">
                        <svg class="icon" aria-hidden="true"><use href="#i-more"/></svg>
                    </summary>
                    <div class="popover-panel row-menu-panel" role="menu">
                        #if(item.row.leaderboardURL):
                        <a class="row-menu-item" href="#(item.row.leaderboardURL)" role="menuitem">
                            <svg class="icon" aria-hidden="true"><use href="#i-award"/></svg>Leaderboard
                        </a>
                        #endif
                        <form method="post" action="/instructor/#(item.row.assignmentID)/clone"
                              data-confirm="Duplicate this assignment? A closed, unvalidated copy will be created for you to edit.">
                            #csrfFormField()
                            <button class="row-menu-item" type="submit" role="menuitem">
                                <svg class="icon" aria-hidden="true"><use href="#i-copy"/></svg>Duplicate
                            </button>
                        </form>
                        <form method="post" action="/instructor/#(item.row.assignmentID)/retest"
                              data-confirm="Retest every submission for this assignment? The worker will re-grade each one against the current test suite.">
                            #csrfFormField()
                            <button class="row-menu-item" type="submit" role="menuitem">
                                <svg class="icon" aria-hidden="true"><use href="#i-refresh"/></svg>Retest all submissions
                            </button>
                        </form>
                        <form method="post" action="/instructor/#(item.row.assignmentID)/delete"
                              data-confirm="Delete this assignment? Students will no longer see it.">
                            #csrfFormField()
                            <button class="row-menu-item row-menu-item--danger" type="submit" role="menuitem">
                                <svg class="icon" aria-hidden="true"><use href="#i-trash"/></svg>Delete assignment
                            </button>
                        </form>
                    </div>
                </details>
            </div>
            #endif
        </td>
    </tr>
#endif
