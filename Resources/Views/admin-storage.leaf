#extend("base"):
#export("title"):
Storage
#endexport
#export("content"):
<p class="admin-version-banner">Chickadee v#appVersion()</p>
#extend("_admin-tabs")
<section class="diagnostics-section">
    <p class="page-crumb">Data</p>
    <div class="page-titlebar">
        <h2>Storage <span class="text-muted">#(storage.totalFormatted) total · #(storage.dbBackend)</span></h2>
    </div>
    <div class="diagnostics-cards">
        #for(row in storage.rows):
        <div class="diagnostic-card">
            <div class="diagnostic-label">#(row.label)</div>
            <div class="diagnostic-value">#(row.formatted)</div>
        </div>
        #endfor
        <div class="diagnostic-card">
            <div class="diagnostic-label">Disk free</div>
            <div class="diagnostic-value">#(storage.diskText)</div>
        </div>
    </div>
</section>
<section class="page-section">
    <div class="page-titlebar">
        <h2>By Assignment <span class="text-muted">Largest first</span></h2>
    </div>
    #if(count(assignmentRows) == 0):
    <p class="text-muted">No assignments yet.</p>
    #else:
    <!-- Server order is already largest first, so the list is not sortable: a
         client-side re-sort would only repeat it or scramble it. The bar is the
         row's size against the largest row; the label is its share of the total
         on disk. -->
    <table class="results-table section-items section-items--manage">
        <colgroup>
            <col class="section-items-tile"><col><col class="section-items-seen col-hide-phone"><col class="section-items-count">
        </colgroup>
        <thead class="visually-hidden">
            <tr><th scope="col">Assignment</th><th scope="col">Detail</th><th scope="col">Share of total</th><th scope="col">Total</th></tr>
        </thead>
        <tbody>
        #for(row in assignmentRows):
            <tr>
                <td class="item-tile-cell"><span class="item-tile" data-kind="graded"><svg class="icon" aria-hidden="true"><use href="#i-list"/></svg></span></td>
                <td class="item-main">
                    <div class="item-title">#(row.assignmentTitle)</div>
                    <div class="item-details"><span class="content-item-kind" data-kind="graded">#(row.courseCode)</span> · #(row.detailsText)</div>
                </td>
                <td class="col-hide-phone">
                    <span class="share-bar" style="--share:#(row.barPercent)%"></span>
                    <div class="item-details item-grade">#(row.shareLabel)</div>
                </td>
                <td class="item-status item-grade"><strong>#(row.totalFormatted)</strong></td>
            </tr>
        #endfor
        </tbody>
    </table>
    #endif
</section>
#endexport
#endextend
