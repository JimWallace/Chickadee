#extend("base"):
#export("title"):
Storage
#endexport
#export("content"):
<p class="admin-version-banner">Chickadee v#appVersion()</p>
<nav class="admin-tabs" aria-label="Admin sections">
    <a class="admin-tab" href="/admin"#if(activeAdminTab == "overview"): aria-current="page"#endif>Overview</a>
    <a class="admin-tab" href="/admin/users"#if(activeAdminTab == "users"): aria-current="page"#endif>Users</a>
    <a class="admin-tab" href="/admin/storage"#if(activeAdminTab == "storage"): aria-current="page"#endif>Storage</a>
    <a class="admin-tab" href="/admin/retention"#if(activeAdminTab == "retention"): aria-current="page"#endif>Retention</a>
    <a class="admin-tab" href="/admin/brightspace"#if(activeAdminTab == "brightspace"): aria-current="page"#endif>LEARN</a>
    #if(mcpEnabled()):<a class="admin-tab" href="/admin/mcp"#if(activeAdminTab == "mcp"): aria-current="page"#endif>MCP</a>#endif
    <a class="admin-tab" href="/admin/audit"#if(activeAdminTab == "audit"): aria-current="page"#endif>Audit Log</a>
    <a class="admin-tab" href="/admin/alerts"#if(activeAdminTab == "alerts"): aria-current="page"#endif>Health Alerts</a>
</nav>
<section class="admin-section admin-diagnostics">
    <div class="storage-bar storage-bar--end">
        <span class="storage-meta">Total: #(storage.totalFormatted) · DB: #(storage.dbBackend)</span>
    </div>
    <div class="diagnostics-cards">
        #for(row in storage.rows):
        <article class="diagnostic-card">
            <div class="diagnostic-label">#(row.label)</div>
            <div class="diagnostic-value">#(row.formatted)</div>
        </article>
        #endfor
    </div>
</section>
<section class="admin-section">
    <div class="storage-bar">
        <h2 class="storage-bar-title">By Assignment</h2>
        <span class="storage-meta">Largest first</span>
    </div>
    #if(storage.assignments.isEmpty):
    <p class="storage-muted">No assignments yet.</p>
    #else:
    <div class="table-scroll"><table class="results-table sortable-table">
        <thead>
            <tr>
                <th data-sort-type="text"><button class="sort-header" type="button">Assignment</button></th>
                <th data-sort-type="text"><button class="sort-header" type="button">Course</button></th>
                <th data-sort-type="number" class="storage-num"><button class="sort-header" type="button">Test Suite</button></th>
                <th data-sort-type="number" class="storage-num"><button class="sort-header" type="button">Submissions</button></th>
                <th data-sort-type="number" class="storage-num"><button class="sort-header" type="button">Subs</button></th>
                <th data-sort-type="number" class="storage-num"><button class="sort-header" type="button">Total</button></th>
            </tr>
        </thead>
        <tbody>
            #for(row in storage.assignments):
            <tr>
                <td>#(row.assignmentTitle)</td>
                <td><code>#(row.courseCode)</code></td>
                <td class="storage-num" data-sort-value="#(row.testSuiteBytes)">#(row.testSuiteFormatted)</td>
                <td class="storage-num" data-sort-value="#(row.submissionsBytes)">#(row.submissionsFormatted)</td>
                <td class="storage-num" data-sort-value="#(row.submissionCount)">#(row.submissionCount)</td>
                <td class="storage-num storage-num--strong" data-sort-value="#(row.totalBytes)">#(row.totalFormatted)</td>
            </tr>
            #endfor
        </tbody>
    </table></div>
    #endif
</section>
<style>
.storage-bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: .5rem;
    margin-bottom: 1rem;
}
.storage-bar--end {
    justify-content: flex-end;
}
.storage-bar-title {
    margin: 0;
}
.storage-meta {
    color: var(--gray-600);
    font-size: var(--text-base);
}
.storage-muted {
    color: var(--muted);
}
.storage-num {
    text-align: right;
}
.storage-num--strong {
    font-weight: 600;
}
</style>
<script src="/sortable-table.js?v=#appVersion()"></script>
#endexport
#endextend
