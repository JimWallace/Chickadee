#extend("base"):
#export("title"):
Storage
#endexport
#export("content"):
<p class="admin-version-banner">Chickadee v#appVersion()</p>
#extend("_admin-tabs")
<section class="diagnostics-section">
    <div class="toolbar toolbar--end section-gap">
        <span class="storage-meta">Total: #(storage.totalFormatted) · DB: #(storage.dbBackend)</span>
    </div>
    <div class="diagnostics-cards">
        #for(row in storage.rows):
        <div class="diagnostic-card">
            <div class="diagnostic-label">#(row.label)</div>
            <div class="diagnostic-value">#(row.formatted)</div>
        </div>
        #endfor
    </div>
</section>
<section class="page-section">
    <div class="page-titlebar page-titlebar--baseline">
        <h2>By Assignment</h2>
        <span class="storage-meta">Largest first</span>
    </div>
    #if(storage.assignments.isEmpty):
    <p class="text-muted">No assignments yet.</p>
    #else:
    <div class="table-scroll"><table class="results-table sortable-table">
        <thead>
            <tr>
                <th data-sort-type="text"><button class="sort-header" type="button">Assignment</button></th>
                <th data-sort-type="text"><button class="sort-header" type="button">Course</button></th>
                <th data-sort-type="number" class="storage-num"><button class="sort-header" type="button">Test Suite</button></th>
                <th data-sort-type="number" class="storage-num"><button class="sort-header" type="button">Submissions</button></th>
                <th data-sort-type="number" class="storage-num"><button class="sort-header" type="button">Subs</button></th>
                <th data-sort-type="number" class="storage-num"><button class="sort-header" type="button">Total</button></th>
            </tr>
        </thead>
        <tbody>
            #for(row in storage.assignments):
            <tr>
                <td>#(row.assignmentTitle)</td>
                <td><code>#(row.courseCode)</code></td>
                <td class="storage-num" data-sort-value="#(row.testSuiteBytes)">#(row.testSuiteFormatted)</td>
                <td class="storage-num" data-sort-value="#(row.submissionsBytes)">#(row.submissionsFormatted)</td>
                <td class="storage-num" data-sort-value="#(row.submissionCount)">#(row.submissionCount)</td>
                <td class="storage-num storage-num--strong" data-sort-value="#(row.totalBytes)">#(row.totalFormatted)</td>
            </tr>
            #endfor
        </tbody>
    </table></div>
    #endif
</section>
<style>
.storage-meta {
    color: var(--gray-600);
    font-size: var(--text-base);
}
.storage-num {
    text-align: right;
}
.storage-num--strong {
    font-weight: 600;
}
</style>
<script src="/sortable-table.js?v=#appVersion()"></script>
#endexport
#endextend
