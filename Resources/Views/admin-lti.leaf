#extend("base"):
#export("title"):
LTI
#endexport
#export("content"):
<p class="admin-version-banner">Chickadee v#appVersion()</p>
#extend("_admin-tabs")
<section class="page-section">
    <p class="page-crumb">Integrations</p>
    <div class="page-titlebar">
        <h2>LTI <span class="text-muted">#(enabledPlatformCount) platform(s) enabled</span></h2>
    </div>
    <p class="section-intro">Give these values to the LMS administrator who registers Chickadee as an LTI 1.3 tool.</p>
    #if(!baseURLConfigured):
    <div class="flash flash-warning" role="status">
        <strong><code>PUBLIC_BASE_URL</code> is not set,</strong> so these are paths. Set it and restart the server.
    </div>
    #endif
    <div class="card section-gap">
        <dl class="detail-grid detail-grid--cells">
            <div><dt>OIDC login URL</dt>
            <dd><code>#(loginURL)</code> <button class="btn action-btn action-btn-icon" type="button" data-copy-url="#(loginURL)" title="Copy" aria-label="Copy the OIDC login URL"><svg class="icon" aria-hidden="true"><use href="#i-copy"/></svg></button></dd></div>
            <div><dt>Redirect URL</dt>
            <dd><code>#(launchURL)</code> <button class="btn action-btn action-btn-icon" type="button" data-copy-url="#(launchURL)" title="Copy" aria-label="Copy the redirect URL"><svg class="icon" aria-hidden="true"><use href="#i-copy"/></svg></button></dd></div>
            <div><dt>Target link URL</dt>
            <dd><code>#(launchURL)</code> <button class="btn action-btn action-btn-icon" type="button" data-copy-url="#(launchURL)" title="Copy" aria-label="Copy the target link URL"><svg class="icon" aria-hidden="true"><use href="#i-copy"/></svg></button></dd></div>
            <div><dt>Key set URL</dt>
            <dd><code>#(jwksURL)</code> <button class="btn action-btn action-btn-icon" type="button" data-copy-url="#(jwksURL)" title="Copy" aria-label="Copy the key set URL"><svg class="icon" aria-hidden="true"><use href="#i-copy"/></svg></button></dd></div>
            <div><dt>Signing algorithm</dt>
            <dd><code>RS256</code></dd></div>
        </dl>
    </div>
    <p class="field-note">Set the link to open in a new window.</p>
</section>

<section class="page-section">
    <div class="page-titlebar">
        <h2>Platforms</h2>
        <a class="btn action-btn" href="#new-platform-panel" data-add-target="new-platform-panel">+ Register platform</a>
    </div>

    <div class="add-panel card#if(newPlatformOpen): is-open#endif" id="new-platform-panel">
        <form method="post" action="/admin/lti/platforms" class="form-stack">
            #csrfFormField()
            #extend("_lti-platform-fields", newFields)
            <div class="toolbar">
                <button class="btn btn-primary" type="submit">Register platform</button>
                <button class="btn action-btn js-add-cancel" type="button">Cancel</button>
            </div>
        </form>
    </div>

    #if(count(platforms) == 0):
    <p class="empty">No platforms registered.</p>
    <p class="section-note">LTI launches are off until a platform is registered.</p>
    #else:
    <table class="results-table section-items section-items--manage">
        <colgroup>
            <col class="section-items-tile"><col><col class="section-items-status"><col class="section-items-actions">
        </colgroup>
        <thead class="visually-hidden">
            <tr><th scope="col">Platform</th><th scope="col">Detail</th><th scope="col">Status</th><th scope="col">Actions</th></tr>
        </thead>
        <tbody>
        #for(platform in platforms):
            <tr#if(!platform.enabled): class="row-muted"#endif>
                <td class="item-tile-cell"><span class="item-tile"><svg class="icon" aria-hidden="true"><use href="#i-link"/></svg></span></td>
                <td class="item-main">
                    <div class="item-title">#(platform.displayName)</div>
                    <div class="item-details">#(platform.deploymentCount) deployments · <code>#(platform.issuer)</code> · client <code>#(platform.clientID)</code></div>
                </td>
                <td class="item-status">
                    <form method="post" action="/admin/lti/platforms/#(platform.id)/enabled" class="inline-form form-flush">
                        #csrfFormField()
                        <label class="visually-hidden" for="lti-enabled-#(platform.id)">Status of #(platform.displayName)</label>
                        <span class="state-select" data-state="#if(platform.enabled):open#else:closed#endif">
                            <select id="lti-enabled-#(platform.id)" name="enabled" class="form-input" data-ck-submit-on-change>
                                <option value="true"#if(platform.enabled): selected#endif>Enabled</option>
                                <option value="false"#if(!platform.enabled): selected#endif>Disabled</option>
                            </select>
                        </span>
                    </form>
                </td>
                <td class="item-actions-td">
                    <div class="assignment-actions-cell">
                        <a class="btn action-btn action-btn-icon" href="#edit-platform-#(platform.id)"
                           data-add-target="edit-platform-#(platform.id)"
                           title="Edit #(platform.displayName)" aria-label="Edit #(platform.displayName)">
                            <svg class="icon" aria-hidden="true"><use href="#i-pencil"/></svg>
                        </a>
                        <details class="ext-details row-menu">
                            <summary class="btn action-btn action-btn-icon ext-summary" title="More actions" aria-label="More actions for #(platform.displayName)">
                                <svg class="icon" aria-hidden="true"><use href="#i-more"/></svg>
                            </summary>
                            <div class="popover-panel row-menu-panel" role="menu">
                                <form method="post" action="/admin/lti/platforms/#(platform.id)/delete"
                                      data-confirm="Delete the platform #(platform.displayName)? Launches from it stop immediately, and the registration cannot be restored.">
                                    #csrfFormField()
                                    <button class="row-menu-item row-menu-item--danger" type="submit" role="menuitem">
                                        <svg class="icon" aria-hidden="true"><use href="#i-trash"/></svg>Delete platform
                                    </button>
                                </form>
                            </div>
                        </details>
                    </div>
                </td>
            </tr>
            <tr>
                <td colspan="4" class="log-entry-cell">
                    <div class="add-panel card#if(platform.editOpen): is-open#endif" id="edit-platform-#(platform.id)">
                        <form method="post" action="/admin/lti/platforms/#(platform.id)" class="form-stack">
                            #csrfFormField()
                            #extend("_lti-platform-fields", platform.fields)
                            <div class="toolbar">
                                <button class="btn btn-primary" type="submit">Save platform</button>
                                <button class="btn action-btn js-add-cancel" type="button">Cancel</button>
                            </div>
                        </form>
                    </div>
                </td>
            </tr>
        #endfor
        </tbody>
    </table>
    #endif
</section>
#endexport
#endextend
