<!-- Icon sprite: every icon in the UI, once (UI audit S4).

     Rendered inline at the top of the body by base.leaf. A call site is a
     svg carrying class "icon" wrapping a use element whose href is a same-page
     fragment naming one of the symbol ids below; copy a live one rather than
     working from this description. Same-document use is deliberate: an external
     sprite file would be one more fetch that can fail, and its failure mode is
     an icon-only button rendering as an empty box.

     Described rather than quoted on purpose. A fragment reference written in
     prose is indistinguishable from a real one to any scanner reading this
     file, so an example here registers as a call site — which is how a sweep
     for unresolved icon references reported a dangling id that exists only in
     this comment. Same shape as the #1266 Leaf-comment finding.

     Before this the geometries were pasted verbatim at 55 call sites — the
     trash can alone appeared 15 times across three byte-level variants (two in
     templates, one in JS with explicit closing tags) — so "change the delete
     icon" meant finding all fifteen, and the variants proved nobody ever did.

     Adding an icon: add a symbol here, then reference it. Do NOT paste path
     data into a template or a JS string; check-styles.sh fails on a new inline
     <svg>. Everything is the 24x24 stroked Feather set (the one icon that was
     not has been redrawn to match) so the whole UI shares a stroke weight. -->
<svg class="icon-sprite" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
    <defs>
        <symbol id="i-trash" viewBox="0 0 24 24">
            <polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/>
        </symbol>
        <symbol id="i-pencil" viewBox="0 0 24 24">
            <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/>
        </symbol>
        <symbol id="i-refresh" viewBox="0 0 24 24">
            <path d="M21 12a9 9 0 0 1-15.364 6.364L3 16m0 0v5m0-5h5"/><path d="M3 12a9 9 0 0 1 15.364-6.364L21 8m0 0V3m0 5h-5"/>
        </symbol>
        <symbol id="i-rewind" viewBox="0 0 24 24">
            <polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
        </symbol>
        <symbol id="i-eye" viewBox="0 0 24 24">
            <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/>
        </symbol>
        <symbol id="i-scissors" viewBox="0 0 24 24">
            <line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/>
        </symbol>
        <symbol id="i-calendar-check" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><polyline points="9 16 11 18 15 14"/>
        </symbol>
        <symbol id="i-calendar" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
        </symbol>
        <symbol id="i-link" viewBox="0 0 24 24">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
        </symbol>
        <symbol id="i-copy" viewBox="0 0 24 24">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
        </symbol>
        <symbol id="i-download" viewBox="0 0 24 24">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
        </symbol>
        <symbol id="i-upload" viewBox="0 0 24 24">
            <line x1="12" y1="21" x2="12" y2="4"/><polyline points="6 10 12 4 18 10"/><path d="M4 21h16"/>
        </symbol>
        <symbol id="i-archive" viewBox="0 0 24 24">
            <polyline points="21 8 21 21 3 21 3 8"/><rect x="1" y="3" width="22" height="5"/><line x1="10" y1="12" x2="14" y2="12"/>
        </symbol>
        <symbol id="i-lock" viewBox="0 0 24 24">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/>
        </symbol>
        <symbol id="i-book" viewBox="0 0 24 24">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
        </symbol>
        <symbol id="i-chevron-right" viewBox="0 0 24 24">
            <polyline points="9 18 15 12 9 6"/>
        </symbol>
        <!-- Redrawn in the house 24x24 stroked style: this was the one icon
             from a foreign set (a filled 16x16 glyph), which read a weight
             heavier than every button beside it. -->
        <symbol id="i-push-down" viewBox="0 0 24 24">
            <line x1="12" y1="3" x2="12" y2="15"/><polyline points="7 10 12 15 17 10"/><line x1="4" y1="20" x2="20" y2="20"/>
        </symbol>
    </defs>
</svg>
