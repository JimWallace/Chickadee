#extend("base"):
#export("title"):
LEARN
#endexport
#export("content"):
<p class="admin-version-banner">Chickadee v#appVersion()</p>
#extend("_admin-tabs")
<section class="page-section">

    <p class="section-intro">
        LEARN grade sync runs as one D2L service account. The app credentials
        (URL / App ID / App Key) come from the server environment; this page sets
        the matching <strong>Valence user key</strong> — harvested from your
        institution's credential service — with no env change or restart. A key
        set here takes precedence over <code>BRIGHTSPACE_USER_KEY</code>.
    </p>

    #if(!configured):
    <p class="text-muted">
        Not configured. Set <code>BRIGHTSPACE_URL</code>,
        <code>BRIGHTSPACE_APP_ID</code>, and <code>BRIGHTSPACE_APP_KEY</code> in
        the server environment, then reload this page to set the user key.
    </p>
    #else:
    <dl class="bs-status">
        <dt>Status</dt>
        <dd>
            #if(authorized):
            <span class="tier tier-open">Authorized</span>
            #if(keySource == "env"):<span class="text-muted">(using key from env)</span>#endif
            #else:
            <span class="tier tier-closed">Not authorized</span>
            #endif
        </dd>
        <dt>LMS</dt>
        <dd><code>#(baseURL)</code></dd>
        #if(identityName):
        <dt>Authorized as</dt>
        <dd>#(identityName)#if(capturedAt): <span class="text-muted">— #(capturedAt)</span>#endif</dd>
        #endif
    </dl>

    <div class="bs-actions">
        #if(authorized):
        <form method="post" action="/admin/brightspace/test" class="inline-form">
            #csrfFormField()
            <button class="btn" type="submit">Test connection</button>
        </form>
        #endif
        #if(keySource == "authorized"):
        <form method="post" action="/admin/brightspace/clear" class="inline-form"
              data-confirm="Clear the stored LEARN authorization? Grade sync reverts to the env key if set, otherwise it stops.">
            #csrfFormField()
            <button class="btn action-danger" type="submit">Clear authorization</button>
        </form>
        #endif
    </div>

    <div class="bs-manual">
        <h3 class="bs-manual-heading">Set the user key</h3>
        <p class="text-muted">
            Harvest the <strong>User ID</strong> and <strong>User Key</strong> for
            your service account from your institution's credential service (e.g.
            UW's <code>d2l-api-cred.fast.uwaterloo.ca</code>), then paste them here —
            they're verified against D2L and stored live, no env change or restart.
        </p>
        <form method="post" action="/admin/brightspace/set-credentials" class="bs-manual-form">
            #csrfFormField()
            <label class="bs-field">User ID
                <input type="text" name="userID" autocomplete="off" spellcheck="false" required>
            </label>
            <label class="bs-field">User Key
                <input type="text" name="userKey" autocomplete="off" spellcheck="false" required>
            </label>
            <button class="btn btn-primary" type="submit">Save &amp; verify</button>
        </form>
    </div>

    <p class="text-muted bs-footnote">
        Instructors map assignments to grade items and watch grades flow on
        their course's LEARN tab; this page only sets the shared connection.
    </p>
    #endif
</section>
<style>
.bs-status {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: .4rem 1rem;
    margin: 1rem 0;
}
.bs-status dt {
    font-weight: 600;
}
.bs-status dd {
    margin: 0;
}
.bs-actions {
    display: flex;
    gap: .6rem;
    flex-wrap: wrap;
    margin: 1rem 0;
}
.bs-footnote {
    font-size: var(--text-base);
    margin-bottom: 0;
}
.bs-manual {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
}
.bs-manual-heading {
    margin: 0 0 .4rem;
    font-size: var(--text-md);
}
.bs-manual-form {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: .8rem;
    margin-top: .6rem;
}
.bs-field {
    display: flex;
    flex-direction: column;
    gap: .25rem;
    font-size: var(--text-base);
}
.bs-field input {
    width: 22rem;
    max-width: 100%;
}
</style>
#endexport
#endextend
