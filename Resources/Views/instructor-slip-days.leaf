#extend("base"):
#export("title"):
Slip days
#endexport
#export("content"):
#extend("_instructor-tabs")

#if(!hasActiveCourse):
<section class="page-section">
    <p class="empty">Select a course to manage its slip days.</p>
</section>
#else:


<section class="page-section">
    <h2>Slip days — #(courseCode)</h2>
    <p class="section-intro">
        A slip day is a student-initiated deadline extension drawn from a fixed
        per-student budget, spent without staff involvement. After a deadline
        passes, an eligible student can claim one from the dashboard within one
        extension length of the deadline; days stack on a single assignment.
        Staff-granted extensions always take precedence — a student holding one
        cannot spend slip days on that assignment.
    </p>
    #if(settingsReadOnlyNote):
    <p class="section-note">#(settingsReadOnlyNote)</p>
    #endif
    <form method="post" action="/instructor/slip-days/settings" class="form-stack">
        #csrfFormField()
        <label class="form-label slip-day-settings-check">
            <input type="checkbox" name="enabled" #if(enabled):checked#endif #if(!canEditSettings):disabled#endif>
            Enable slip days for #(courseCode)
        </label>
        <label class="form-label">
            Days per student
            <input class="form-input slip-day-settings-number" type="number" name="daysPerStudent"
                   min="0" max="100" value="#(daysPerStudent)" #if(!canEditSettings):disabled#endif>
        </label>
        <label class="form-label">
            Hours per slip day
            <input class="form-input slip-day-settings-number" type="number" name="extensionHours"
                   min="1" max="336" value="#(extensionHours)" #if(!canEditSettings):disabled#endif>
            <span class="field-note field-note--muted">Each day extends the deadline by this many hours,
                counted from the original deadline. A claim must be made within this window.</span>
        </label>
        <label class="form-label">
            <span class="slip-day-settings-check">
                <input type="checkbox" name="releaseRevealHold" #if(releaseRevealHold):checked#endif #if(!canEditSettings):disabled#endif>
                Hold release-tier output until slip-day claims lapse
            </span>
            <span class="field-note field-note--muted">Off shows release-tier output at each student&rsquo;s deadline,
                even while they could still claim a slip day and act on it.</span>
        </label>
        #if(canEditSettings):
        <div>
            <button class="btn btn-primary" type="submit">Save settings</button>
        </div>
        #endif
    </form>
</section>

<section class="page-section">
    <h2>Roster ledger</h2>
    #if(!hasStudents):
    <p class="empty">No students enrolled.</p>
    #else:
    <table class="results-table">
        <thead>
            <tr>
                <th>Student</th>
                <th>Used</th>
                <th>Remaining</th>
                <th>Adjustment</th>
                <th>Spends</th>
            </tr>
        </thead>
        <tbody>
        #for(student in students):
            <tr>
                <td>
                    <strong>#(student.displayName)</strong>
                    <div class="text-muted">#(student.username)</div>
                </td>
                <td>#(student.used)</td>
                <td>#(student.remaining) of #(student.total)</td>
                <td>
                    <div class="slip-day-adjust-cell">
                        <span>#(student.adjustment)</span>
                        #if(canManageLedger):
                        <form method="post" action="/instructor/slip-days/adjust" class="inline-form">
                            #csrfFormField()
                            <input type="hidden" name="userID" value="#(student.userID)">
                            <input type="hidden" name="delta" value="1">
                            <button class="btn action-btn" type="submit"
                                    title="Grant one extra slip day"
                                    aria-label="Grant #(student.username) one extra slip day">+1</button>
                        </form>
                        <form method="post" action="/instructor/slip-days/adjust" class="inline-form">
                            #csrfFormField()
                            <input type="hidden" name="userID" value="#(student.userID)">
                            <input type="hidden" name="delta" value="-1">
                            <button class="btn action-btn" type="submit"
                                    title="Remove one slip day"
                                    aria-label="Remove one slip day from #(student.username)">−1</button>
                        </form>
                        #endif
                    </div>
                </td>
                <td>
                    #if(student.hasSpends):
                    <ul class="slip-day-spend-list">
                        #for(spend in student.spends):
                        <li class="slip-day-spend-item">
                            <span #if(spend.isRefunded):class="slip-day-spend-refunded"#endif>
                                #(spend.assignmentTitle) — extended to #(spend.extensionDueAtText)
                                (spent #(spend.spentAtText))
                            </span>
                            #if(spend.isRefunded):
                            <span class="text-muted">refunded #(spend.refundedAtText)</span>
                            #endif
                            #if(spend.canRefund):
                            <form method="post" action="/instructor/slip-days/refund" class="inline-form"
                                  data-confirm="Refund this slip day? The day is returned to the student and the deadline extension is recomputed (or removed).">
                                #csrfFormField()
                                <input type="hidden" name="spendID" value="#(spend.id)">
                                <button class="btn action-btn" type="submit">Refund</button>
                            </form>
                            #endif
                        </li>
                        #endfor
                    </ul>
                    #else:
                    <span class="empty">—</span>
                    #endif
                </td>
            </tr>
        #endfor
        </tbody>
    </table>
    #endif
</section>

#endif
<style>
.slip-day-settings-check { display: flex; align-items: center; gap: .5rem; }
.slip-day-settings-number { display: block; margin-top: .25rem; max-width: 8rem; }
.slip-day-adjust-cell { display: flex; align-items: center; gap: .5rem; }
.slip-day-spend-list { margin: 0; padding-left: 1rem; }
.slip-day-spend-item { margin-bottom: .25rem; }
.slip-day-spend-refunded { text-decoration: line-through; color: var(--text-secondary); }
</style>
#endexport
#endextend
