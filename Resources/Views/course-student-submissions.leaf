#extend("base"):
#export("title"):
#(studentName) — Submissions
#endexport
#export("content"):
<div class="page-titlebar page-titlebar--baseline">
    <div>
        <h1>#(studentName)</h1>
        <p class="titlebar-subtitle">
            <strong>#(studentUsername)</strong> in #(courseName)
        </p>
    </div>
    <a class="btn action-btn" href="#(backURL)">Back to Instructor Dashboard</a>
</div>

#if(!hasSections && !hasUngrouped):
<p class="empty">No published assignments in this course yet.</p>
#else:

#if(hasSections):
#for(section in sections):
#if(count(section.rows) > 0):
<h2 class="section-group-heading">#(section.name)</h2>
#extend("_student-assignment-rows", section)
#endif
#endfor
#endif

#if(hasUngrouped):
#if(hasSections):
<h2 class="section-group-heading">Ungrouped</h2>
#endif
#extend("_student-assignment-rows", ungroupedRowsContext)
#endif

#endif
<style>
.section-group-heading {
    font-size: var(--text-lg);
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: .4rem;
}
.submissions-table {
    margin-bottom: .5rem;
}
.extension-note {
    font-size: var(--text-xs);
    color: var(--gray-600);
}
.student-row-actions {
    display: flex;
    gap: .3rem;
    flex-wrap: nowrap;
    align-items: center;
}
}
</style>
#endexport
#endextend
