                #endif
            </td>
            <td>
                #if(row.bestGradeText):
                    <strong>#(row.bestGradeText)</strong>
                    #if(row.gradeIsOverridden):
                    <span class="grade-override-tag" title="Grade manually overridden by an instructor">overridden</span>
                    #endif
                #else:
                    <span class="empty">—</span>
                #endif
            </td>
            <td class="col-hide-phone">
                #if(row.submissionCount > 0):
                    <div class="submission-history-cell">
                        #if(row.hasLatestSubmission):
                            <a href="/submissions/#(row.latestSubmissionID)" class="submission-history-latest">#(row.latestSubmittedAtText)</a>
                        #endif
                        #if(row.additionalSubmissionCount > 0):
                            <a href="#(row.historyURL)" class="submission-history-more">+#(row.additionalSubmissionCount) more</a>
                        #endif
                    </div>
                #else:
                    <span class="empty">No submissions yet</span>
                #endif
            </td>
            <td>
                <div class="student-row-actions">
                    #if(row.submissionCount > 0):
                    <form method="post" action="#(row.retestPath)" onsubmit="return confirm('Re-test all of this student’s submissions on this assignment?')" class="action-form-flush">
                        #csrfFormField()
                        <button class="btn action-btn action-btn-tight" type="submit" aria-label="Re-test this student’s submissions" title="Re-test every submission this student has on this assignment">
                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 0 1-15.364 6.364L3 16m0 0v5m0-5h5"/><path d="M3 12a9 9 0 0 1 15.364-6.364L21 8m0 0V3m0 5h-5"/></svg>
                        </button>
                    </form>
                    #endif
                    <details class="ext-details action-form-flush">
                        <summary class="btn action-btn action-btn-tight ext-summary" title="#if(row.hasExtension):Edit this student’s deadline extension#else:Grant this student a deadline extension#endif" aria-label="#if(row.hasExtension):Edit deadline extension#else:Grant deadline extension#endif">
                            #if(row.hasExtension):
                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><polyline points="9 16 11 18 15 14"/></svg>
                            #else:
                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                            #endif
                        </summary>
                        <form method="post" action="#(row.extensionSavePath)" class="action-panel">
                            #csrfFormField()
                            <label class="action-panel-label">
                                New deadline for this student
                                <input type="datetime-local" name="extendedDueAt" value="#(row.extensionFormInput)" required class="action-panel-input">
                            </label>
                            <label class="action-panel-label">
                                Note (optional)
                                <input type="text" name="note" placeholder="Reason for extension" class="action-panel-input">
                            </label>
                            <div class="action-panel-actions">
                                <button class="btn action-btn" type="submit">Save</button>
                                #if(row.hasExtension):
                                <button class="btn action-btn" type="submit" formaction="#(row.extensionDeletePath)" formnovalidate onclick="return confirm('Remove this student’s extension on this assignment?')">Remove</button>
                                #endif
                            </div>
                        </form>
                    </details>
                    <details class="ext-details action-form-flush">
                        <summary class="btn action-btn action-btn-tight ext-summary#if(row.gradeIsOverridden): grade-override-active#endif" title="#if(row.gradeIsOverridden):Edit this student’s grade override#else:Override this student’s grade#endif" aria-label="#if(row.gradeIsOverridden):Edit grade override#else:Override grade#endif">
                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
