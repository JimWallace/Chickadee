#extend("base"):
#export("title"):
My Account
#endexport
#export("content"):
<h1>My Account</h1>

#extend("_avatar-sprite")

#if(error == "invalid"):
<p class="form-error" role="alert">That course is not available.</p>
#endif

<section class="page-section">
    <h2>Account info</h2>
    <div class="card section-gap">
        <div class="account-identity">
            #extend("_avatar", avatar)
            <div>
                <strong>#(identityName)</strong>
                #if(identitySecondary):
                <span class="text-muted">#(identitySecondary)</span>
                #endif
            </div>
        </div>
        <dl class="detail-grid">
            <div><dt>Username</dt>
            <dd><strong>#(username)</strong></dd></div>
            #if(preferredName):
            <div><dt>Preferred name</dt>
            <dd>#(preferredName)</dd></div>
            #endif
            #if(studentID):
            <div><dt>Student ID</dt>
            <dd>#(studentID)</dd></div>
            #endif
            #if(email):
            <div><dt>Email</dt>
            <dd>#(email)</dd></div>
            #endif
        </dl>
    </div>
</section>

<section class="page-section" id="chickadee">
    <h2>Chickadee</h2>
    #if(avatarInvalid):
    <p class="form-error" role="alert">That choice is not available.</p>
    #endif
    <div class="card section-gap">
    <form method="post" action="/account/avatar" data-avatar-picker=".account-identity .avatar" style="--av-backdrop: var(#(avatarPicker.backdropToken))">
        #csrfFormField()
        <fieldset class="fieldset-plain">
            <legend>Backdrop</legend>
            <div class="swatch-row">
            #for(option in avatarPicker.backdrops):
            <label class="swatch">
                <input type="radio" name="backdrop" value="#(option.value)" data-av-token="#(option.token)"#if(option.checked): checked#endif>
                <span class="swatch-sample swatch-backdrop" aria-hidden="true" style="--av-backdrop: var(#(option.token))"></span>
                <span class="swatch-name">#(option.label)</span>
            </label>
            #endfor
            </div>
        </fieldset>
        <fieldset class="fieldset-plain">
            <legend>Border</legend>
            #if(avatarPicker.isStaff):
            <p class="field-note">Course staff wear the staff ring.</p>
            #else:
            <div class="swatch-row">
            #for(option in avatarPicker.borders):
            <label class="swatch">
                <input type="radio" data-av-season="#(option.season)" data-av-ring="#(option.ringRef)" name="border" value="#(option.value)" data-av-token="#(option.token)"#if(option.checked): checked#endif#if(option.isLocked): disabled#endif>
                #if(option.isNone):
                <span class="swatch-sample swatch-none" aria-hidden="true"></span>
                #else:
                <svg class="swatch-sample" viewBox="0 0 64 64" aria-hidden="true" style="--av-border: var(#(option.token)); --av-accent: var(#(avatarPicker.accentToken)); --av-cap: var(#(avatarPicker.capToken))"><use href="#av-backdrop"/><use href="#(option.ringRef)"/></svg>
                #endif
                <span class="swatch-name">#(option.label)</span>
            </label>
            #endfor
            </div>
            <p class="field-note">Locked rings will be earned through course achievements.</p>
            <p class="field-note">A seasonal ring can be chosen only during its term.</p>
            #endif
        </fieldset>
        <button class="btn btn-primary" type="submit">Save</button>
    </form>
    </div>
    <script src="/avatar-picker.js?v=#appVersion()"></script>
</section>

#if(github):
<section class="page-section">
    <h2>GitHub</h2>
    #if(github.login):
    <div class="card section-gap">
        <div class="toolbar toolbar--end">
            <span class="tier tier-open">Linked</span>
            <details class="ext-details row-menu">
                <summary class="btn action-btn action-btn-icon ext-summary" title="More actions" aria-label="More actions for your GitHub link">
                    <svg class="icon" aria-hidden="true"><use href="#i-more"/></svg>
                </summary>
                <div class="popover-panel row-menu-panel" role="menu">
                    <form method="post" action="/account/github/unlink">
                        #csrfFormField()
                        <button class="row-menu-item row-menu-item--danger" type="submit" role="menuitem"
                                data-confirm="Unlink the GitHub account #(github.login)?">
                            <svg class="icon" aria-hidden="true"><use href="#i-trash"/></svg>Unlink
                        </button>
                    </form>
                </div>
            </details>
        </div>
        <dl class="detail-grid">
            <div><dt>GitHub login</dt>
            <dd><strong>#(github.login)</strong></dd></div>
        </dl>
    </div>
    #else:
    <p class="empty">No GitHub account linked.</p>
    <p class="section-note">Chickadee keeps only your GitHub user ID and login.</p>
    <form method="post" action="/account/github/link" class="inline-form">
        #csrfFormField()
        <button class="btn btn-primary" type="submit">Link GitHub account</button>
    </form>
    #endif
</section>
#endif

<section class="page-section">
    <h2>My courses</h2>
    #if(!hasEnrolledCourses):
    <p class="empty">You are not enrolled in any courses.
        <a href="/enroll">Browse available courses</a>
    </p>
    #else:
    <table class="results-table section-items">
        <colgroup>
            <col class="section-items-tile"><col><col class="section-items-status"><col class="section-items-actions">
        </colgroup>
        <thead class="visually-hidden">
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Enrolment</th>
                <th><span class="visually-hidden">Actions</span></th>
            </tr>
        </thead>
        <tbody>
        #for(course in enrolledCourses):
            <tr>
                <td class="item-tile-cell"><span class="item-tile" data-kind="outline"><svg class="icon" aria-hidden="true"><use href="#i-book"/></svg></span></td>
                <td class="item-main">
                    <div class="item-title"><strong>#(course.code)</strong>#if(course.termLabel): #(course.termLabel)#endif</div>
                    <div class="item-details">#(course.name)</div>
                    #if(course.handle):
                    <div class="item-details" data-avatar-handle>Class handle: #(course.handle)</div>
                    #if(course.handleChoice.isLocked):
                    <div class="item-details">Your handle is set for this course.</div>
                    #endif
                    #endif
                    #if(course.slipDaysText):
                    <div class="item-details">#(course.slipDaysText)</div>
                    #endif
                    #if(course.enrollmentMode == "auto"):
                    <div class="item-details">Auto-enrolled. Contact your instructor to be removed.</div>
                    #elseif(course.enrollmentMode != "open"):
                    <div class="item-details">Managed by your instructor. Contact them to be removed.</div>
                    #endif
                </td>
                <td class="item-status">
                    #if(course.enrollmentMode == "auto"):
                    <span class="tier tier-closed" title="Auto-enrolled — contact your instructor to be removed">Auto</span>
                    #elseif(course.enrollmentMode != "open"):
                    <span class="tier tier-closed" title="Managed by instructor — contact them to be removed">Managed</span>
                    #endif
                </td>
                <td class="item-actions-td">
                    <div class="assignment-actions-cell">
                    #if(course.handleChoice.canChoose):
                    <details class="ext-details form-flush"#if(course.handleChoice.wasTaken): open#endif>
                        <summary class="btn action-btn ext-summary">Change handle</summary>
                        <form method="post" action="/account/handle/#(course.id)" class="ext-panel">
                            #csrfFormField()
                            #if(course.handleChoice.wasTaken):
                            <p class="form-error" role="alert">That one was just taken. Here are two more.</p>
                            #endif
                            <p class="field-note">You can change it once, until classmates see it.</p>
                            <div class="checkbox-list" role="radiogroup" aria-label="Class handle for #(course.code)">
                                #for(option in course.handleChoice.options):
                                <label class="checkbox-row">
                                    <input type="radio" name="handle" value="#(option.handle)"#if(option.isCurrent): checked#endif>
                                    #extend("_avatar", option.avatar)
                                    #(option.handle)
                                    #if(option.isCurrent):<span class="chip">Current</span>#endif
                                </label>
                                #endfor
                            </div>
                            <div class="ext-panel-actions">
                                <button class="btn action-btn" type="submit">Save</button>
                            </div>
                        </form>
                    </details>
                    #endif
                    #if(course.enrollmentMode == "open"):
                    <details class="ext-details row-menu">
                        <summary class="btn action-btn action-btn-icon ext-summary" title="More actions" aria-label="More actions for #(course.code)">
                            <svg class="icon" aria-hidden="true"><use href="#i-more"/></svg>
                        </summary>
                        <div class="popover-panel row-menu-panel" role="menu">
                            <form method="post" action="/account/unenroll/#(course.id)">
                                #csrfFormField()
                                <button class="row-menu-item row-menu-item--danger" type="submit" role="menuitem"
                                        data-confirm="Leave #(course.code)?">
                                    <svg class="icon" aria-hidden="true"><use href="#i-trash"/></svg>Leave course
                                </button>
                            </form>
                        </div>
                    </details>
                    #endif
                    </div>
                </td>
            </tr>
        #endfor
        </tbody>
    </table>
    #endif
</section>

<section class="page-section">
    <h2>Available courses</h2>
    #if(!hasAvailableCourses):
    <p class="empty">There are no other courses open to join right now.</p>
    #else:
    <table class="results-table section-items">
        <colgroup>
            <col class="section-items-tile"><col><col class="section-items-actions">
        </colgroup>
        <thead class="visually-hidden">
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th><span class="visually-hidden">Actions</span></th>
            </tr>
        </thead>
        <tbody>
        #for(course in availableCourses):
            <tr>
                <td class="item-tile-cell"><span class="item-tile" data-kind="outline"><svg class="icon" aria-hidden="true"><use href="#i-book"/></svg></span></td>
                <td class="item-main">
                    <div class="item-title"><strong>#(course.code)</strong>#if(course.termLabel): #(course.termLabel)#endif</div>
                    <div class="item-details">#(course.name)</div>
                </td>
                <td class="item-actions-td">
                    <div class="assignment-actions-cell">
                        <form method="post" action="/account/enroll" class="inline-form">
                            #csrfFormField()
                            <input type="hidden" name="courseID" value="#(course.id)">
                            <button class="btn action-btn" type="submit">Join</button>
                        </form>
                    </div>
                </td>
            </tr>
        #endfor
        </tbody>
    </table>
    #endif
</section>

<section class="page-section">
    <h2>Your data</h2>
    <div class="card section-gap">
        #if(exportNotice == "started"):
        <div class="flash flash-neutral" role="status">Your data export is being prepared. This page will refresh when it is ready.</div>
        #elseif(exportNotice == "in_progress"):
        <div class="flash flash-neutral" role="status">Your data export is already being prepared. This page will refresh when it is ready.</div>
        #endif
        #if(exportError == "rate_limited"):
        <p class="form-error" role="alert">You can request one data export per day. Please try again later.</p>
        #elseif(exportError == "not_ready"):
        <p class="form-error" role="alert">Your data export is not ready to download yet.</p>
        #endif
        #if(exportStatus == "pending"):
        <p id="export-pending"><span class="tier tier-preview">In progress</span>
            Requested #(exportRequestedAtDisplay). Preparing your export can take
            a few minutes.</p>
        <script src="/account-export.js?v=#appVersion()"></script>
        #elseif(exportStatus == "complete"):
        <p>
            <a class="btn btn-primary" href="/account/export/download">Download your export</a>
        </p>
        <p>Prepared #(exportCompletedAtDisplay). Downloads are available for three
            days after the export is prepared, then the archive is deleted from
            the server.</p>
        #elseif(exportStatus == "failed"):
        <p class="form-error" role="alert">Your last export attempt failed. Please try again.</p>
        #endif
        <p>Request a copy of the personal information Chickadee holds about you:
            your profile, course enrollments, submissions (including the files you
            uploaded), grading results, and account activity records — delivered
            as a single zip archive. Limit one export per day.</p>
        #if(exportCanRequest):
        <form method="post" action="/account/export" class="inline-form">
            #csrfFormField()
            <button class="btn btn-primary" type="submit">Request data export</button>
        </form>
        #endif
    </div>
</section>

#endexport
#endextend
