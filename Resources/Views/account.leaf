#extend("base"):
#export("title"):
My Account
#endexport
#export("content"):
<h1>My Account</h1>

#if(error == "invalid"):
<p class="form-error" role="alert">That course is not available.</p>
#endif

<!-- ── User info ──────────────────────────────────────────── -->
<section class="admin-section">
    <h2>Account info</h2>
    <dl class="detail-grid">
        <dt>Username</dt>
        <dd><strong>#(username)</strong></dd>
        #if(preferredName):
        <dt>Preferred name</dt>
        <dd>#(preferredName)</dd>
        #endif
        #if(studentID):
        <dt>Student ID</dt>
        <dd>#(studentID)</dd>
        #endif
        #if(email):
        <dt>Email</dt>
        <dd>#(email)</dd>
        #endif
    </dl>
</section>

<!-- ── My Courses ─────────────────────────────────────────── -->
<section class="admin-section">
    <h2>My courses</h2>
    #if(enrolledCourses.isEmpty):
    <p class="empty">You are not enrolled in any courses.
        <a href="/enroll">Browse available courses</a>
    </p>
    #else:
    <table class="results-table">
        <thead>
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        #for(course in enrolledCourses):
            <tr>
                <td><strong>#(course.code)</strong></td>
                <td>#(course.name)</td>
                <td>
                    #if(course.enrollmentMode == "open"):
                    <form method="post" action="/account/unenroll/#(course.id)" class="inline-form">
                        #csrfFormField()
                        <button class="btn action-btn action-danger" type="submit"
                                onclick="return confirm('Leave #(course.code)?')">Leave</button>
                    </form>
                    #elseif(course.enrollmentMode == "auto"):
                    <span class="badge badge-info" title="Auto-enrolled — contact your instructor to be removed">Auto</span>
                    #else:
                    <span class="badge badge-secondary" title="Managed by instructor — contact them to be removed">Managed</span>
                    #endif
                </td>
            </tr>
        #endfor
        </tbody>
    </table>
    #endif
</section>

<!-- ── Available Courses ──────────────────────────────────── -->
#if(!availableCourses.isEmpty):
<section class="admin-section">
    <h2>Available courses</h2>
    <table class="results-table">
        <thead>
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        #for(course in availableCourses):
            <tr>
                <td><strong>#(course.code)</strong></td>
                <td>#(course.name)</td>
                <td>
                    <form method="post" action="/account/enroll" class="inline-form">
                        #csrfFormField()
                        <input type="hidden" name="courseID" value="#(course.id)">
                        <button class="btn btn-primary" type="submit">Join</button>
                    </form>
                </td>
            </tr>
        #endfor
        </tbody>
    </table>
</section>
#endif

#endexport
#endextend
