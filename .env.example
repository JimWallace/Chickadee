# Chickadee — environment configuration
# Copy to .env and fill in values before starting the server.
#
# For Docker Compose: docker compose reads .env automatically.
# For VM / systemd: copy to /opt/chickadee/.env (see deploy/README.md).

# ----------------------------------------------------------------
# Runner shared secret (REQUIRED for Docker Compose)
#
# The runner container mounts no volumes, so this variable is the only way it
# learns the secret. Compose fails to start with a clear message if it is
# unset. Both the server and the runner read it, and the server prefers it
# over any persisted .worker-secret file.
#
# Generate one with:
#   openssl rand -base64 32
#
# A single-process or development server with no separate runner container can
# still leave this unset and fall back to the auto-generated three-word
# .worker-secret file.
# ----------------------------------------------------------------
# RUNNER_SHARED_SECRET=

# ----------------------------------------------------------------
# Runner work directory
#
# Root for job workspaces and per-job scratch copies. Defaults to the system
# temp directory, which is correct almost everywhere.
#
# Set it when the runner temp directory is mounted noexec, as a hardened
# container commonly does. C++ grading compiles a binary into the work
# directory and then executes it, so a noexec root fails every C++ test with
# "Permission denied" at the exec line while every interpreted language keeps
# working. A runner that cannot compile-and-run there stops advertising cpp,
# so the symptom is C++ jobs waiting in the queue rather than failing.
#
# Point this at a writable, exec-capable path.
# ----------------------------------------------------------------
# RUNNER_WORK_DIR=/var/lib/chickadee/work

# ----------------------------------------------------------------
# Auth mode
# Default is SSO. For local username/password auth, set both:
#   AUTH_MODE=local
#   ENABLE_NON_SSO_AUTH_MODES=true
# ----------------------------------------------------------------
# AUTH_MODE=local
# ENABLE_NON_SSO_AUTH_MODES=true

# ----------------------------------------------------------------
# Outbound forward proxy
# ----------------------------------------------------------------
# Set on networks where direct egress is blocked and all traffic must go
# through a proxy (e.g. the UWaterloo NAT'd VLAN). Routes the server's
# outbound HTTP client — OIDC discovery/JWKS/token and BrightSpace grade
# sync — through the proxy. Without it, those calls connectTimeout and
# crash-loop the server at boot when AUTH_MODE is sso/dual.
# OUTBOUND_HTTP_PROXY=http://172.16.136.36:3128

# ----------------------------------------------------------------
# OIDC / SSO credentials (required when AUTH_MODE=sso or dual)
# ----------------------------------------------------------------
OIDC_AUTH_SERVER=https://sso.example.com/oidc/YOUR_ID/
OIDC_CLIENT_ID=YOUR_CLIENT_ID
OIDC_CLIENT_SECRET=YOUR_CLIENT_SECRET
OIDC_CALLBACK=/oidc/callback/

# JWT claim name used as the Chickadee username (default: preferred_username).
# UWaterloo DUO: OIDC_USERNAME_CLAIM=winaccountname
# Most standard OIDC providers: leave unset or set to preferred_username
# OIDC_USERNAME_CLAIM=preferred_username

# JWT claim name used as the user's email address (default: email).
# OIDC_EMAIL_CLAIM=email

# Comma-separated list of SSO usernames that receive the admin role on first login.
# Values are matched against the username derived from OIDC_USERNAME_CLAIM.
# (Instructor authority is per-course — assigned from the course roster, not here.)
SSO_ADMIN_USERS=

# ----------------------------------------------------------------
# Public URL and HTTPS (required in production)
# ----------------------------------------------------------------
# PUBLIC_BASE_URL=https://chickadee.example.com
# ENFORCE_HTTPS=true
# SESSION_COOKIE_SECURE=true

# ----------------------------------------------------------------
# Logging
# ----------------------------------------------------------------
# LOG_LEVEL=info

# ----------------------------------------------------------------
# UWaterloo important-dates integration (on by default)
# ----------------------------------------------------------------
# Instructor due-date pickers warn when a due date lands on a UWaterloo
# holiday, closure, or exam period, fed by the public UW important-dates
# iCal feed (fetched server-side, cached 24 h). This is deliberately
# UW-specific (issue #278). Deployments outside UWaterloo should set this
# to false: the /api/v1/uw-dates endpoint is then not registered and the
# due-date warnings simply never appear. Nothing else changes.
# UW_IMPORTANT_DATES_ENABLED=false

# ----------------------------------------------------------------
# MCP content-authoring server (off by default)
# ----------------------------------------------------------------
# The /mcp endpoint lets an authorized AI agent author course content on an
# instructor's behalf. It never calls an external model API (it is the server
# an agent connects TO) and never exposes student data. Leave MCP_MODE unset
# (or "off") to disable it entirely.
# MCP_MODE=read_only        # inspection only; content:write never honored
# MCP_MODE=read_write       # full content authoring
#
# DNS-rebinding guards: set BOTH in production to this deployment's public host
# and origin. In production the server REFUSES to mount /mcp when either is
# unset (open guards defeat the protection); set MCP_ALLOW_OPEN_GUARDS=true to
# override only when a trusted reverse proxy already pins Host/Origin.
# MCP_ALLOWED_HOSTS=chickadee.example.com
# MCP_ALLOWED_ORIGINS=https://chickadee.example.com
# MCP_ALLOW_OPEN_GUARDS=false
#
# ES256 signing key for MCP access tokens. Auto-generated (mode 0600) on first
# start if absent; git-ignored. See deploy/README.md for rotation.
# MCP_SIGNING_KEY_PATH=.mcp-signing-key
#
# Dedicated least-privilege DB role for the MCP path (postgres only;
# defence-in-depth for the student-data wall). When both are set, MCP queries
# run on a separate pool as this restricted role. Create it with
# deploy/sql/mcp-least-privilege-role.sql. Leave unset to share the main pool.
# MCP_DATABASE_USER=chickadee_mcp
# MCP_DATABASE_PASSWORD=change-me
